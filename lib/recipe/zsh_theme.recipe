#!/usr/bin/env bash

# @see docs/host.md
# @see AGENTS.md

if [[ ! -v RSD_ON || $RSD_ON -ne 1 ]]; then
    echo "This is a RSD library file. It should not be executed directly."
    echo "Please call 'rsd' to use it."
    exit 12
fi

function rsd::recipe::zsh_theme::register() {
    rsd::recipe::register_task \
        --name "zsh_theme::clone_p10k" \
        --pre-check "rsd::recipe::zsh_theme::theme_pre" \
        --apply "rsd::recipe::zsh_theme::theme_apply" \
        --recovery "forward"

    rsd::recipe::register_task \
        --name "zsh_theme::configure_p10k" \
        --pre-check "rsd::recipe::zsh_theme::config_pre" \
        --apply "rsd::recipe::zsh_theme::config_apply" \
        --recovery "rollback" \
        --rollback "rsd::recipe::zsh_theme::config_rollback"

    rsd::recipe::register_task \
        --name "zsh_theme::adjust_p10k_context" \
        --pre-check "rsd::recipe::zsh_theme::p10k_pre" \
        --apply "rsd::recipe::zsh_theme::p10k_apply" \
        --recovery "ignore"
}

# 1. P10k theme clone pre-check
function rsd::recipe::zsh_theme::theme_pre() {
    if [[ -n "$RSD_REMOTE_TARGET" ]]; then
        rsd::l::remote::execute "$RSD_REMOTE_TARGET" "test" "-d" "\${ZSH_CUSTOM:-\$HOME/.oh-my-zsh/custom}/themes/powerlevel10k"
    else
        [[ -d "${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}/themes/powerlevel10k" ]]
    fi
}

# 2. P10k theme clone execution
function rsd::recipe::zsh_theme::theme_apply() {
    if [[ -n "$RSD_REMOTE_TARGET" ]]; then
        rsd::l::remote::execute "$RSD_REMOTE_TARGET" "git" "clone" "--depth=1" "https://github.com/romkatv/powerlevel10k.git" "\${ZSH_CUSTOM:-\$HOME/.oh-my-zsh/custom}/themes/powerlevel10k"
    else
        git clone --depth=1 https://github.com/romkatv/powerlevel10k.git "${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}/themes/powerlevel10k"
    fi
}

# 3. Zsh theme config pre-check
function rsd::recipe::zsh_theme::config_pre() {
    if [[ -n "$RSD_REMOTE_TARGET" ]]; then
        rsd::l::remote::execute "$RSD_REMOTE_TARGET" "grep" "-q" '^ZSH_THEME="powerlevel10k/powerlevel10k"' "\$HOME/.zshrc"
    else
        grep -q '^ZSH_THEME="powerlevel10k/powerlevel10k"' ~/.zshrc
    fi
}

# 4. Zsh theme config execution
function rsd::recipe::zsh_theme::config_apply() {
    if [[ -n "$RSD_REMOTE_TARGET" ]]; then
        # Backup .zshrc
        rsd::l::remote::execute "$RSD_REMOTE_TARGET" "cp" "\$HOME/.zshrc" "\$HOME/.zshrc.theme.bak"
        # Edit using perl
        rsd::l::remote::execute "$RSD_REMOTE_TARGET" "perl" "-pi" "-e" "'s@^ZSH_THEME=.*\$@ZSH_THEME=\"powerlevel10k/powerlevel10k\"@'" "\$HOME/.zshrc"
    else
        cp ~/.zshrc ~/.zshrc.theme.bak
        perl -pi -e 's@^ZSH_THEME=.*$@ZSH_THEME="powerlevel10k/powerlevel10k"@' ~/.zshrc
    fi
}

# 5. Zsh theme config rollback
function rsd::recipe::zsh_theme::config_rollback() {
    if [[ -n "$RSD_REMOTE_TARGET" ]]; then
        rsd::l::remote::execute "$RSD_REMOTE_TARGET" "mv" "\$HOME/.zshrc.theme.bak" "\$HOME/.zshrc"
    else
        mv ~/.zshrc.theme.bak ~/.zshrc
    fi
}

# 6. P10k context adjustment pre-check
function rsd::recipe::zsh_theme::p10k_pre() {
    if [[ -n "$RSD_REMOTE_TARGET" ]]; then
        # Must have p10k config file, and context must not be commented out yet
        rsd::l::remote::execute "$RSD_REMOTE_TARGET" "test" "-f" "\$HOME/.p10k.zsh" && \
        rsd::l::remote::execute "$RSD_REMOTE_TARGET" "grep" "-q" '^# typeset -g POWERLEVEL9K_CONTEXT_' "\$HOME/.p10k.zsh"
    else
        [[ -f ~/.p10k.zsh ]] && grep -q '^# typeset -g POWERLEVEL9K_CONTEXT_' ~/.p10k.zsh
    fi
}

# 7. P10k context adjustment execution
function rsd::recipe::zsh_theme::p10k_apply() {
    if [[ -n "$RSD_REMOTE_TARGET" ]]; then
        rsd::l::remote::execute "$RSD_REMOTE_TARGET" "perl" "-pi" "-e" "'s@^\\s+(typeset -g POWERLEVEL9K_CONTEXT_{DEFAULT,SUDO}_{CONTENT,VISUAL_IDENTIFIER}_EXPANSION=)@# \$1@'" "\$HOME/.p10k.zsh"
    else
        perl -pi -e 's@^\s+(typeset -g POWERLEVEL9K_CONTEXT_{DEFAULT,SUDO}_{CONTENT,VISUAL_IDENTIFIER}_EXPANSION=)@# $1@' ~/.p10k.zsh
    fi
}
