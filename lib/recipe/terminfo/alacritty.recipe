#!/usr/bin/env bash

# ==============================================================================
# Terminfo Provisioning — Alacritty
# ==============================================================================
#
# PURPOSE
# -------
# Installs the "alacritty" and "alacritty-direct" terminfo entries on a
# remote SSH target. The "alacritty" entry provides standard terminal
# capabilities. The "alacritty-direct" entry provides direct-color (24-bit
# true-color) support via a separate TERM value. Both entries are installed
# to ensure the remote host handles either TERM setting correctly.
#
# WHAT THIS RECIPE DOES
# ---------------------
# 1. Pre-check: runs `infocmp alacritty` AND `infocmp alacritty-direct`
#    on the remote target. BOTH must exist to skip — if either is missing,
#    the task runs.
# 2. Resolves the target platform (distro, family, version) from hosts.ini.
# 3. Phase 1 — Package install: attempts to install terminfo packages
#    (e.g., `ncurses-term` on Debian, `ncurses` on Arch). These are system
#    packages containing many terminfo entries — they never pull terminal
#    GUI dependencies. On Alpine, cascades `ncurses-terminfo-base` →
#    `ncurses-terminfo` if the first doesn't include alacritty.
# 4. Verifies BOTH entries appeared after package install.
# 5. Phase 2 — tic fallback: for each MISSING entry independently, extracts
#    the terminfo source from the LOCAL machine via `infocmp -x <entry>`
#    and pipes it through SSH to the remote `tic` compiler.
#    No files are downloaded from the internet — unlike the commonly
#    documented `curl alacritty.info | tic` approach, this recipe uses
#    the already-compiled entries from the local terminfo database.
# 6. If the local machine does not have Alacritty installed, the tic
#    fallback is gracefully skipped with a [SKIP] message per entry.
#
# PACKAGE MATRIX
# --------------
#   Debian >= 11           → ncurses-term
#   Ubuntu >= 20.04        → ncurses-term
#   Arch (rolling)         → ncurses
#   Fedora / RHEL / CentOS → ncurses-term
#   openSUSE               → terminfo
#   Alpine                 → ncurses-terminfo-base → ncurses-terminfo (fallback)
#
# TWO ENTRIES, ONE TASK
# ---------------------
# Alacritty is unique among the supported terminals: it registers TWO
# terminfo entries (alacritty and alacritty-direct). The pre_check gates
# on BOTH entries. The tic fallback pushes each missing entry independently,
# so partially-installed states are handled correctly.
#
# IDEMPOTENCY
# -----------
# Safe to run multiple times. The pre_check detects existing entries and
# skips. Package installs are idempotent. The tic fallback only pushes
# entries that are actually missing.
#
# SCOPE
# -----
# Remote-only. Exits with code 2 if no $RSD_REMOTE_TARGET is set.
#
# RECOVERY
# --------
# Uses "ignore" recovery mode — failure does not block other terminals.
#
# Usage: rsd @target recipe run terminfo/alacritty
#
# @see docs/recipes.md
# @see AGENTS.md

if [[ ! -v RSD_ON || $RSD_ON -ne 1 ]]; then
    echo "This is a RSD library file. It should not be executed directly."
    echo "Please call 'rsd' to use it."
    exit 12
fi

# Load dependencies
[[ "$RSD_HOST_LIB" != "1" ]] && source "$(rsd::get_libdir_file lib/host.lib)"

# Shared helpers are defined in ghostty.recipe (guarded against double-definition).
# When run standalone, this recipe defines them itself.
if ! bash::is_function rsd::l::r::terminfo::resolve_platform; then
    source "$(rsd::get_libdir_file lib/recipe/terminfo/ghostty.recipe)"
fi

# ==============================================================================
# Recipe Registration
# ==============================================================================

function rsd::r::terminfo_alacritty::register() {
    if [[ -z "$RSD_REMOTE_TARGET" ]]; then
        rsd::warn "Error: Terminfo provisioning is remote-only. Use: rsd @target recipe run terminfo/alacritty"
        exit 2
    fi

    rsd::r::register_task "terminfo_alacritty::install_entry" "ignore"
}

# --- Task: install_entry ---

# Both alacritty and alacritty-direct must be present to skip
function rsd::r::terminfo_alacritty::install_entry::pre_check() {
    rsd::l::target::exec infocmp alacritty &>/dev/null && \
    rsd::l::target::exec infocmp alacritty-direct &>/dev/null
}

# Installs alacritty and alacritty-direct terminfo via distro package or tic fallback.
function rsd::r::terminfo_alacritty::install_entry() {
    local family="" distro="" version=""
    rsd::l::r::terminfo::resolve_platform family distro version

    local pkg=""
    local try_package=0

    case "$family" in
        debian)
            if [[ "$distro" == "ubuntu" ]]; then
                # ncurses-term carries alacritty since 20.04/focal
                rsd::l::host::version_gte "$version" "20.04" && try_package=1
            else
                # Debian 11/bullseye+
                rsd::l::host::version_gte "$version" "11" && try_package=1
            fi
            pkg="ncurses-term"
            ;;
        arch)
            try_package=1
            pkg="ncurses"
            ;;
        fedora|rhel|centos)
            try_package=1
            pkg="ncurses-term"
            ;;
        suse|opensuse)
            try_package=1
            pkg="terminfo"
            ;;
        alpine)
            # Try ncurses-terminfo-base first (smaller), full ncurses-terminfo as fallback
            try_package=1
            pkg="ncurses-terminfo-base"
            ;;
    esac

    # Phase 1: Package install attempt
    if ((try_package)) && [[ -n "$pkg" ]]; then
        if ! rsd::l::r::install_pkg "$pkg"; then
            rsd::warn "  [INFO] Package '$pkg' not available or install failed."

            # Alpine fallback: try the full ncurses-terminfo package
            if [[ "$family" == "alpine" ]]; then
                rsd::l::r::install_pkg "ncurses-terminfo" || true
            fi
        fi

        # Check both entries after package install
        local pkg_ok=1
        rsd::l::target::exec infocmp alacritty &>/dev/null || pkg_ok=0
        rsd::l::target::exec infocmp alacritty-direct &>/dev/null || pkg_ok=0

        if ((pkg_ok)); then
            rsd::warn "  [OK] alacritty + alacritty-direct installed via package."
            return 0
        fi
        rsd::warn "  [INFO] Package installed but entries incomplete. Trying tic fallback..."
    fi

    # Phase 2: tic fallback for each missing entry independently
    local rc=0

    if ! rsd::l::target::exec infocmp alacritty &>/dev/null; then
        rsd::l::r::terminfo::push_entry "-x" "alacritty" || rc=$?
    fi

    if ! rsd::l::target::exec infocmp alacritty-direct &>/dev/null; then
        rsd::l::r::terminfo::push_entry "-x" "alacritty-direct" || rc=$?
    fi

    return $rc
}
