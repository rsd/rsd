#!/usr/bin/env bash

# ==============================================================================
# Terminfo Provisioning — Kitty
# ==============================================================================
#
# PURPOSE
# -------
# Installs the "xterm-kitty" terminfo entry on a remote SSH target so that
# Kitty terminal features (true-color, styled underlines, image protocol,
# keyboard protocol, etc.) work correctly over SSH. Without this entry,
# the remote host cannot interpret Kitty's TERM value and falls back to
# degraded rendering.
#
# WHAT THIS RECIPE DOES
# ---------------------
# 1. Pre-check: runs `infocmp xterm-kitty` on the remote target. If the
#    entry already exists, the task is skipped (idempotent).
# 2. Resolves the target platform (distro, family, version) from hosts.ini.
# 3. Phase 1 — Package install: attempts to install the `kitty-terminfo`
#    package, which exists on most modern distros as a lightweight package
#    containing only the terminfo entry (no GUI dependencies). On Alpine,
#    cascades to `ncurses-terminfo-base` if kitty-terminfo is unavailable.
# 4. Verifies the entry appeared after package install.
# 5. Phase 2 — tic fallback: if the package didn't provide the entry,
#    extracts the terminfo source from the LOCAL machine via
#    `infocmp -a xterm-kitty` (note: Kitty uses `-a` for all aliases,
#    not `-x` like Ghostty/Alacritty) and pipes it to the remote `tic`.
# 6. If the local machine does not have Kitty installed, the tic fallback
#    is gracefully skipped with a [SKIP] message.
#
# PACKAGE MATRIX
# --------------
#   Debian >= 11           → kitty-terminfo
#   Ubuntu >= 20.04        → kitty-terminfo
#   Arch (rolling)         → kitty-terminfo
#   Fedora (any)           → kitty-terminfo
#   RHEL/Alma/Rocky >= 8   → kitty-terminfo (via EPEL)
#   openSUSE               → kitty-terminfo
#   Alpine                 → kitty-terminfo → ncurses-terminfo-base (fallback)
#
# KITTY-SPECIFIC: infocmp -a
# --------------------------
# Kitty's terminfo uses `-a` (all aliases) instead of `-x` (extended) when
# extracting via infocmp. This preserves additional terminal capability
# aliases that Kitty registers. Using `-x` would lose them.
#
# IDEMPOTENCY
# -----------
# Safe to run multiple times. The pre_check detects an existing xterm-kitty
# entry and skips.
#
# SCOPE
# -----
# Remote-only. Exits with code 2 if no $RSD_REMOTE_TARGET is set.
#
# RECOVERY
# --------
# Uses "ignore" recovery mode — failure does not block other terminals.
#
# CLIENT-SIDE ALTERNATIVE
# -----------------------
# Kitty provides its own SSH wrapper that handles terminfo automatically:
#   kitty +kitten ssh user@remote-host
# This recipe is for cases where you want permanent support without
# requiring the Kitty-specific SSH kitten.
#
# Usage: rsd @target recipe run terminfo/kitty
#
# @see docs/recipes.md
# @see AGENTS.md

if [[ ! -v RSD_ON || $RSD_ON -ne 1 ]]; then
    echo "This is a RSD library file. It should not be executed directly."
    echo "Please call 'rsd' to use it."
    exit 12
fi

# Load dependencies
[[ "$RSD_HOST_LIB" != "1" ]] && source "$(rsd::get_libdir_file lib/host.lib)"

# Shared helpers are defined in ghostty.recipe (guarded against double-definition).
# When run standalone, this recipe defines them itself.
if ! bash::is_function rsd::l::r::terminfo::resolve_platform; then
    source "$(rsd::get_libdir_file lib/recipe/terminfo/ghostty.recipe)"
fi

# ==============================================================================
# Recipe Registration
# ==============================================================================

function rsd::r::terminfo_kitty::register() {
    if [[ -z "$RSD_REMOTE_TARGET" ]]; then
        rsd::warn "Error: Terminfo provisioning is remote-only. Use: rsd @target recipe run terminfo/kitty"
        exit 2
    fi

    rsd::r::register_task "terminfo_kitty::install_entry" "ignore"
}

# --- Task: install_entry ---

function rsd::r::terminfo_kitty::install_entry::pre_check() {
    rsd::l::target::exec infocmp xterm-kitty &>/dev/null
}

# Installs xterm-kitty terminfo via distro package or tic fallback.
function rsd::r::terminfo_kitty::install_entry() {
    local family="" distro="" version=""
    rsd::l::r::terminfo::resolve_platform family distro version

    local pkg=""
    local try_package=0

    case "$family" in
        debian)
            if [[ "$distro" == "ubuntu" ]]; then
                # kitty-terminfo available since 20.04/focal
                rsd::l::host::version_gte "$version" "20.04" && try_package=1
            else
                # Debian 11/bullseye+
                rsd::l::host::version_gte "$version" "11" && try_package=1
            fi
            pkg="kitty-terminfo"
            ;;
        arch)
            try_package=1
            pkg="kitty-terminfo"
            ;;
        fedora|rhel|centos)
            if [[ "$distro" == "fedora" ]]; then
                # Available on all supported Fedora releases
                try_package=1
            else
                # EL 8+ with EPEL
                rsd::l::host::version_gte "$version" "8" && try_package=1
            fi
            pkg="kitty-terminfo"
            ;;
        suse|opensuse)
            try_package=1
            pkg="kitty-terminfo"
            ;;
        alpine)
            # Try kitty-terminfo first; ncurses-terminfo-base as fallback package
            try_package=1
            pkg="kitty-terminfo"
            ;;
    esac

    # Phase 1: Package install attempt
    if ((try_package)) && [[ -n "$pkg" ]]; then
        if ! rsd::l::r::install_pkg "$pkg"; then
            rsd::warn "  [INFO] Package '$pkg' not available. Trying ncurses-terminfo-base..."

            # Alpine fallback: ncurses-terminfo-base may carry xterm-kitty
            if [[ "$family" == "alpine" ]]; then
                rsd::l::r::install_pkg "ncurses-terminfo-base" || true
            fi
        fi

        if rsd::l::target::exec infocmp xterm-kitty &>/dev/null; then
            rsd::warn "  [OK] xterm-kitty installed via package."
            return 0
        fi
        rsd::warn "  [INFO] Package installed but xterm-kitty not found. Trying tic fallback..."
    fi

    # Phase 2: tic fallback (local infocmp → remote tic)
    # Kitty uses -a (all aliases) instead of -x (extended)
    rsd::l::r::terminfo::push_entry "-a" "xterm-kitty"
}
