#!/usr/bin/env bash

# @see docs/recipes.md
# @see AGENTS.md

if [[ ! -v RSD_ON || $RSD_ON -ne 1 ]]; then
    echo "This is a RSD library file. It should not be executed directly."
    echo "Please call 'rsd' to use it."
    exit 12
fi

function rsd::r::zsh_theme::register() {
    # Prerequisite: Zsh and Oh My Zsh base must be satisfied first
    rsd::r::include "zsh/core"

    rsd::r::register_task "zsh_theme::clone_p10k"
    rsd::r::register_task "zsh_theme::configure_p10k" "rollback"
    rsd::r::register_task "zsh_theme::deploy_p10k_config"
    rsd::r::register_task "zsh_theme::patch_zshrc_for_p10k" "rollback"
    rsd::r::register_task "zsh_theme::adjust_p10k_context" "ignore"
}

# --- Task: clone_p10k ---

function rsd::r::zsh_theme::clone_p10k::pre_check() {
    rsd::l::target::dir_exists "\${ZSH_CUSTOM:-\$HOME/.oh-my-zsh/custom}/themes/powerlevel10k"
}

function rsd::r::zsh_theme::clone_p10k() {
    rsd::l::target::git_clone \
        "https://github.com/romkatv/powerlevel10k.git" \
        "\${ZSH_CUSTOM:-\$HOME/.oh-my-zsh/custom}/themes/powerlevel10k" 1
}

# --- Task: configure_p10k ---

function rsd::r::zsh_theme::configure_p10k::pre_check() {
    rsd::l::target::file_contains \
        '^ZSH_THEME="powerlevel10k/powerlevel10k"' "\$HOME/.zshrc"
}

function rsd::r::zsh_theme::configure_p10k() {
    rsd::l::target::exec cp "\$HOME/.zshrc" "\$HOME/.zshrc.theme.bak"
    rsd::l::target::exec perl -pi -e \
        "'s@^ZSH_THEME=.*\$@ZSH_THEME=\"powerlevel10k/powerlevel10k\"@'" "\$HOME/.zshrc"
}

function rsd::r::zsh_theme::configure_p10k::rollback() {
    rsd::l::target::exec mv "\$HOME/.zshrc.theme.bak" "\$HOME/.zshrc"
}

# --- Task: deploy_p10k_config ---
# Ships the pre-baked p10k.zsh configuration to the target.
# The pristine config is adjusted post-deploy by adjust_p10k_context.

function rsd::r::zsh_theme::deploy_p10k_config::pre_check() {
    rsd::l::target::file_exists "\$HOME/.p10k.zsh"
}

function rsd::r::zsh_theme::deploy_p10k_config() {
    local src
    src="$(rsd::get_libdir_file "data/recipes/zsh/p10k.zsh")"
    rsd::l::target::file_push "$src" "\$HOME/.p10k.zsh"
}

# --- Task: patch_zshrc_for_p10k ---
# Scan-based idempotent patching: checks each block independently and only
# adds what is missing. Safe against user edits to .zshrc.

function rsd::r::zsh_theme::patch_zshrc_for_p10k::pre_check() {
    rsd::l::target::file_contains 'p10k-instant-prompt' "\$HOME/.zshrc" && \
    rsd::l::target::file_contains 'source.*\.p10k\.zsh' "\$HOME/.zshrc"
}

function rsd::r::zsh_theme::patch_zshrc_for_p10k() {
    # Backup before patching
    rsd::l::target::exec cp "\$HOME/.zshrc" "\$HOME/.zshrc.p10k.bak"

    # 1. Prepend instant-prompt block if missing
    if ! rsd::l::target::file_contains 'p10k-instant-prompt' "\$HOME/.zshrc"; then
        rsd::l::target::exec sh -c "'
            _tmp=\$(mktemp) && {
                cat <<\"_RSD_P10K_INSTANT_\" > \"\$_tmp\"
# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r \"\${XDG_CACHE_HOME:-\$HOME/.cache}/p10k-instant-prompt-\${(%):-%n}.zsh\" ]]; then
  source \"\${XDG_CACHE_HOME:-\$HOME/.cache}/p10k-instant-prompt-\${(%):-%n}.zsh\"
fi

_RSD_P10K_INSTANT_
                cat \"\$HOME/.zshrc\" >> \"\$_tmp\" && mv \"\$_tmp\" \"\$HOME/.zshrc\"
            }
        '"
    fi

    # 2. Append source line if missing
    if ! rsd::l::target::file_contains 'source.*\.p10k\.zsh' "\$HOME/.zshrc"; then
        rsd::l::target::exec sh -c "'
            printf \"\\n# To customize prompt, run \\\`p10k configure\\\` or edit ~/.p10k.zsh.\\n\" >> \"\$HOME/.zshrc\"
            echo \"[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh\" >> \"\$HOME/.zshrc\"
        '"
    fi
}

function rsd::r::zsh_theme::patch_zshrc_for_p10k::rollback() {
    rsd::l::target::exec mv "\$HOME/.zshrc.p10k.bak" "\$HOME/.zshrc"
}

# --- Task: adjust_p10k_context ---
# Comments out CONTEXT_{DEFAULT,SUDO} expansion lines in the deployed config.
# Intent: Show user@hostname even for local (non-SSH) sessions, which the
# pristine config hides by default.

# P10k context adjustment pre-check (compound: file must exist AND contain uncommented lines)
function rsd::r::zsh_theme::adjust_p10k_context::pre_check() {
    rsd::l::target::file_exists "\$HOME/.p10k.zsh" && \
    rsd::l::target::exec grep -Fq -- "'# typeset -g POWERLEVEL9K_CONTEXT_{DEFAULT,SUDO}'" "\$HOME/.p10k.zsh"
}

function rsd::r::zsh_theme::adjust_p10k_context() {
    rsd::l::target::exec perl -pi -e \
        "'s@^\\s+(typeset -g POWERLEVEL9K_CONTEXT_{DEFAULT,SUDO}_{CONTENT,VISUAL_IDENTIFIER}_EXPANSION=)@# \$1@'" \
        "\$HOME/.p10k.zsh"
}

