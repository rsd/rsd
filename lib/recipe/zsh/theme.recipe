#!/usr/bin/env bash

# ==============================================================================
# Zsh Shell — Powerlevel10k Theme
# ==============================================================================
#
# PURPOSE
# -------
# Installs and configures the Powerlevel10k (P10k) prompt theme for Zsh.
# Deploys a pre-baked configuration file and patches .zshrc for instant
# prompt support. After this recipe runs, new Zsh sessions display a
# rich, informative prompt with instant rendering (no startup delay).
#
# WHAT THIS RECIPE DOES
# ---------------------
# 1. Task: clone_p10k
#    Pre-check: P10k directory exists in $ZSH_CUSTOM/themes/powerlevel10k.
#    Apply: git clones romkatv/powerlevel10k with depth 1 into the
#    Oh My Zsh custom themes directory.
#
# 2. Task: configure_p10k (recovery: rollback)
#    Pre-check: .zshrc contains ZSH_THEME="powerlevel10k/powerlevel10k".
#    Apply: backs up .zshrc, then uses perl regex to replace the ZSH_THEME
#    line in-place. Handles any existing theme value.
#    Rollback: restores .zshrc from the backup (.zshrc.theme.bak).
#
# 3. Task: deploy_p10k_config
#    Pre-check: ~/.p10k.zsh file exists on target.
#    Apply: pushes the pre-baked P10k configuration from
#    data/recipes/zsh/p10k.zsh to ~/.p10k.zsh on the target via
#    rsd::l::target::file_push (cat | SSH tee pattern).
#
# 4. Task: patch_zshrc_for_p10k (recovery: rollback)
#    Pre-check: .zshrc contains both 'p10k-instant-prompt' AND
#    'source.*\.p10k\.zsh' (compound check).
#    Apply: uses scan-based idempotent patching — checks each block
#    independently and only adds what is missing:
#      a. Prepends the instant-prompt initialization block near the top
#         of .zshrc (uses mktemp + cat + mv for atomic prepend).
#      b. Appends the `source ~/.p10k.zsh` line at the end if missing.
#    Rollback: restores .zshrc from the backup (.zshrc.p10k.bak).
#
# 5. Task: adjust_p10k_context (recovery: ignore)
#    Pre-check: ~/.p10k.zsh exists AND the CONTEXT expansion lines are
#    already commented out.
#    Apply: comments out the POWERLEVEL9K_CONTEXT_{DEFAULT,SUDO} expansion
#    lines in the P10k config. This forces the prompt to show user@hostname
#    even for local (non-SSH) sessions, which the pristine P10k config
#    hides by default.
#
# INSTANT PROMPT
# --------------
# P10k's instant prompt feature renders the prompt immediately while Zsh
# loads plugins in the background. This requires a specific initialization
# block near the TOP of .zshrc (before any other code that produces output).
# The patching task handles this by prepending the block atomically.
#
# IDEMPOTENCY
# -----------
# Safe to run multiple times. The scan-based patching in task 4 checks
# each block independently, so partially-applied states are handled.
# Task 5 uses "ignore" recovery — if the context adjustment fails (e.g.,
# grep doesn't find the expected lines), the recipe continues.
#
# SCOPE
# -----
# Works on both local and remote targets. Includes zsh/core as a
# prerequisite — Zsh and Oh My Zsh are installed first if missing.
#
# RECOVERY
# --------
# Tasks 1, 3: "forward" — failure requires manual resolution.
# Tasks 2, 4: "rollback" — .zshrc is restored from backup on failure.
# Task 5: "ignore" — context adjustment is cosmetic; failure is non-fatal.
#
# Usage: rsd recipe run zsh/theme
#        rsd @target recipe run zsh/theme
#
# @see docs/recipes.md
# @see AGENTS.md

if [[ ! -v RSD_ON || $RSD_ON -ne 1 ]]; then
    echo "This is a RSD library file. It should not be executed directly."
    echo "Please call 'rsd' to use it."
    exit 12
fi

function rsd::r::zsh_theme::register() {
    # Prerequisite: Zsh and Oh My Zsh base must be satisfied first
    rsd::r::include "zsh/core"

    rsd::r::register_task "zsh_theme::clone_p10k"
    rsd::r::register_task "zsh_theme::configure_p10k" "rollback"
    rsd::r::register_task "zsh_theme::deploy_p10k_config"
    rsd::r::register_task "zsh_theme::patch_zshrc_for_p10k" "rollback"
    rsd::r::register_task "zsh_theme::adjust_p10k_context" "ignore"
}

# --- Task: clone_p10k ---

function rsd::r::zsh_theme::clone_p10k::pre_check() {
    rsd::l::target::dir_exists "\${ZSH_CUSTOM:-\$HOME/.oh-my-zsh/custom}/themes/powerlevel10k"
}

function rsd::r::zsh_theme::clone_p10k() {
    rsd::l::target::git_clone \
        "https://github.com/romkatv/powerlevel10k.git" \
        "\${ZSH_CUSTOM:-\$HOME/.oh-my-zsh/custom}/themes/powerlevel10k" 1
}

# --- Task: configure_p10k ---

function rsd::r::zsh_theme::configure_p10k::pre_check() {
    rsd::l::target::file_contains \
        '^ZSH_THEME="powerlevel10k/powerlevel10k"' "\$HOME/.zshrc"
}

function rsd::r::zsh_theme::configure_p10k() {
    rsd::l::target::exec cp "\$HOME/.zshrc" "\$HOME/.zshrc.theme.bak"

    # Replace ZSH_THEME value with powerlevel10k (in-place via perl regex)
    rsd::l::target::perl_filter \
        "'s@^ZSH_THEME=.*\$@ZSH_THEME=\"powerlevel10k/powerlevel10k\"@'" "\$HOME/.zshrc"
}

function rsd::r::zsh_theme::configure_p10k::rollback() {
    rsd::l::target::exec mv "\$HOME/.zshrc.theme.bak" "\$HOME/.zshrc"
}

# --- Task: deploy_p10k_config ---
# Ships the pre-baked p10k.zsh configuration to the target.
# The pristine config is adjusted post-deploy by adjust_p10k_context.

function rsd::r::zsh_theme::deploy_p10k_config::pre_check() {
    rsd::l::target::file_exists "\$HOME/.p10k.zsh"
}

function rsd::r::zsh_theme::deploy_p10k_config() {
    local src
    src="$(rsd::get_libdir_file "data/recipes/zsh/p10k.zsh")"
    rsd::l::target::file_push "$src" "\$HOME/.p10k.zsh"
}

# --- Task: patch_zshrc_for_p10k ---
# Scan-based idempotent patching: checks each block independently and only
# adds what is missing. Safe against user edits to .zshrc.

function rsd::r::zsh_theme::patch_zshrc_for_p10k::pre_check() {
    rsd::l::target::file_contains 'p10k-instant-prompt' "\$HOME/.zshrc" && \
    rsd::l::target::file_contains 'source.*\.p10k\.zsh' "\$HOME/.zshrc"
}

function rsd::r::zsh_theme::patch_zshrc_for_p10k() {
    # Backup before patching
    rsd::l::target::exec cp "\$HOME/.zshrc" "\$HOME/.zshrc.p10k.bak"

    # 1. Prepend instant-prompt block if missing
    if ! rsd::l::target::file_contains 'p10k-instant-prompt' "\$HOME/.zshrc"; then
        rsd::l::target::exec sh -c "'
            _tmp=\$(mktemp) && {
                cat <<\"_RSD_P10K_INSTANT_\" > \"\$_tmp\"
# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r \"\${XDG_CACHE_HOME:-\$HOME/.cache}/p10k-instant-prompt-\${(%):-%n}.zsh\" ]]; then
  source \"\${XDG_CACHE_HOME:-\$HOME/.cache}/p10k-instant-prompt-\${(%):-%n}.zsh\"
fi

_RSD_P10K_INSTANT_
                cat \"\$HOME/.zshrc\" >> \"\$_tmp\" && mv \"\$_tmp\" \"\$HOME/.zshrc\"
            }
        '"
    fi

    # 2. Append source line if missing
    if ! rsd::l::target::file_contains 'source.*\.p10k\.zsh' "\$HOME/.zshrc"; then
        rsd::l::target::exec sh -c "'
            printf \"\\n# To customize prompt, run \\\`p10k configure\\\` or edit ~/.p10k.zsh.\\n\" >> \"\$HOME/.zshrc\"
            echo \"[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh\" >> \"\$HOME/.zshrc\"
        '"
    fi
}

function rsd::r::zsh_theme::patch_zshrc_for_p10k::rollback() {
    rsd::l::target::exec mv "\$HOME/.zshrc.p10k.bak" "\$HOME/.zshrc"
}

# --- Task: adjust_p10k_context ---
# Comments out CONTEXT_{DEFAULT,SUDO} expansion lines in the deployed config.
# Intent: Show user@hostname even for local (non-SSH) sessions, which the
# pristine config hides by default.

# P10k context adjustment pre-check (compound: file must exist AND contain uncommented lines)
function rsd::r::zsh_theme::adjust_p10k_context::pre_check() {
    rsd::l::target::file_exists "\$HOME/.p10k.zsh" && \
    rsd::l::target::exec grep -Fq -- "'# typeset -g POWERLEVEL9K_CONTEXT_{DEFAULT,SUDO}'" "\$HOME/.p10k.zsh"
}

function rsd::r::zsh_theme::adjust_p10k_context() {
    # Comment out CONTEXT expansion lines so user@host shows on local sessions
    rsd::l::target::perl_filter \
        "'s@^\\s+(typeset -g POWERLEVEL9K_CONTEXT_{DEFAULT,SUDO}_{CONTENT,VISUAL_IDENTIFIER}_EXPANSION=)@# \$1@'" \
        "\$HOME/.p10k.zsh"
}

