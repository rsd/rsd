#!/usr/bin/env bash

# @see docs/recipes.md
# @see AGENTS.md

if [[ ! -v RSD_ON || $RSD_ON -ne 1 ]]; then
    echo "This is a RSD library file. It should not be executed directly."
    echo "Please call 'rsd' to use it."
    exit 12
fi

function rsd::r::zsh_theme::register() {
    # Prerequisite: Zsh and Oh My Zsh base must be satisfied first
    rsd::r::include "zsh/core"

    rsd::r::register_task "zsh_theme::clone_p10k"
    rsd::r::register_task "zsh_theme::configure_p10k" "rollback"
    rsd::r::register_task "zsh_theme::adjust_p10k_context" "ignore"
}

# --- Task: clone_p10k ---

function rsd::r::zsh_theme::clone_p10k::pre_check() {
    rsd::l::target::dir_exists "\${ZSH_CUSTOM:-\$HOME/.oh-my-zsh/custom}/themes/powerlevel10k"
}

function rsd::r::zsh_theme::clone_p10k() {
    rsd::l::target::git_clone \
        "https://github.com/romkatv/powerlevel10k.git" \
        "\${ZSH_CUSTOM:-\$HOME/.oh-my-zsh/custom}/themes/powerlevel10k" 1
}

# --- Task: configure_p10k ---

function rsd::r::zsh_theme::configure_p10k::pre_check() {
    rsd::l::target::file_contains \
        '^ZSH_THEME="powerlevel10k/powerlevel10k"' "\$HOME/.zshrc"
}

function rsd::r::zsh_theme::configure_p10k() {
    rsd::l::target::exec cp "\$HOME/.zshrc" "\$HOME/.zshrc.theme.bak"
    rsd::l::target::exec perl -pi -e \
        "'s@^ZSH_THEME=.*\$@ZSH_THEME=\"powerlevel10k/powerlevel10k\"@'" "\$HOME/.zshrc"
}

function rsd::r::zsh_theme::configure_p10k::rollback() {
    rsd::l::target::exec mv "\$HOME/.zshrc.theme.bak" "\$HOME/.zshrc"
}

# --- Task: adjust_p10k_context ---

# P10k context adjustment pre-check (compound: file must exist AND contain uncommented lines)
function rsd::r::zsh_theme::adjust_p10k_context::pre_check() {
    rsd::l::target::file_exists "\$HOME/.p10k.zsh" && \
    rsd::l::target::file_contains '^# typeset -g POWERLEVEL9K_CONTEXT_' "\$HOME/.p10k.zsh"
}

function rsd::r::zsh_theme::adjust_p10k_context() {
    rsd::l::target::exec perl -pi -e \
        's@^\s+(typeset -g POWERLEVEL9K_CONTEXT_{DEFAULT,SUDO}_{CONTENT,VISUAL_IDENTIFIER}_EXPANSION=)@# $1@' \
        "\$HOME/.p10k.zsh"
}
