#!/usr/bin/env bash

# ==============================================================================
# Zsh Shell — Companion CLI Tools
# ==============================================================================
#
# PURPOSE
# -------
# Installs CLI companion tools that enhance the Zsh shell experience,
# particularly the FZF preview pipeline configured by zsh/plugins.
# After this recipe runs, FZF previews render directory trees (eza),
# images (chafa), syntax-highlighted files (bat), metadata (exiftool),
# and enhanced paging (lesspipe).
#
# WHAT THIS RECIPE DOES
# ---------------------
# 1. Task: install_companion_tools
#    Pre-check: `chsh` and `chafa` binaries exist on target.
#    Apply: installs packages portably based on distro family:
#      Debian: chafa, libimage-exiftool-perl, bat, fd-find + batcat→bat symlink
#      Arch:   chafa, perl-image-exiftool, bat, fd
#      Other:  chafa (generic fallback)
#    Note: On Debian, `bat` is packaged as `batcat`. This task creates a
#    symlink at /usr/local/bin/bat → /usr/bin/batcat for uniform usage.
#    Similarly, `fd` is packaged as `fd-find` on Debian.
#
# 2. Task: install_cargo
#    Pre-check: `cargo` binary exists on target.
#    Apply: installs the `cargo` package (Rust build toolchain) via the
#    distro package manager. Required by the eza compile task.
#
# 3. Task: compile_eza
#    Pre-check: ~/.cargo/bin/eza file exists.
#    Apply: runs `cargo install eza` on the target to compile eza (a modern
#    replacement for `ls` with tree, git integration, and icons) from source.
#    Installs to ~/.cargo/bin/ (user-space, no sudo needed).
#
# 4. Task: install_make
#    Pre-check: `make` binary exists on target.
#    Apply: installs the `make` package via distro package manager.
#    Required by the lesspipe compile task.
#
# 5. Task: compile_lesspipe (recovery: ignore)
#    Pre-check: /usr/local/bin/lesspipe.sh file exists.
#    Apply: clones wofr06/lesspipe into ~/dev/lesspipe, runs ./configure
#    as user, then `make install` via sudo (installs to /usr/local/bin).
#    Cleans up the source directory after install.
#    This is a mixed user/sudo pattern — configure runs as user to avoid
#    root-owned build artifacts, install runs as root for /usr/local.
#
# DISTRO-SPECIFIC PACKAGE NAMES
# -----------------------------
# Some tools have different package names across distributions:
#   bat:      "bat" everywhere except Debian/Ubuntu where it's "bat"
#             but the binary is named "batcat" (→ symlink created)
#   fd:       "fd" on Arch, "fd-find" on Debian/Ubuntu
#   exiftool: "perl-image-exiftool" on Arch, "libimage-exiftool-perl" on Debian
#
# IDEMPOTENCY
# -----------
# Safe to run multiple times. Each task checks for the presence of its
# binary or file artifact and skips if already satisfied. Cargo installs
# are idempotent (rebuilds only if version changed).
#
# SCOPE
# -----
# Works on both local and remote targets. Includes zsh/core as a
# prerequisite — Zsh and Oh My Zsh are installed first if missing.
#
# RECOVERY
# --------
# Tasks 1-4: "forward" — package or compile failure requires manual fix.
# Task 5 (lesspipe): "ignore" — lesspipe is optional; failure does not
# block the recipe.
#
# Usage: rsd recipe run zsh/tools
#        rsd @target recipe run zsh/tools
#
# @see docs/recipes.md
# @see AGENTS.md

if [[ ! -v RSD_ON || $RSD_ON -ne 1 ]]; then
    echo "This is a RSD library file. It should not be executed directly."
    echo "Please call 'rsd' to use it."
    exit 12
fi

# Load dependencies
[[ "$RSD_HOST_LIB" != "1" ]] && source "$(rsd::get_libdir_file lib/host.lib)"

function rsd::r::zsh_tools::register() {
    # Prerequisite: Zsh and Oh My Zsh base must be satisfied first
    rsd::r::include "zsh/core"

    rsd::r::register_task "zsh_tools::install_companion_tools"
    rsd::r::register_task "zsh_tools::install_cargo"
    rsd::r::register_task "zsh_tools::compile_eza"
    rsd::r::register_task "zsh_tools::install_make"
    rsd::r::register_task "zsh_tools::compile_lesspipe" "ignore"
}

# --- Task: install_companion_tools ---

# Companion tools pre-check (Validates key binaries exist)
function rsd::r::zsh_tools::install_companion_tools::pre_check() {
    rsd::l::target::has_bin chsh && rsd::l::target::has_bin chafa
}

# Companion tools installation portably across Arch / Debian
function rsd::r::zsh_tools::install_companion_tools() {
    source "$(rsd::get_libdir_file command/install)"

    local host_alias="localhost"
    if [[ -n "$RSD_REMOTE_TARGET" ]]; then
        host_alias="${RSD_REMOTE_TARGET#@}"
    fi

    local family=""
    rsd::l::host::get_property "$host_alias" "family" family

    # Install packages portably based on family
    if [[ "$family" == "debian" ]]; then
        rsd::c::install::command "chafa"
        rsd::c::install::command "libimage-exiftool-perl"
        rsd::c::install::command "bat"
        rsd::c::install::command "fd-find"

        # Apply batcat symlink
        rsd::l::target::exec_sudo "" "ln" "-sf" "/usr/bin/batcat" "/usr/local/bin/bat"
    elif [[ "$family" == "arch" ]]; then
        rsd::c::install::command "chafa"
        rsd::c::install::command "perl-image-exiftool"
        rsd::c::install::command "bat"
        rsd::c::install::command "fd"
    else
        # Generic fallback
        rsd::c::install::command "chafa"
    fi
}

# --- Task: install_cargo ---

function rsd::r::zsh_tools::install_cargo::pre_check() {
    rsd::l::target::has_bin cargo
}

function rsd::r::zsh_tools::install_cargo() {
    rsd::l::r::install_pkg cargo
}

# --- Task: compile_eza ---

function rsd::r::zsh_tools::compile_eza::pre_check() {
    rsd::l::target::file_exists "\$HOME/.cargo/bin/eza"
}

function rsd::r::zsh_tools::compile_eza() {
    rsd::l::target::exec cargo install eza
}

# --- Task: install_make ---

function rsd::r::zsh_tools::install_make::pre_check() {
    rsd::l::target::has_bin make
}

function rsd::r::zsh_tools::install_make() {
    rsd::l::r::install_pkg make
}

# --- Task: compile_lesspipe ---

function rsd::r::zsh_tools::compile_lesspipe::pre_check() {
    rsd::l::target::file_exists /usr/local/bin/lesspipe.sh
}

# Lesspipe source compile and install (Mixed User/Sudo wrapping)
function rsd::r::zsh_tools::compile_lesspipe() {
    rsd::l::target::exec mkdir -p "\$HOME/dev"
    rsd::l::target::exec rm -rf "\$HOME/dev/lesspipe"
    rsd::l::target::git_clone "https://github.com/wofr06/lesspipe" "\$HOME/dev/lesspipe"
    rsd::l::target::exec sh -c "'cd \$HOME/dev/lesspipe && ./configure'"
    rsd::l::target::exec_sudo "" sh -c "'cd \$HOME/dev/lesspipe && make install'"
    rsd::l::target::exec rm -rf "\$HOME/dev/lesspipe"
}
