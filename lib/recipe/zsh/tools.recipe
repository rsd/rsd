#!/usr/bin/env bash

# @see docs/recipes.md
# @see AGENTS.md

if [[ ! -v RSD_ON || $RSD_ON -ne 1 ]]; then
    echo "This is a RSD library file. It should not be executed directly."
    echo "Please call 'rsd' to use it."
    exit 12
fi

# Load dependencies
[[ "$RSD_HOST_LIB" != "1" ]] && source "$(rsd::get_libdir_file lib/host.lib)"

function rsd::r::zsh_tools::register() {
    # Prerequisite: Zsh and Oh My Zsh base must be satisfied first
    rsd::r::include "zsh/core"

    rsd::r::register_task "zsh_tools::install_companion_tools"
    rsd::r::register_task "zsh_tools::install_cargo"
    rsd::r::register_task "zsh_tools::compile_eza"
    rsd::r::register_task "zsh_tools::install_make"
    rsd::r::register_task "zsh_tools::compile_lesspipe" "ignore"
}

# --- Task: install_companion_tools ---

# Companion tools pre-check (Validates key binaries exist)
function rsd::r::zsh_tools::install_companion_tools::pre_check() {
    rsd::l::target::has_bin chsh && rsd::l::target::has_bin chafa
}

# Companion tools installation portably across Arch / Debian
function rsd::r::zsh_tools::install_companion_tools() {
    source "$(rsd::get_libdir_file command/install)"

    local host_alias="localhost"
    if [[ -n "$RSD_REMOTE_TARGET" ]]; then
        host_alias="${RSD_REMOTE_TARGET#@}"
    fi

    local family=""
    rsd::l::host::get_property "$host_alias" "family" family

    # Install packages portably based on family
    if [[ "$family" == "debian" ]]; then
        rsd::c::install::command "chafa"
        rsd::c::install::command "libimage-exiftool-perl"
        rsd::c::install::command "bat"
        rsd::c::install::command "fd-find"

        # Apply batcat symlink
        rsd::l::target::exec_sudo "" "ln" "-sf" "/usr/bin/batcat" "/usr/local/bin/bat"
    elif [[ "$family" == "arch" ]]; then
        rsd::c::install::command "chafa"
        rsd::c::install::command "perl-image-exiftool"
        rsd::c::install::command "bat"
        rsd::c::install::command "fd"
    else
        # Generic fallback
        rsd::c::install::command "chafa"
    fi
}

# --- Task: install_cargo ---

function rsd::r::zsh_tools::install_cargo::pre_check() {
    rsd::l::target::has_bin cargo
}

function rsd::r::zsh_tools::install_cargo() {
    rsd::l::r::install_pkg cargo
}

# --- Task: compile_eza ---

function rsd::r::zsh_tools::compile_eza::pre_check() {
    rsd::l::target::file_exists "\$HOME/.cargo/bin/eza"
}

function rsd::r::zsh_tools::compile_eza() {
    rsd::l::target::exec cargo install eza
}

# --- Task: install_make ---

function rsd::r::zsh_tools::install_make::pre_check() {
    rsd::l::target::has_bin make
}

function rsd::r::zsh_tools::install_make() {
    rsd::l::r::install_pkg make
}

# --- Task: compile_lesspipe ---

function rsd::r::zsh_tools::compile_lesspipe::pre_check() {
    rsd::l::target::file_exists /usr/local/bin/lesspipe.sh
}

# Lesspipe source compile and install (Mixed User/Sudo wrapping)
function rsd::r::zsh_tools::compile_lesspipe() {
    rsd::l::target::exec mkdir -p "\$HOME/dev"
    rsd::l::target::exec rm -rf "\$HOME/dev/lesspipe"
    rsd::l::target::git_clone "https://github.com/wofr06/lesspipe" "\$HOME/dev/lesspipe"
    rsd::l::target::exec sh -c "'cd \$HOME/dev/lesspipe && ./configure'"
    rsd::l::target::exec_sudo "" sh -c "'cd \$HOME/dev/lesspipe && make install'"
    rsd::l::target::exec rm -rf "\$HOME/dev/lesspipe"
}
