#!/usr/bin/env bash

# ==============================================================================
# Zsh Shell — Core Setup
# ==============================================================================
#
# PURPOSE
# -------
# Bootstraps a complete Zsh environment on the target host: installs Zsh,
# sets it as the user's default login shell, and installs Oh My Zsh as the
# plugin/theme framework. This recipe is the foundational prerequisite for
# all other zsh/* recipes (theme, plugins, tools).
#
# WHAT THIS RECIPE DOES
# ---------------------
# 1. Task: install_zsh
#    Pre-check: `which zsh` on target.
#    Apply: installs the `zsh` package via the distro package manager
#    (rsd::l::r::install_pkg). Works on Debian/Ubuntu, Arch, Fedora,
#    openSUSE, and Alpine.
#
# 2. Task: set_default_shell (recovery: rollback)
#    Pre-check: checks if $SHELL already ends in "/zsh".
#    Apply: resolves the Zsh binary path on the target (`which zsh`),
#    then runs `chsh -s <path> $USER` via sudo. For remote targets, the
#    Zsh path is resolved remotely to avoid local/remote path mismatches.
#    Rollback: reverts to /bin/bash via `chsh -s /bin/bash $USER`.
#
# 3. Task: install_oh_my_zsh
#    Pre-check: checks if ~/.oh-my-zsh directory exists on target.
#    Apply: downloads and runs the Oh My Zsh installer in unattended mode.
#    Uses rsd::l::target::fetch_and_exec for secure download:
#      - Unpredictable temp file via mktemp (prevents CWE-377 symlink attacks)
#      - Atomic download-then-execute (prevents CWE-367 TOCTOU races)
#      - No curl-pipe-to-shell (prevents CWE-494 blind execution)
#
# IDEMPOTENCY
# -----------
# Safe to run multiple times. Each task has a pre_check that detects if
# the desired state is already met (Zsh binary exists, default shell is
# Zsh, Oh My Zsh directory exists) and skips accordingly.
#
# SCOPE
# -----
# Works on both local and remote targets. All operations route through
# rsd::l::target::* for transparent local/remote execution.
#
# RECOVERY
# --------
# Task 1 (install_zsh): "forward" — package install failure requires
# manual resolution.
# Task 2 (set_default_shell): "rollback" — if chsh fails or subsequent
# tasks fail, the shell is reverted to /bin/bash.
# Task 3 (install_oh_my_zsh): "forward" — download failure requires
# network troubleshooting.
#
# DEPENDENCY ROLE
# ---------------
# This recipe is included as a prerequisite by all other zsh/* recipes
# (theme, plugins, tools) via `rsd::r::include "zsh/core"`. When run
# as part of a compositor (zsh/dev_setup), its tasks are deduplicated
# by the engine — they only run once even if multiple recipes include it.
#
# Usage: rsd recipe run zsh/core
#        rsd @target recipe run zsh/core
#
# @see docs/recipes.md
# @see AGENTS.md

if [[ ! -v RSD_ON || $RSD_ON -ne 1 ]]; then
    echo "This is a RSD library file. It should not be executed directly."
    echo "Please call 'rsd' to use it."
    exit 12
fi

function rsd::r::zsh_core::register() {
    rsd::r::register_task "zsh_core::install_zsh"
    rsd::r::register_task "zsh_core::set_default_shell" "rollback"
    rsd::r::register_task "zsh_core::install_oh_my_zsh"
}

# --- Task: install_zsh ---

function rsd::r::zsh_core::install_zsh::pre_check() {
    rsd::l::target::has_bin zsh
}

function rsd::r::zsh_core::install_zsh() {
    rsd::l::r::install_pkg zsh
}

# --- Task: set_default_shell ---

# Default shell pre-check requires reading $SHELL, which has no single-line helper equivalent
function rsd::r::zsh_core::set_default_shell::pre_check() {
    local current_shell=""
    if [[ -n "$RSD_REMOTE_TARGET" ]]; then
        current_shell=$(rsd::l::remote::execute "$RSD_REMOTE_TARGET" "echo \$SHELL")
    else
        current_shell="$SHELL"
    fi
    [[ "$current_shell" == *"/zsh" ]]
}

# Default shell change requires dynamic path resolution before sudo elevation
function rsd::r::zsh_core::set_default_shell() {
    local zsh_path=""
    if [[ -n "$RSD_REMOTE_TARGET" ]]; then
        zsh_path=$(rsd::l::remote::execute "$RSD_REMOTE_TARGET" "which" "zsh" 2>/dev/null)
        # Trim leading/trailing whitespace from remote output (pure Bash, no subshell)
        bash::trim zsh_path

        if [[ -z "$zsh_path" ]]; then
            rsd::io::error "Zsh binary was not found on remote target."
            return 3
        fi
    else
        zsh_path=$(which zsh 2>/dev/null)
    fi

    rsd::l::target::exec_sudo "" "chsh" "-s" "$zsh_path" "$USER"
}

function rsd::r::zsh_core::set_default_shell::rollback() {
    rsd::l::target::exec_sudo '' chsh -s /bin/bash $USER
}

# --- Task: install_oh_my_zsh ---

function rsd::r::zsh_core::install_oh_my_zsh::pre_check() {
    rsd::l::target::dir_exists "\$HOME/.oh-my-zsh"
}

# Oh My Zsh unattended installation via secure download pipeline.
# Uses fetch_and_exec to prevent:
#   - Symlink attacks on predictable /tmp paths (CWE-377)
#   - TOCTOU races between download and execution (CWE-367)
#   - Blind curl-pipe-to-shell execution (CWE-494)
function rsd::r::zsh_core::install_oh_my_zsh() {
    rsd::l::target::fetch_and_exec \
        "https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh" \
        "sh" "--unattended"
}
