#!/usr/bin/env bash

# ==============================================================================
# Zsh Shell — Plugins & Configuration
# ==============================================================================
#
# PURPOSE
# -------
# Installs Oh My Zsh plugins for fuzzy-finding and autosuggestions, then
# injects a complete .zshrc configuration block with the plugin list,
# keybindings, and FZF customization. Transforms a vanilla Oh My Zsh
# installation into a productivity-focused shell.
#
# WHAT THIS RECIPE DOES
# ---------------------
# 1. Task: clone_autosuggestions
#    Pre-check: $ZSH_CUSTOM/plugins/zsh-autosuggestions directory exists.
#    Apply: git clones zsh-users/zsh-autosuggestions into the Oh My Zsh
#    custom plugins directory.
#
# 2. Task: clone_fzf
#    Pre-check: ~/.fzf directory exists.
#    Apply: git clones junegunn/fzf into ~/.fzf with depth 1, then runs
#    the installer with --all (installs binary + keybindings + completions).
#
# 3. Task: clone_fzf_zsh_plugin
#    Pre-check: $ZSH_CUSTOM/plugins/fzf-zsh-plugin directory exists.
#    Apply: git clones unixorn/fzf-zsh-plugin into Oh My Zsh custom plugins.
#
# 4. Task: inject_zshrc_settings (recovery: rollback)
#    Pre-check: .zshrc contains the sentinel marker "# --- BEGIN RSD
#    CUSTOM CONFIG ---".
#    Apply: appends a delimited configuration block to .zshrc containing:
#      - Plugin list: composer, docker, docker-compose, git, laravel,
#        rust, yarn, zsh-autosuggestions, fzf-zsh-plugin
#      - SHIFT+UP/DOWN keybindings for history navigation
#      - FZF customization: 40% height, reverse layout, border, smart
#        preview (eza for dirs, chafa for images, bat for text, exiftool
#        for binary files), Ctrl+/ toggle-preview binding
#      - FZF command: fd-find excluding .git and node_modules
#      - Ctrl+R history with no preview
#      - PATH addition for Cargo binaries
#    Rollback: removes the entire block between the BEGIN/END sentinel
#    markers using rsd::l::target::sed_delete_block.
#
# SENTINEL-DELIMITED CONFIG BLOCK
# --------------------------------
# The .zshrc injection uses "# --- BEGIN RSD CUSTOM CONFIG ---" and
# "# --- END RSD CUSTOM CONFIG ---" as delimiters. This enables:
#   - Idempotent detection (pre_check searches for the BEGIN marker)
#   - Clean rollback (sed deletes everything between markers)
#   - User edits outside the block are preserved
#
# IDEMPOTENCY
# -----------
# Safe to run multiple times. Each task checks if its artifact already
# exists (directory for clones, sentinel marker for config block).
#
# SCOPE
# -----
# Works on both local and remote targets. Includes zsh/core as a
# prerequisite — Zsh and Oh My Zsh are installed first if missing.
#
# RECOVERY
# --------
# Tasks 1-3 (clones): "forward" — git clone failure requires network fix.
# Task 4 (inject): "rollback" — if injection fails or subsequent tasks
# fail, the config block is removed from .zshrc.
#
# Usage: rsd recipe run zsh/plugins
#        rsd @target recipe run zsh/plugins
#
# @see docs/recipes.md
# @see AGENTS.md

if [[ ! -v RSD_ON || $RSD_ON -ne 1 ]]; then
    echo "This is a RSD library file. It should not be executed directly."
    echo "Please call 'rsd' to use it."
    exit 12
fi

function rsd::r::zsh_plugins::register() {
    # Prerequisite: Zsh and Oh My Zsh base must be satisfied first
    rsd::r::include "zsh/core"

    rsd::r::register_task "zsh_plugins::clone_autosuggestions"
    rsd::r::register_task "zsh_plugins::clone_fzf"
    rsd::r::register_task "zsh_plugins::clone_fzf_zsh_plugin"
    rsd::r::register_task "zsh_plugins::inject_zshrc_settings" "rollback"
}

# --- Task: clone_autosuggestions ---

function rsd::r::zsh_plugins::clone_autosuggestions::pre_check() {
    rsd::l::target::dir_exists "\${ZSH_CUSTOM:-\$HOME/.oh-my-zsh/custom}/plugins/zsh-autosuggestions"
}

function rsd::r::zsh_plugins::clone_autosuggestions() {
    rsd::l::target::git_clone \
        "https://github.com/zsh-users/zsh-autosuggestions" \
        "\${ZSH_CUSTOM:-\$HOME/.oh-my-zsh/custom}/plugins/zsh-autosuggestions"
}

# --- Task: clone_fzf ---

function rsd::r::zsh_plugins::clone_fzf::pre_check() {
    rsd::l::target::dir_exists "\$HOME/.fzf"
}

# FZF binary and keybinding installation (Unattended, requires two-step clone + install)
function rsd::r::zsh_plugins::clone_fzf() {
    rsd::l::target::git_clone "https://github.com/junegunn/fzf.git" "\$HOME/.fzf" "1"
    rsd::l::target::exec "\$HOME/.fzf/install" "--all"
}

# --- Task: clone_fzf_zsh_plugin ---

function rsd::r::zsh_plugins::clone_fzf_zsh_plugin::pre_check() {
    rsd::l::target::dir_exists "\${ZSH_CUSTOM:-\$HOME/.oh-my-zsh/custom}/plugins/fzf-zsh-plugin"
}

function rsd::r::zsh_plugins::clone_fzf_zsh_plugin() {
    rsd::l::target::git_clone \
        "https://github.com/unixorn/fzf-zsh-plugin.git" \
        "\${ZSH_CUSTOM:-\$HOME/.oh-my-zsh/custom}/plugins/fzf-zsh-plugin" 1
}

# --- Task: inject_zshrc_settings ---

function rsd::r::zsh_plugins::inject_zshrc_settings::pre_check() {
    rsd::l::target::file_contains '# --- BEGIN RSD CUSTOM CONFIG ---' "\$HOME/.zshrc"
}

# Zshrc settings injection using block delimiters
function rsd::r::zsh_plugins::inject_zshrc_settings() {
    local block
    block=$(cat << 'EOF'
# --- BEGIN RSD CUSTOM CONFIG ---
plugins=(
    composer
    docker
    docker-compose
    git
    laravel
    rust
    yarn
    zsh-autosuggestions
    fzf-zsh-plugin
)

# Bindings
# SHIFT + UP | DOWN for History
bindkey "^[[1;2A" up-history
bindkey "^[[1;2B" down-history

# FZF Personalization
export FZF_DEFAULT_OPTS="
  --height=40%
  --layout=reverse
  --border
  --preview '
    case \$(file --mime {}) in
      *directory*)
        eza --all --long --tree {} ;;
      *image*)
        chafa {} --size 80x40 ;;
      *text*)
        bat --style=numbers --color=always {} | head -500 ;;
      *)
        exiftool {} ;;
    esac
  '
  --bind 'ctrl-/:toggle-preview'
"

# Exclude directories from fzf search
export FZF_DEFAULT_COMMAND='fdfind --type f --hidden --exclude .git --exclude node_modules'

# CONTROL + R - History
export FZF_CTRL_R_OPTS="--no-preview"

# Path expansions
export PATH="$PATH:/home/raul/.cargo/bin"
# --- END RSD CUSTOM CONFIG ---
EOF
)
    if [[ -n "$RSD_REMOTE_TARGET" ]]; then
        rsd::l::target::exec "printf" "%s\n" "$block" ">>" "\$HOME/.zshrc"
    else
        printf "%s\n" "$block" >> ~/.zshrc
    fi
}

# Zshrc settings rollback — remove the RSD config block between sentinel markers
function rsd::r::zsh_plugins::inject_zshrc_settings::rollback() {
    rsd::l::target::sed_delete_block \
        '# --- BEGIN RSD CUSTOM CONFIG ---' \
        '# --- END RSD CUSTOM CONFIG ---' \
        "\$HOME/.zshrc"
}
