#!/usr/bin/env bash

# @see docs/recipes.md
# @see AGENTS.md

if [[ ! -v RSD_ON || $RSD_ON -ne 1 ]]; then
    echo "This is a RSD library file. It should not be executed directly."
    echo "Please call 'rsd' to use it."
    exit 12
fi

function rsd::r::zsh_plugins::register() {
    # Prerequisite: Zsh and Oh My Zsh base must be satisfied first
    rsd::r::include "zsh/core"

    rsd::r::register_task "zsh_plugins::clone_autosuggestions"
    rsd::r::register_task "zsh_plugins::clone_fzf"
    rsd::r::register_task "zsh_plugins::clone_fzf_zsh_plugin"
    rsd::r::register_task "zsh_plugins::inject_zshrc_settings" "rollback"
}

# --- Task: clone_autosuggestions ---

function rsd::r::zsh_plugins::clone_autosuggestions::pre_check() {
    rsd::l::target::dir_exists "\${ZSH_CUSTOM:-\$HOME/.oh-my-zsh/custom}/plugins/zsh-autosuggestions"
}

function rsd::r::zsh_plugins::clone_autosuggestions() {
    rsd::l::target::git_clone \
        "https://github.com/zsh-users/zsh-autosuggestions" \
        "\${ZSH_CUSTOM:-\$HOME/.oh-my-zsh/custom}/plugins/zsh-autosuggestions"
}

# --- Task: clone_fzf ---

function rsd::r::zsh_plugins::clone_fzf::pre_check() {
    rsd::l::target::dir_exists "\$HOME/.fzf"
}

# FZF binary and keybinding installation (Unattended, requires two-step clone + install)
function rsd::r::zsh_plugins::clone_fzf() {
    rsd::l::target::git_clone "https://github.com/junegunn/fzf.git" "\$HOME/.fzf" "1"
    rsd::l::target::exec "\$HOME/.fzf/install" "--all"
}

# --- Task: clone_fzf_zsh_plugin ---

function rsd::r::zsh_plugins::clone_fzf_zsh_plugin::pre_check() {
    rsd::l::target::dir_exists "\${ZSH_CUSTOM:-\$HOME/.oh-my-zsh/custom}/plugins/fzf-zsh-plugin"
}

function rsd::r::zsh_plugins::clone_fzf_zsh_plugin() {
    rsd::l::target::git_clone \
        "https://github.com/unixorn/fzf-zsh-plugin.git" \
        "\${ZSH_CUSTOM:-\$HOME/.oh-my-zsh/custom}/plugins/fzf-zsh-plugin" 1
}

# --- Task: inject_zshrc_settings ---

function rsd::r::zsh_plugins::inject_zshrc_settings::pre_check() {
    rsd::l::target::file_contains '# --- BEGIN RSD CUSTOM CONFIG ---' "\$HOME/.zshrc"
}

# Zshrc settings injection using block delimiters
function rsd::r::zsh_plugins::inject_zshrc_settings() {
    local block
    block=$(cat << 'EOF'
# --- BEGIN RSD CUSTOM CONFIG ---
plugins=(
    composer
    docker
    docker-compose
    git
    laravel
    rust
    yarn
    zsh-autosuggestions
    fzf-zsh-plugin
)

# Bindings
# SHIFT + UP | DOWN for History
bindkey "^[[1;2A" up-history
bindkey "^[[1;2B" down-history

# FZF Personalization
export FZF_DEFAULT_OPTS="
  --height=40%
  --layout=reverse
  --border
  --preview '
    case \$(file --mime {}) in
      *directory*)
        eza --all --long --tree {} ;;
      *image*)
        chafa {} --size 80x40 ;;
      *text*)
        bat --style=numbers --color=always {} | head -500 ;;
      *)
        exiftool {} ;;
    esac
  '
  --bind 'ctrl-/:toggle-preview'
"

# Exclude directories from fzf search
export FZF_DEFAULT_COMMAND='fdfind --type f --hidden --exclude .git --exclude node_modules'

# CONTROL + R - History
export FZF_CTRL_R_OPTS="--no-preview"

# Path expansions
export PATH="$PATH:/home/raul/.cargo/bin"
# --- END RSD CUSTOM CONFIG ---
EOF
)
    if [[ -n "$RSD_REMOTE_TARGET" ]]; then
        rsd::l::target::exec "printf" "%s\n" "$block" ">>" "\$HOME/.zshrc"
    else
        printf "%s\n" "$block" >> ~/.zshrc
    fi
}

# Zshrc settings rollback using sed block removal
function rsd::r::zsh_plugins::inject_zshrc_settings::rollback() {
    rsd::l::target::exec sed -i '/# --- BEGIN RSD CUSTOM CONFIG ---/,/# --- END RSD CUSTOM CONFIG ---/d' "\$HOME/.zshrc"
}
