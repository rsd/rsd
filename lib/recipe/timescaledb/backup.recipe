#!/usr/bin/env bash

# ==============================================================================
# TimescaleDB — Database Backup
# ==============================================================================
#
# PURPOSE
# -------
# Creates a complete backup of a TimescaleDB/PostgreSQL database, including
# cluster-level globals (roles with encrypted passwords) and the database.
#
# PREREQUISITES
# -------------
# PostgreSQL must be running on the target. Typically after timescaledb/install.
#
# WHAT THIS RECIPE DOES
# ---------------------
#  1. validate_env  — Verifies pg_dump, compression support, output dir.
#  2. dump_globals  — pg_dumpall --globals-only → globals_<ts>.sql
#  3. dump_database — pg_dump -Fc --compress=<method> → <db>_<ts>_<method>.dump
#  4. verify_dump   — pg_restore --list confirms the dump is readable.
#  5. summary       — File sizes, paths, restore command hint.
#
# OUTPUT PATH SYNTAX (scp convention, colon required for remote)
# ------------------
#   backups/              Local, relative to $(pwd)
#   /tmp/backups/         Local, absolute
#   @bi:backups/          Remote 'bi', relative to $HOME
#   @bi:/tmp/backups/     Remote 'bi', absolute
#
# POSTGRESQL CONNECTION
# ---------------------
# Connection parameters follow the standard libpq resolution order:
#   1. CLI flags (--pg-host, --pg-port, --pg-user) passed to every PG tool.
#   2. Environment variables: PGHOST, PGPORT, PGUSER, PGPASSWORD, PGDATABASE.
#   3. Password file: ~/.pgpass (automatic, transparent).
#   4. pg_service.conf: named service profiles.
#   5. Compiled-in defaults: Unix socket, port 5432, OS username as role.
#
# If no --pg-* flags are given, pg_dump/psql use their own defaults.
# For password-based auth, set PGPASSWORD or use ~/.pgpass — this recipe
# never prompts interactively.
#
# COMPRESSION
# -----------
# Default: zstd (best ratio vs performance). Falls back to gzip if libzstd
# is unavailable on the target. Override with --compress <method>.
#
#   zstd   — Best ratio/speed balance (default, requires libzstd)
#   lz4    — Fastest, moderate ratio (requires liblz4)
#   gzip   — Universal fallback, slowest
#   none   — No compression
#
# NAMING CONVENTION
# -----------------
#   <db-name>_<YYYYMMDD_HHMMSS>_<compress>.dump
#   globals_<YYYYMMDD_HHMMSS>.sql
#
# IDEMPOTENCY
# -----------
# Each run creates a new timestamped backup. Safe to run multiple times.
#
# Usage:
#   rsd recipe run timescaledb/backup --db-name mydb --output backups/
#   rsd recipe run timescaledb/backup --db-name mydb --output backups/ --pg-user admin
#   rsd @bi recipe run timescaledb/backup --db-name crystal --output @bi:/tmp/backups/
#   rsd @bi recipe run timescaledb/backup --db-name crystal --output backups/ --compress lz4
#
# @see docs/recipes.md
# @see AGENTS.md

if [[ ! -v RSD_ON || $RSD_ON -ne 1 ]]; then
    echo "This is a RSD library file. It should not be executed directly."
    echo "Please call 'rsd' to use it."
    exit 12
fi

# Load dependencies
[[ "$RSD_PG_LIB" != "1" ]]      && source "$(rsd::get_libdir_file lib/pg.lib)"
[[ "$RSD_SYSTEMD_LIB" != "1" ]] && source "$(rsd::get_libdir_file lib/systemd.lib)"

# Recipe-specific CLI options
declare -g -A RSD_RECIPE_OPTIONS=(
    ["db-name"]=1
    ["output"]=1
    ["compress"]=1
    ["pg-host"]=1
    ["pg-port"]=1
    ["pg-user"]=1
)

# ==============================================================================
# Globals (populated during registration)
# ==============================================================================

declare -g RSD_BKP_DB_NAME=""
declare -g RSD_BKP_COMPRESS=""
declare -g RSD_BKP_TIMESTAMP=""
declare -g RSD_BKP_OUTPUT_IS_REMOTE=0
declare -g RSD_BKP_OUTPUT_HOST=""
declare -g RSD_BKP_OUTPUT_DIR=""
declare -g RSD_BKP_DUMP_FILENAME=""
declare -g RSD_BKP_GLOBALS_FILENAME=""    # superuser: globals_<ts>.sql
declare -g RSD_BKP_ROLE_FILENAME=""       # non-superuser: role_<ts>.sql
# 't' if connected user is a PG superuser, 'f' otherwise.
# Set by validate_env; governs dump_globals behavior.
declare -g RSD_BKP_IS_SUPER="f"

# ==============================================================================
# Helpers
# ==============================================================================

# ==============================================================================
# Recipe Registration
# ==============================================================================

function rsd::r::timescaledb_backup::register() {
    RSD_BKP_DB_NAME="${RSD_COMMAND_ARGS[db-name]:-}"
    local output="${RSD_COMMAND_ARGS[output]:-}"
    RSD_BKP_COMPRESS="${RSD_COMMAND_ARGS[compress]:-zstd}"

    if [[ -z "$RSD_BKP_DB_NAME" ]]; then
        rsd::io::error "--db-name is required."
        exit 2
    fi
    if [[ -z "$output" ]]; then
        rsd::io::error "--output is required."
        exit 2
    fi

    case "$RSD_BKP_COMPRESS" in
        zstd|lz4|gzip|none) ;;
        *)  rsd::io::error "Invalid --compress: $RSD_BKP_COMPRESS. Use: zstd, lz4, gzip, none."
            exit 2 ;;
    esac

    # Resolve PG connection: auto-detect or use explicit --pg-* flags
    if ! rsd::l::pg::resolve_from_args \
        "${RSD_COMMAND_ARGS[pg-host]:-}" \
        "${RSD_COMMAND_ARGS[pg-port]:-}" \
        "${RSD_COMMAND_ARGS[pg-user]:-}"; then
        exit 2
    fi

    if ! rsd::l::target::parse_scp "$output" \
        RSD_BKP_OUTPUT_HOST RSD_BKP_OUTPUT_DIR RSD_BKP_OUTPUT_IS_REMOTE; then
        exit 2
    fi

    # Cross-host validation
    if [[ "$RSD_BKP_OUTPUT_IS_REMOTE" == "1" ]]; then
        local target_host="${RSD_REMOTE_TARGET#@}"
        if [[ "$RSD_BKP_OUTPUT_HOST" != "$target_host" ]]; then
            rsd::io::error "Cross-host backup not supported. DB on @${target_host}, output on @${RSD_BKP_OUTPUT_HOST}."
            exit 2
        fi
    fi

    # Shared timestamp for all output files
    RSD_BKP_TIMESTAMP=$(date +%Y%m%d_%H%M%S)
    RSD_BKP_GLOBALS_FILENAME="globals_${RSD_BKP_TIMESTAMP}.sql"
    RSD_BKP_ROLE_FILENAME="role_${RSD_BKP_TIMESTAMP}.sql"
    RSD_BKP_DUMP_FILENAME="${RSD_BKP_DB_NAME}_${RSD_BKP_TIMESTAMP}_${RSD_BKP_COMPRESS}.dump"

    rsd::r::register_task "timescaledb_backup::validate_env"
    rsd::r::register_task "timescaledb_backup::dump_globals"
    rsd::r::register_task "timescaledb_backup::dump_database"
    rsd::r::register_task "timescaledb_backup::verify_dump"
    rsd::r::register_task "timescaledb_backup::summary"
}

# ==============================================================================
# Task: validate_env
# ==============================================================================

function rsd::r::timescaledb_backup::validate_env() {
    rsd::io::status "Validating backup environment..."

    # PostgreSQL running?
    if ! rsd::l::systemd::is_active "postgresql.service"; then
        rsd::io::error "PostgreSQL is not running on the target."
        return 1
    fi

    # pg_dump available?
    if ! rsd::l::target::has_bin pg_dump; then
        rsd::io::error "pg_dump not found on the target."
        return 1
    fi

    # ── Connection check ─────────────────────────────────────────────────
    rsd::l::pg::verify_connection || return 1

    # ── Database exists? ─────────────────────────────────────────────────
    if ! rsd::l::pg::database_exists "$RSD_BKP_DB_NAME"; then
        rsd::io::error "Database '${RSD_BKP_DB_NAME}' does not exist."
        return 1
    fi
    rsd::io::ok "Database '${RSD_BKP_DB_NAME}' found."

    # ── Superuser check ──────────────────────────────────────────────────
    if rsd::l::pg::is_superuser; then
        RSD_BKP_IS_SUPER="t"
        rsd::io::ok "Superuser — full globals dump available."
    else
        RSD_BKP_IS_SUPER="f"
        rsd::io::info "Not superuser — role attributes will be dumped (password excluded)."
        rsd::io::info "On restore, provide --db-password to set a new password."
    fi

    # ── Compression support ──────────────────────────────────────────────
    if [[ "$RSD_BKP_COMPRESS" == "zstd" || "$RSD_BKP_COMPRESS" == "lz4" ]]; then
        if ! rsd::l::pg::exec pg_dump \
            -Fc --compress="${RSD_BKP_COMPRESS}" template1 >/dev/null 2>/dev/null; then
            rsd::io::warn "${RSD_BKP_COMPRESS} not available (missing lib?). Falling back to gzip."
            RSD_BKP_COMPRESS="gzip"
            RSD_BKP_DUMP_FILENAME="${RSD_BKP_DB_NAME}_${RSD_BKP_TIMESTAMP}_${RSD_BKP_COMPRESS}.dump"
        else
            rsd::io::ok "${RSD_BKP_COMPRESS} compression supported."
        fi
    fi

    # ── Output directory ─────────────────────────────────────────────────
    if [[ "$RSD_BKP_OUTPUT_IS_REMOTE" == "1" ]]; then
        if ! rsd::l::target::exec_sudo "" install -d -m 0755 "$RSD_BKP_OUTPUT_DIR"; then
            rsd::io::error "Cannot create output dir: $RSD_BKP_OUTPUT_DIR"
            return 1
        fi
    else
        if ! mkdir -p "$RSD_BKP_OUTPUT_DIR"; then
            rsd::io::error "Cannot create local output dir: $RSD_BKP_OUTPUT_DIR"
            return 1
        fi
    fi
    rsd::io::ok "Output: ${RSD_BKP_OUTPUT_DIR}"

    rsd::io::ok "Environment validated."
}

# ==============================================================================
# Task: dump_globals
# ==============================================================================
# Dumps cluster-level role information.
# Superuser: full pg_dumpall --globals-only (all roles + password hashes).
# Non-superuser: generates a CREATE ROLE statement from pg_roles
#   (role attributes preserved, password excluded).

function rsd::r::timescaledb_backup::dump_globals() {
    if [[ "$RSD_BKP_IS_SUPER" == "t" ]]; then
        rsd::r::timescaledb_backup::_dump_globals_full
    else
        rsd::r::timescaledb_backup::_dump_role_attributes
    fi
}

# Superuser path: full pg_dumpall --globals-only
function rsd::r::timescaledb_backup::_dump_globals_full() {
    rsd::io::status "Dumping cluster globals (all roles + passwords)..."

    local dest="${RSD_BKP_OUTPUT_DIR}/${RSD_BKP_GLOBALS_FILENAME}"

    if [[ "$RSD_BKP_OUTPUT_IS_REMOTE" == "1" ]]; then
        local tmp
        tmp=$(rsd::l::target::mktemp "rsd-globals.XXXXXX") || return 14

        if ! rsd::l::pg::exec pg_dumpall --globals-only -f "$tmp"; then
            rsd::l::target::exec rm -f "$tmp"
            rsd::io::error "pg_dumpall --globals-only failed."
            return 1
        fi
        rsd::l::target::exec_sudo "" mv "$tmp" "$dest"
        rsd::l::target::exec_sudo "" chmod 0640 "$dest"
    else
        if ! rsd::l::pg::exec pg_dumpall --globals-only -f "$dest"; then
            rsd::io::error "pg_dumpall --globals-only failed."
            return 1
        fi
        chmod 0640 "$dest"
    fi

    rsd::io::ok "Globals → ${dest}"
}

# Non-superuser path: reconstruct role from pg_roles.
# Queries raw columns (readable by any user) and builds the SQL in bash
# to avoid escaping nightmares in PG string concatenation.
function rsd::r::timescaledb_backup::_dump_role_attributes() {
    rsd::io::status "Dumping role attributes (non-superuser mode)..."

    # Pipe-delimited: name|login|super|createdb|createrole|inherit|repl|bypassrls|connlimit|validuntil
    local raw
    raw=$(rsd::l::pg::psql \
        "SELECT rolname, rolcanlogin, rolsuper, rolcreatedb, rolcreaterole, rolinherit, rolreplication, rolbypassrls, rolconnlimit, rolvaliduntil FROM pg_roles WHERE rolname = current_user")

    if [[ -z "$raw" ]]; then
        rsd::io::error "Could not read role attributes from pg_roles."
        return 1
    fi

    # Parse columns
    local IFS='|'
    read -r r_name r_login r_super r_createdb r_createrole r_inherit r_repl r_bypassrls r_connlimit r_validuntil <<< "$raw"

    # Build ALTER ROLE attributes string
    local attrs=""
    [[ "$r_login"      == "t" ]] && attrs+=" LOGIN"       || attrs+=" NOLOGIN"
    [[ "$r_super"      == "t" ]] && attrs+=" SUPERUSER"   || attrs+=" NOSUPERUSER"
    [[ "$r_createdb"   == "t" ]] && attrs+=" CREATEDB"    || attrs+=" NOCREATEDB"
    [[ "$r_createrole" == "t" ]] && attrs+=" CREATEROLE"  || attrs+=" NOCREATEROLE"
    [[ "$r_inherit"    == "t" ]] && attrs+=" INHERIT"     || attrs+=" NOINHERIT"
    [[ "$r_repl"       == "t" ]] && attrs+=" REPLICATION" || attrs+=" NOREPLICATION"
    [[ "$r_bypassrls"  == "t" ]] && attrs+=" BYPASSRLS"   || attrs+=" NOBYPASSRLS"
    [[ "$r_connlimit" -ge 0 ]] 2>/dev/null && attrs+=" CONNECTION LIMIT ${r_connlimit}"
    [[ -n "$r_validuntil" ]] && attrs+=" VALID UNTIL '${r_validuntil}'"

    local dest="${RSD_BKP_OUTPUT_DIR}/${RSD_BKP_ROLE_FILENAME}"

    # Build the SQL content into a variable to avoid heredoc-to-remote issues.
    local sql_content
    sql_content=$(cat <<EOSQL
-- Role attributes dumped by rsd timescaledb/backup
-- Timestamp: ${RSD_BKP_TIMESTAMP}
-- NOTE: Password hash excluded (non-superuser dump).
--       Set password on restore with: ALTER ROLE "${r_name}" WITH PASSWORD '...';

DO \$\$
BEGIN
  IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname = '${r_name}') THEN
    CREATE ROLE "${r_name}";
  END IF;
END \$\$;

ALTER ROLE "${r_name}" WITH${attrs};
EOSQL
    )

    if [[ "$RSD_BKP_OUTPUT_IS_REMOTE" == "1" ]]; then
        # Write to local temp, push to remote, clean up.
        local tmp
        tmp=$(mktemp -t "rsd-role.XXXXXX") || return 14
        printf '%s\n' "$sql_content" > "$tmp"
        chmod 0640 "$tmp"

        rsd::l::target::file_push "$tmp" "$dest" || {
            rm -f "$tmp"
            rsd::io::error "Failed to transfer role file to remote."
            return 1
        }
        rm -f "$tmp"
        rsd::l::target::exec_sudo "" chmod 0640 "$dest"
    else
        printf '%s\n' "$sql_content" > "$dest"
        chmod 0640 "$dest"
    fi

    rsd::io::ok "Role → ${dest}"
}

# ==============================================================================
# Task: dump_database
# ==============================================================================
# Custom format (-Fc) with configurable compression. pg_dump writes directly
# to the output path (local) or to a temp file that gets moved (remote).

function rsd::r::timescaledb_backup::dump_database() {
    rsd::io::status "Dumping '${RSD_BKP_DB_NAME}' (compress=${RSD_BKP_COMPRESS})..."

    local -a compress_args=()
    [[ "$RSD_BKP_COMPRESS" != "none" ]] && compress_args=(--compress="${RSD_BKP_COMPRESS}")

    local dest="${RSD_BKP_OUTPUT_DIR}/${RSD_BKP_DUMP_FILENAME}"

    if [[ "$RSD_BKP_OUTPUT_IS_REMOTE" == "1" ]]; then
        local tmp
        tmp=$(rsd::l::target::mktemp "rsd-pgdump.XXXXXX") || return 14

        if ! rsd::l::pg::exec pg_dump \
            -Fc "${compress_args[@]}" \
            -f "$tmp" \
            "$RSD_BKP_DB_NAME"; then
            rsd::l::target::exec rm -f "$tmp"
            rsd::io::error "pg_dump failed."
            return 1
        fi
        rsd::l::target::exec_sudo "" mv "$tmp" "$dest"
        rsd::l::target::exec_sudo "" chmod 0644 "$dest"
    else
        if ! rsd::l::pg::exec pg_dump \
            -Fc "${compress_args[@]}" \
            -f "$dest" \
            "$RSD_BKP_DB_NAME"; then
            rsd::io::error "pg_dump failed."
            return 1
        fi
    fi

    rsd::io::ok "Database → ${dest}"
}

# ==============================================================================
# Task: verify_dump
# ==============================================================================
# Runs pg_restore --list to confirm the dump is structurally valid.
# pg_restore --list is read-only — no database connection, no privileges.

function rsd::r::timescaledb_backup::verify_dump() {
    rsd::io::status "Verifying dump integrity..."

    local dump_path="${RSD_BKP_OUTPUT_DIR}/${RSD_BKP_DUMP_FILENAME}"

    if [[ "$RSD_BKP_OUTPUT_IS_REMOTE" == "1" ]]; then
        if ! rsd::l::target::exec pg_restore --list "$dump_path" >/dev/null 2>/dev/null; then
            rsd::io::error "Dump verification failed. File may be corrupt: $dump_path"
            return 1
        fi
    else
        if type pg_restore >/dev/null 2>&1; then
            if ! pg_restore --list "$dump_path" >/dev/null 2>/dev/null; then
                rsd::io::error "Dump verification failed (local pg_restore)."
                return 1
            fi
        else
            rsd::io::warn "pg_restore not available locally. Skipping verification."
            rsd::io::info "Manual check: pg_restore --list $dump_path"
            return 0
        fi
    fi

    rsd::io::ok "Dump integrity verified."
}

# ==============================================================================
# Task: summary
# ==============================================================================

function rsd::r::timescaledb_backup::summary() {
    local dump_path="${RSD_BKP_OUTPUT_DIR}/${RSD_BKP_DUMP_FILENAME}"
    local globals_path="${RSD_BKP_OUTPUT_DIR}/${RSD_BKP_GLOBALS_FILENAME}"
    local role_path="${RSD_BKP_OUTPUT_DIR}/${RSD_BKP_ROLE_FILENAME}"

    # Determine which role/globals file was produced
    local role_file="" role_label=""
    if [[ "$RSD_BKP_IS_SUPER" == "t" ]]; then
        role_file="$globals_path"
        role_label="$RSD_BKP_GLOBALS_FILENAME"
    else
        role_file="$role_path"
        role_label="$RSD_BKP_ROLE_FILENAME"
    fi

    # File sizes
    local dump_size dump_hr role_size role_hr
    if [[ "$RSD_BKP_OUTPUT_IS_REMOTE" == "1" ]]; then
        dump_size=$(rsd::l::target::exec stat -c%s "$dump_path" 2>/dev/null)
        role_size=$(rsd::l::target::exec stat -c%s "$role_file" 2>/dev/null)
    else
        dump_size=$(stat -c%s "$dump_path" 2>/dev/null)
        role_size=$(stat -c%s "$role_file" 2>/dev/null)
    fi
    dump_hr=$(numfmt --to=iec-i --suffix=B "${dump_size:-0}" 2>/dev/null || echo "${dump_size:-0} bytes")
    role_hr=$(numfmt --to=iec-i --suffix=B "${role_size:-0}" 2>/dev/null || echo "${role_size:-0} bytes")

    rsd::io::blank
    rsd::io::banner "Backup Complete"
    rsd::io::blank
    rsd::io::info "Database:    ${RSD_BKP_DB_NAME}"
    rsd::io::info "Compression: ${RSD_BKP_COMPRESS}"
    rsd::io::info "Timestamp:   ${RSD_BKP_TIMESTAMP}"
    rsd::io::blank
    rsd::io::info "Files:"
    rsd::io::info "  ${RSD_BKP_DUMP_FILENAME}  (${dump_hr})"
    rsd::io::info "  ${role_label}  (${role_hr})"
    rsd::io::blank

    # Show restore command with correct path syntax
    local target_flag=""
    [[ -n "$RSD_REMOTE_TARGET" ]] && target_flag="@${RSD_REMOTE_TARGET#@} "

    local prefix=""
    [[ "$RSD_BKP_OUTPUT_IS_REMOTE" == "1" ]] && prefix="@${RSD_BKP_OUTPUT_HOST}:"

    rsd::io::banner "Restore Command"
    rsd::io::blank
    rsd::io::info "  rsd ${target_flag}recipe run timescaledb/restore \\"
    rsd::io::info "    --db-name ${RSD_BKP_DB_NAME} \\"
    rsd::io::info "    --from ${prefix}${RSD_BKP_OUTPUT_DIR}"
    rsd::io::blank
}
