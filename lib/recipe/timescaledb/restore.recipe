#!/usr/bin/env bash

# ==============================================================================
# TimescaleDB — Database Restore
# ==============================================================================
#
# PURPOSE
# -------
# Restores a TimescaleDB/PostgreSQL database from a backup created by
# timescaledb/backup. Creates the role (if missing), creates the database,
# and restores the dump.
#
# INPUT RESOLUTION
# ----------------
# --from accepts either a directory or a specific dump file:
#
#   Directory (auto-discover):
#     --from /tmp/backup
#     Scans for <db-name>_*_*.dump, picks the latest by timestamp.
#     Finds matching role_<ts>.sql or globals_<ts>.sql automatically.
#
#   File (explicit):
#     --from /tmp/backup/mydb_20260530_000253_zstd.dump
#     Finds matching role/globals file in the same directory.
#
# PASSWORD HANDLING
# -----------------
# If the backup contains role_*.sql (non-superuser dump), the role has
# no password hash. The recipe will:
#   1. Use --db-password if provided on the command line.
#   2. Otherwise, prompt interactively (read -s, no echo).
#   3. After successful restore, offer to save in the RSD vault.
#
# POSTGRESQL CONNECTION
# ---------------------
# The restoring user (--pg-user) must have privileges to create roles
# and databases. Typically this is the 'postgres' superuser or another
# admin role. Connection params follow libpq conventions:
#   --pg-host, --pg-port, --pg-user → passed to psql/pg_restore.
#   Environment: PGHOST, PGPORT, PGUSER, PGPASSWORD, ~/.pgpass.
#
# WHAT THIS RECIPE DOES
# ---------------------
#  1. resolve_input     — Finds dump + role/globals files, validates them.
#  2. apply_role        — Executes the role SQL, sets password if needed.
#  3. create_database   — CREATE DATABASE owned by the role.
#  4. restore_database  — pg_restore -d <db> from the dump file.
#  5. verify_restore    — Table count, TimescaleDB extension check.
#  6. summary           — Stats and confirmation.
#
# IDEMPOTENCY
# -----------
# - Role creation is guarded with IF NOT EXISTS.
# - Database creation fails if the database already exists (use
#   --drop-existing to drop first).
# - pg_restore with --clean --if-exists handles re-runs on existing DBs.
#
# Usage:
#   rsd recipe run timescaledb/restore --db-name mydb --from /tmp/backup
#   rsd recipe run timescaledb/restore --db-name mydb --from /tmp/backup --pg-user postgres
#   rsd recipe run timescaledb/restore --db-name mydb --from /tmp/backup --drop-existing
#
# @see docs/recipes.md

if [[ ! -v RSD_ON || $RSD_ON -ne 1 ]]; then
    echo "This is a RSD library file. It should not be executed directly."
    echo "Please call 'rsd' to use it."
    exit 12
fi

# Recipe-specific CLI options
declare -g -A RSD_RECIPE_OPTIONS=(
    ["db-name"]=1
    ["from"]=1
    ["db-password"]=1
    ["pg-host"]=1
    ["pg-port"]=1
    ["pg-user"]=1
    ["drop-existing"]=0
)

# ==============================================================================
# Globals (populated during registration / resolve_input)
# ==============================================================================

declare -g RSD_RST_DB_NAME=""
declare -g RSD_RST_DB_PASSWORD=""
declare -g RSD_RST_FROM=""             # raw --from value
declare -g RSD_RST_DUMP_FILE=""        # resolved absolute path to .dump
declare -g RSD_RST_ROLE_FILE=""        # resolved path to role_*.sql or globals_*.sql
declare -g RSD_RST_ROLE_TYPE=""        # 'role' (no password hash) or 'globals' (full)
declare -g RSD_RST_ROLE_NAME=""        # role name extracted from the role SQL
declare -g RSD_RST_DROP_EXISTING=0
# Connection args array: built from --pg-host/--pg-port/--pg-user.
declare -g -a RSD_RST_PG_CONN=()

# ==============================================================================
# Helpers
# ==============================================================================

# Execute a psql command with the recipe's PG connection parameters.
#
# @param string $1 SQL to execute.
# @param string $2 Optional: database name.
# @return int psql exit code.
function rsd::l::r::rst::psql() {
    local sql="$1"
    local db="${2:-}"
    local -a db_args=()
    [[ -n "$db" ]] && db_args=(-d "$db")

    printf '%s\n' "$sql" | \
        rsd::l::target::exec psql -XAt "${RSD_RST_PG_CONN[@]}" "${db_args[@]}" -f - 2>/dev/null
}

# Execute a PG tool with connection parameters.
#
# @param string... Command and arguments.
# @return int command exit code.
function rsd::l::r::rst::pg_exec() {
    local cmd="$1"
    shift
    rsd::l::target::exec "$cmd" "${RSD_RST_PG_CONN[@]}" "$@"
}

# ==============================================================================
# Recipe Registration
# ==============================================================================

function rsd::r::timescaledb_restore::register() {
    RSD_RST_DB_NAME="${RSD_COMMAND_ARGS[db-name]:-}"
    RSD_RST_FROM="${RSD_COMMAND_ARGS[from]:-}"
    RSD_RST_DB_PASSWORD="${RSD_COMMAND_ARGS[db-password]:-}"

    if [[ -z "$RSD_RST_DB_NAME" ]]; then
        rsd::io::error "--db-name is required."
        exit 2
    fi
    if [[ -z "$RSD_RST_FROM" ]]; then
        rsd::io::error "--from is required. Specify the backup directory or dump file."
        exit 2
    fi

    # Drop existing flag
    [[ -v RSD_COMMAND_ARGS[drop-existing] ]] && RSD_RST_DROP_EXISTING=1

    # Build PG connection args
    RSD_RST_PG_CONN=()
    [[ -n "${RSD_COMMAND_ARGS[pg-host]:-}" ]] && RSD_RST_PG_CONN+=(-h "${RSD_COMMAND_ARGS[pg-host]}")
    [[ -n "${RSD_COMMAND_ARGS[pg-port]:-}" ]] && RSD_RST_PG_CONN+=(-p "${RSD_COMMAND_ARGS[pg-port]}")
    [[ -n "${RSD_COMMAND_ARGS[pg-user]:-}" ]] && RSD_RST_PG_CONN+=(-U "${RSD_COMMAND_ARGS[pg-user]}")

    rsd::r::register_task "timescaledb_restore::resolve_input"
    rsd::r::register_task "timescaledb_restore::apply_role"
    rsd::r::register_task "timescaledb_restore::create_database"
    rsd::r::register_task "timescaledb_restore::restore_database"
    rsd::r::register_task "timescaledb_restore::verify_restore"
    rsd::r::register_task "timescaledb_restore::summary"
}

# ==============================================================================
# Task: resolve_input
# ==============================================================================
# Resolves --from into a dump file + role/globals file.
# If --from is a directory, auto-discovers by naming convention.

function rsd::r::timescaledb_restore::resolve_input() {
    rsd::io::status "Resolving backup files..."

    local from="$RSD_RST_FROM"

    # ── Connection check ─────────────────────────────────────────────────
    local conn_user
    conn_user=$(rsd::l::r::rst::psql "SELECT current_user")
    if [[ -z "$conn_user" ]]; then
        rsd::io::error "Cannot connect to PostgreSQL."
        if [[ ${#RSD_RST_PG_CONN[@]} -eq 0 ]]; then
            rsd::io::info "Try: --pg-user postgres"
        fi
        return 1
    fi
    rsd::io::ok "Connected as: ${conn_user}"

    # ── Resolve dump file ────────────────────────────────────────────────
    if [[ -d "$from" ]]; then
        # Directory mode: find latest dump matching db-name
        local latest
        latest=$(ls -1t "${from}/${RSD_RST_DB_NAME}_"*".dump" 2>/dev/null | head -1)
        if [[ -z "$latest" ]]; then
            rsd::io::error "No dump file found for '${RSD_RST_DB_NAME}' in: ${from}"
            rsd::io::info "Expected: ${from}/${RSD_RST_DB_NAME}_<timestamp>_<compress>.dump"
            return 1
        fi
        RSD_RST_DUMP_FILE="$latest"
    elif [[ -f "$from" ]]; then
        RSD_RST_DUMP_FILE="$from"
    else
        rsd::io::error "Not a file or directory: ${from}"
        return 1
    fi
    rsd::io::ok "Dump: ${RSD_RST_DUMP_FILE}"

    # ── Verify dump ──────────────────────────────────────────────────────
    if type pg_restore >/dev/null 2>&1; then
        if ! pg_restore --list "$RSD_RST_DUMP_FILE" >/dev/null 2>/dev/null; then
            rsd::io::error "Dump file is corrupt or unreadable: ${RSD_RST_DUMP_FILE}"
            return 1
        fi
    fi

    # ── Extract timestamp from dump filename ─────────────────────────────
    # Convention: <db-name>_<YYYYMMDD_HHMMSS>_<compress>.dump
    local dump_basename
    dump_basename=$(basename "$RSD_RST_DUMP_FILE")
    local ts_part
    ts_part=$(echo "$dump_basename" | sed -n "s/^${RSD_RST_DB_NAME}_\([0-9]\{8\}_[0-9]\{6\}\)_.*/\1/p")
    if [[ -z "$ts_part" ]]; then
        rsd::io::warn "Could not extract timestamp from: ${dump_basename}"
        rsd::io::info "Skipping role/globals file auto-discovery."
        return 0
    fi

    # ── Find matching role/globals file ──────────────────────────────────
    local dump_dir
    dump_dir=$(dirname "$RSD_RST_DUMP_FILE")

    if [[ -f "${dump_dir}/globals_${ts_part}.sql" ]]; then
        RSD_RST_ROLE_FILE="${dump_dir}/globals_${ts_part}.sql"
        RSD_RST_ROLE_TYPE="globals"
        rsd::io::ok "Globals: ${RSD_RST_ROLE_FILE}"
    elif [[ -f "${dump_dir}/role_${ts_part}.sql" ]]; then
        RSD_RST_ROLE_FILE="${dump_dir}/role_${ts_part}.sql"
        RSD_RST_ROLE_TYPE="role"
        rsd::io::ok "Role: ${RSD_RST_ROLE_FILE}"
    else
        rsd::io::warn "No matching role/globals file for timestamp ${ts_part}."
        rsd::io::info "The database will be restored, but the owning role must exist."
    fi

    # ── Extract role name from the SQL ───────────────────────────────────
    if [[ -n "$RSD_RST_ROLE_FILE" ]]; then
        RSD_RST_ROLE_NAME=$(grep -oP 'CREATE ROLE\s+"\K[^"]+' "$RSD_RST_ROLE_FILE" | head -1)
        if [[ -z "$RSD_RST_ROLE_NAME" ]]; then
            # Try unquoted form
            RSD_RST_ROLE_NAME=$(grep -oP 'CREATE ROLE\s+\K\S+' "$RSD_RST_ROLE_FILE" | head -1 | tr -d ';')
        fi
        [[ -n "$RSD_RST_ROLE_NAME" ]] && rsd::io::ok "Role name: ${RSD_RST_ROLE_NAME}"
    fi

    rsd::io::ok "Input resolved."
}

# ==============================================================================
# Task: apply_role
# ==============================================================================
# Executes the role/globals SQL file. For role_*.sql (non-superuser backup),
# prompts for password if not provided via --db-password.

function rsd::r::timescaledb_restore::apply_role::pre_check() {
    if [[ -z "$RSD_RST_ROLE_FILE" ]]; then
        rsd::io::info "No role/globals file — skipping."
        return 1
    fi
    return 0
}

function rsd::r::timescaledb_restore::apply_role() {
    rsd::io::status "Applying role definitions..."

    # Execute the role SQL
    if ! rsd::l::r::rst::pg_exec psql -XAt -f "$RSD_RST_ROLE_FILE" >/dev/null 2>&1; then
        rsd::io::error "Failed to apply role SQL: ${RSD_RST_ROLE_FILE}"
        return 1
    fi
    rsd::io::ok "Role SQL applied."

    # ── Password handling for role_*.sql (no hash) ───────────────────────
    if [[ "$RSD_RST_ROLE_TYPE" == "role" && -n "$RSD_RST_ROLE_NAME" ]]; then
        # Password needed — prompt if not provided
        if [[ -z "$RSD_RST_DB_PASSWORD" ]]; then
            rsd::io::blank
            rsd::io::info "The backup was made without superuser access."
            rsd::io::info "A password is required for role '${RSD_RST_ROLE_NAME}'."
            rsd::io::blank

            local pw1="" pw2=""
            read -r -s -p "[rsd]          ▸ Password for '${RSD_RST_ROLE_NAME}': " pw1
            echo ""
            read -r -s -p "[rsd]          ▸ Confirm password: " pw2
            echo ""

            if [[ "$pw1" != "$pw2" ]]; then
                rsd::io::error "Passwords do not match."
                return 1
            fi
            if [[ -z "$pw1" ]]; then
                rsd::io::error "Password cannot be empty."
                return 1
            fi
            RSD_RST_DB_PASSWORD="$pw1"
        fi

        # Set the password
        if ! rsd::l::r::rst::psql "ALTER ROLE \"${RSD_RST_ROLE_NAME}\" WITH PASSWORD '${RSD_RST_DB_PASSWORD}'"; then
            rsd::io::error "Failed to set password for role '${RSD_RST_ROLE_NAME}'."
            return 1
        fi
        rsd::io::ok "Password set for role '${RSD_RST_ROLE_NAME}'."
    fi
}

# ==============================================================================
# Task: create_database
# ==============================================================================

function rsd::r::timescaledb_restore::create_database::pre_check() {
    local db_exists
    db_exists=$(rsd::l::r::rst::psql \
        "SELECT 1 FROM pg_database WHERE datname = '${RSD_RST_DB_NAME}'")

    if [[ "$db_exists" == "1" ]]; then
        if [[ "$RSD_RST_DROP_EXISTING" -eq 1 ]]; then
            rsd::io::warn "Database '${RSD_RST_DB_NAME}' exists — will be dropped (--drop-existing)."
            return 0
        fi
        rsd::io::error "Database '${RSD_RST_DB_NAME}' already exists."
        rsd::io::info "Use --drop-existing to replace it."
        return 1
    fi
    return 0
}

function rsd::r::timescaledb_restore::create_database() {
    local owner="${RSD_RST_ROLE_NAME:-$RSD_RST_DB_NAME}"

    # Drop if requested
    if [[ "$RSD_RST_DROP_EXISTING" -eq 1 ]]; then
        local db_exists
        db_exists=$(rsd::l::r::rst::psql \
            "SELECT 1 FROM pg_database WHERE datname = '${RSD_RST_DB_NAME}'")
        if [[ "$db_exists" == "1" ]]; then
            rsd::io::status "Dropping existing database '${RSD_RST_DB_NAME}'..."

            # Terminate active connections first
            rsd::l::r::rst::psql \
                "SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname = '${RSD_RST_DB_NAME}' AND pid <> pg_backend_pid()" \
                >/dev/null 2>&1

            if ! rsd::l::r::rst::pg_exec dropdb "${RSD_RST_DB_NAME}"; then
                rsd::io::error "Failed to drop database '${RSD_RST_DB_NAME}'."
                return 1
            fi
            rsd::io::ok "Dropped '${RSD_RST_DB_NAME}'."
        fi
    fi

    rsd::io::status "Creating database '${RSD_RST_DB_NAME}' (owner: ${owner})..."

    if ! rsd::l::r::rst::pg_exec createdb -O "$owner" "$RSD_RST_DB_NAME"; then
        rsd::io::error "Failed to create database '${RSD_RST_DB_NAME}'."
        return 1
    fi

    rsd::io::ok "Database '${RSD_RST_DB_NAME}' created."
}

# ==============================================================================
# Task: restore_database
# ==============================================================================
# pg_restore from the custom-format dump into the new database.

function rsd::r::timescaledb_restore::restore_database() {
    rsd::io::status "Restoring '${RSD_RST_DB_NAME}' from dump..."
    rsd::io::info "This may take a while for large databases."

    # Enable TimescaleDB extension before restore (required for hypertable restore)
    rsd::l::r::rst::psql "CREATE EXTENSION IF NOT EXISTS timescaledb CASCADE" "$RSD_RST_DB_NAME" \
        >/dev/null 2>&1

    if ! rsd::l::r::rst::pg_exec pg_restore \
        --dbname="$RSD_RST_DB_NAME" \
        --no-owner \
        --no-privileges \
        --exit-on-error \
        "$RSD_RST_DUMP_FILE" 2>&1; then
        rsd::io::error "pg_restore failed."
        return 1
    fi

    rsd::io::ok "Database restored."
}

# ==============================================================================
# Task: verify_restore
# ==============================================================================

function rsd::r::timescaledb_restore::verify_restore() {
    rsd::io::status "Verifying restore..."

    # Table count
    local table_count
    table_count=$(rsd::l::r::rst::psql \
        "SELECT count(*) FROM information_schema.tables WHERE table_schema = 'public'" \
        "$RSD_RST_DB_NAME")
    rsd::io::ok "Tables in 'public': ${table_count:-0}"

    # TimescaleDB hypertables
    local hypertable_count
    hypertable_count=$(rsd::l::r::rst::psql \
        "SELECT count(*) FROM timescaledb_information.hypertables" \
        "$RSD_RST_DB_NAME" 2>/dev/null)
    if [[ -n "$hypertable_count" ]]; then
        rsd::io::ok "Hypertables: ${hypertable_count}"
    fi

    # TimescaleDB extension version
    local ts_version
    ts_version=$(rsd::l::r::rst::psql \
        "SELECT extversion FROM pg_extension WHERE extname = 'timescaledb'" \
        "$RSD_RST_DB_NAME" 2>/dev/null)
    if [[ -n "$ts_version" ]]; then
        rsd::io::ok "TimescaleDB version: ${ts_version}"
    fi

    rsd::io::ok "Restore verified."
}

# ==============================================================================
# Task: summary
# ==============================================================================

function rsd::r::timescaledb_restore::summary() {
    rsd::io::blank
    rsd::io::banner "Restore Complete"
    rsd::io::blank
    rsd::io::info "Database: ${RSD_RST_DB_NAME}"
    rsd::io::info "From:     ${RSD_RST_DUMP_FILE}"
    [[ -n "$RSD_RST_ROLE_FILE" ]] && rsd::io::info "Role:     ${RSD_RST_ROLE_FILE}"
    [[ -n "$RSD_RST_ROLE_NAME" ]] && rsd::io::info "Owner:    ${RSD_RST_ROLE_NAME}"
    rsd::io::blank

    # ── Vault save offer ─────────────────────────────────────────────────
    # Only offer if password was set (role_*.sql path) and vault is available
    if [[ "$RSD_RST_ROLE_TYPE" == "role" && -n "$RSD_RST_DB_PASSWORD" && -n "$RSD_RST_ROLE_NAME" ]]; then
        if type keepassxc-cli >/dev/null 2>&1; then
            local save_choice=""
            read -r -p "[rsd]          ▸ Save password for '${RSD_RST_ROLE_NAME}' to vault? [y/N] " save_choice
            if [[ "$save_choice" =~ ^[Yy]$ ]]; then
                [[ "$RSD_KPX_LIB" != "1" ]] && source "$RSD_BASE/lib/kpx.lib"
                local vault_path="PostgreSQL/${RSD_RST_DB_NAME}"
                if rsd::l::kpx::add_password "$vault_path" "$RSD_RST_ROLE_NAME" "$RSD_RST_DB_PASSWORD"; then
                    rsd::io::ok "Saved to vault: ${vault_path}"
                else
                    rsd::io::warn "Could not save to vault. Run 'rsd kpx init' to set up."
                fi
            fi
        fi
    fi

    rsd::io::blank
}
