#!/usr/bin/env bash

# @see docs/recipes.md
# @see AGENTS.md

if [[ ! -v RSD_ON || $RSD_ON -ne 1 ]]; then
    echo "This is a RSD library file. It should not be executed directly."
    echo "Please call 'rsd' to use it."
    exit 12
fi

function rsd::recipe::zsh_core::register() {
    rsd::recipe::register_task \
        --name "zsh_core::install_zsh" \
        --pre-check "rsd::l::target::has_bin zsh" \
        --apply "rsd::l::recipe::install_pkg zsh" \
        --recovery "forward"

    rsd::recipe::register_task \
        --name "zsh_core::set_default_shell" \
        --pre-check "rsd::recipe::zsh_core::shell_pre" \
        --apply "rsd::recipe::zsh_core::shell_apply" \
        --recovery "rollback" \
        --rollback "rsd::l::target::exec_sudo '' chsh -s /bin/bash $USER"

    rsd::recipe::register_task \
        --name "zsh_core::install_oh_my_zsh" \
        --pre-check "rsd::l::target::dir_exists \$HOME/.oh-my-zsh" \
        --apply "rsd::recipe::zsh_core::omz_apply" \
        --recovery "forward"
}

# Default shell pre-check requires reading $SHELL, which has no single-line helper equivalent
function rsd::recipe::zsh_core::shell_pre() {
    local current_shell=""
    if [[ -n "$RSD_REMOTE_TARGET" ]]; then
        current_shell=$(rsd::l::remote::execute "$RSD_REMOTE_TARGET" "echo \$SHELL")
    else
        current_shell="$SHELL"
    fi
    [[ "$current_shell" == *"/zsh" ]]
}

# Default shell change requires dynamic path resolution before sudo elevation
function rsd::recipe::zsh_core::shell_apply() {
    local zsh_path=""
    if [[ -n "$RSD_REMOTE_TARGET" ]]; then
        zsh_path=$(rsd::l::remote::execute "$RSD_REMOTE_TARGET" "which" "zsh" 2>/dev/null)
        zsh_path="${zsh_path#"${zsh_path%%[![:space:]]*}"}"
        zsh_path="${zsh_path%"${zsh_path%%[![:space:]]*}"}"

        if [[ -z "$zsh_path" ]]; then
            rsd::warn "Error: Zsh binary was not found on remote target."
            return 3
        fi
    else
        zsh_path=$(which zsh 2>/dev/null)
    fi

    rsd::l::target::exec_sudo "" "chsh" "-s" "$zsh_path" "$USER"
}

# Oh My Zsh unattended installation has a multi-step pipeline with no helper shortcut
function rsd::recipe::zsh_core::omz_apply() {
    if [[ -n "$RSD_REMOTE_TARGET" ]]; then
        rsd::l::target::exec "curl" "-fsSL" "https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh" "-o" "/tmp/omz_install.sh"
        rsd::l::target::exec "sh" "/tmp/omz_install.sh" "--unattended"
        rsd::l::target::exec "rm" "-f" "/tmp/omz_install.sh"
    else
        sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended
    fi
}
