#!/usr/bin/env bash

if [[ ! -v RSD_ON || $RSD_ON -ne 1 ]]; then
    echo "This is a RSD library file. It should not be executed directly."
    echo "Please call 'rsd' to use it."
    exit 12
fi

# main support library to RSD

# _prefix rsd::

RSD_RSDLIB_VERSION='0.3.0'

# used globals
RSD_LIBRARY_LOAD=

# checks if there are the minimun required arguments or call usage
function rsd::arguments_or_usage() {
	local total=$1
	shift

	if [[ "$#" -lt "$total" ]]; then
	    rsd::warn "Abort! Missing required arguments: given $total of $#"
	    rsd::warn "Called from ${FUNCNAME[1]} -> ${FUNCNAME[2]}"
		rsd::usage
	fi
	return 0
}

# locates the command and, if exists, outputs it to STDOUT. {}'"`_()
function rsd::check_command() {
	local command

	for command in $1 $1.sh $1.bash $1.cmd $1.rsd; do
		rsd::debug "Looking for '$1' in $command" 30
		if rsd::check_libdir_file "command/$command"; then
            echo "$(rsd::get_libdir_file "command/$command")"
            rsd::debug "Found $command" 21
            return 0
		fi
	done
	return 1
}

# this outputs the source line to be executed by source
# Arguments:
#   $1 - the command to be loaded
# Example:
#   source rsd::load_command_file "command"
function rsd::load_command_file() {
	rsd::arguments_or_usage 1 "$@"
	local command_with_path
	local command=$1

	if ! command_with_path=$(rsd::check_command "$command"); then
		rsd::debug "Command $command is invalid!" 15
		return 1
	fi
	echo "$command_with_path"
	return 0
}


# Search for command
# Look for a specific function to act as a command.
# Search order:
# -rsd::<command>::<command>
# -rsd::<command>
# -main
function rsd::search_command() {
	rsd::arguments_or_usage 1 "$@"
	local command=$1
	local real_command

	for real_command in 	rsd::c::$command::$command \
				rsd::c::$command::command \
				rsd::c::$command \
				rsd::$command \
				$command \
				main
	do
		if bash::is_function "$real_command"; then
			echo "$real_command"
			return 0
		fi
	done
	return 1
}


# Command or Action execution
function rsd::command() {
	rsd::arguments_or_usage 1 $@
	local command=$1
	local real_command

    # Try a command function first
    # You cannot have a command function and actions, either have actions or have command.
	if real_command=$(rsd::search_command "$command"); then
		rsd::debug "Calling $real_command with arguments: ${RSD_ARGS_UNPROCESSED[*]}" 5
		$real_command "${RSD_ARGS_UNPROCESSED[@]}"
		exit 0
	else
	    # Try action
	    # FIXME: FIX parse argues for commands

        rsd::parse_args "RSD_C_${command^^}_ARGS_PARAM" RSD_COMMAND_ARGS RSD_ARGS_UNPROCESSED "${RSD_ARGS_UNPROCESSED[@]}"
        if [[ -n ${RSD_COMMAND_ARGS[command]} ]]; then
            rsd::debug2 20 "Calling generic_action $command ${RSD_COMMAND_ARGS[command]}"
            rsd::generic_action "$command" "${RSD_COMMAND_ARGS[command]}"
        else
            rsd::debug2 5 "Did not find a command or action for $command"
            rsd::usage
        fi
    fi
	return
}

# Pass a command to the shell
function rsd::passthru() {
    local command=$1
    shift
    local arguments=$*
    exec "$command" "$arguments"
    exit 0
}

# call a generic action in command
# pass the subargs in the RSD_ARGS hash
# Arguments:
#   $1 - command
#   $2 - action
function rsd::generic_action() {
	rsd::arguments_or_usage 2 "$@"
	local command=$1
	local action=$2
	local action_function

	for action_function in 	rsd::c::${command}::${action} \
				rsd::c::${command}::${action} \
				rsd::${action} ${command}::${action}
	do
	    rsd::debug2 30 "Checking for action $action_function"
		if bash::is_function "$action_function"; then
			rsd::debug "function for action $RSD_ACTION is $action_function" 8
			if $action_function "${RSD_ARGS_UNPROCESSED[@]}"; then
                exit 0
            else
                exit 10
            fi
		fi
	done

	echo "Action $action for command $command does not exist."
	rsd::usage
}

function rsd::list_all_commands() {
	local command
	local command_dir
	declare -A command_list

	for command_dir in $(rsd::get_all_libdir_file command)
	do
		for command in "$command_dir"/*
		do
		    if [[ -f "$command" ]]; then
                command_list[$(basename "$command")]=1
            fi
		done
	done

	for command in "${!command_list[@]}"
	do
		echo $command
	done
	return 0
}

function rsd::list_all_actions() {
	rsd::arguments_or_usage 1 "$@"
	rsd::list_all_actions_bare 1 $1
	return $?
}

# list all actions (rsd::<command>::<action>)
# 1st argument:
# 0 - No help
# 1 - With help
function rsd::list_all_actions_bare() {
	rsd::arguments_or_usage 2 "$@"
	local mode=$1
	local command=$2
	local sub help i real_sub

    local count=0
	for sub in $(rsd::list_functions "rsd::c::$command::"); do
	    ((count++))
		rsd::debug "action function is $sub" 8
		real_sub=$sub

		echo -e -n "\t\t$sub "
		if ((mode)); then
			help="rsd::${command}::help::${real_sub}"
			rsd::debug "help function is $help" 8
			if bash::is_function "$help"; then
				rsd::debug "Calling help function for $help" 7
				$help
				continue
			else
				echo
			fi
		else
			echo
		fi
	done
	if ((count == 0)); then
        return 1
    fi
    return 0
}

# list all function by prefix
# prefix is stripped
function rsd::list_functions() {
	rsd::arguments_or_usage 1 "$@"
	local prefix=$1
	local func
	local IFS=$'\n'

	for func in $(declare -F); do
		func=${func#declare -f }
		[[ "$func" =~ ^$prefix ]] || continue
		func=${func#$prefix}
		echo "$func"
	done
}

# list all RSD options
function rsd::list_all_options() {
	local option

	for option in "${!RSD_ARGS_PARAM[@]}"
	do
		if [[ "${#option}" == "1" ]]
		then
			echo "-$option"
		else
			echo "--$option"
		fi
	done
	return 0
}

# list all command options
function rsd::list_command_options() {
	rsd::arguments_or_usage 1 "$@"
	local command=$1
	local options="RSD_COMMAND_${command^^}_ARGS_PARAM"
	local option _option

	if [[ -z ${!options} ]]; then
		declare -n _option=$options
		for option in "${!_option[@]}"
		do
			if [[ "${#option}" == "1" ]]
			then
				echo "-$option"
			else
				echo "--$option"
			fi
		done
	fi
	return 0
}

# FIXME: Remove level
# Checks for a library in the search path
# Returns the string to source it
# Or a warning to STDERR (depending on the DEBUG level)
# An optional argument to the message level can be issued.
function rsd::source_lib() {
	local file=$1
	local level=${2:-0}

	if rsd::check_libdir_file "$file"; then
		echo source "$(rsd::get_libdir_file "$file")"
	else
		echo rsd::warn "Cannot load library $file!"
		return 1
	fi

	return 0
}

# Same as rsd::source_lib, but aborts if the library is not found
function rsd::source_lib_or_die() {
    rsd::debug2 21 "Sourcing $1"
    if ! RSD_LIBRARY_LOAD=$(rsd::source_lib "$1"); then
        rsd::warn "Coulg not load library $1!"
        exit 5
    else
        echo $RSD_LIBRARY_LOAD
    fi
}

#--------------------------------------------------
# Functions that are on rsd too
#--------------------------------------------------
# Checks if a version is greater than another
# Arguments:
#   $1 - The version to compare
#   $2 - The version to compare to
# Returns:
#   0 - if the first version is greater than the second
#   1 - if the first version is less than the second
function rsd::version_gt() {
	test "$(printf '%s\n' "$@" | sort -V | head -n 1)" != "$1";
}

# Debug to STDOUT
# Arguments:
#   $1 - The message to be displayed
#   $2 - The debug level (default 1)
function rsd::debug() {
	local msg=$1
	shift
	local level=1

	if (($#>0));then
		level=$1
	fi
	if (( RSD_DEBUG >= level )); then
		echo "$level: $msg" >&2
	fi
}

# Same as rsd::debug, but the level comes first, for convenience
# Arguments:
#   $1 - The debug level
#   $* - The message(s) to be displayed
function rsd::debug2() {
	local level=$1
	shift

	if (( RSD_DEBUG >= level )); then
		echo "$level:" "$@" >&2
	fi
}

# outputs a warning message to the STDERR
# Arguments:
#   $1 - The message to be displayed
function rsd::warn() {
    echo "$*" >&2
}


# Finds a bin file in the path
# Arguments:
#   $1 - The file to be found
function rsd::check_binary() {
	local file=$1
	local path
	local IFS=":"

	for path in $PATH; do
		if [[ -f "$path/$file" ]]; then
		return 0
		fi
	done

	RSD_ERROR_MSG="Command $file not in PATH."
	return 1
}

# Checks a list of binaries files in the path
# Arguments:
#   $* - The list of files to be found
# Returns:
#   0 - if all files are found
#   1 - if any file is not found
function rsd::check_binaries() {
	local file
	local path
	local IFS=":"

	for file in "$@";  do
		if ! rsd::check_binary "$file"; then
		return 1
		fi
	done
	return 0
}

# Checks a list of binaries files in the path or aborts
# Usefull if there is no point into continue in the absence of a binary
# Arguments:
#   $* - The list of files to be found
function rsd::check_binaries_or_fail() {
	if ! rsd::check_binaries "$@"; then
		rsd::warn "$RSD_ERROR_MSG"
		exit 3
	fi
	return 0
}

# check the latest version in the repository
# Requires:
#  wget, grep, head
# Returns:
#  0 - if the local version is the same or newer
#  1 - if the local version is older
function rsd::check_repository_version() {
	local repo_version
	rsd::check_binaries_or_fail wget grep head

	repo_version=$(wget -q -O - "$RSD_LATEST_RSD_REPO" | grep ^RSD_VERSION= \
			| head -n 1 | sed -e "s/.*=['\"]\(.*\)['\"]/\1/")

	if rsd::version_gt "$repo_version" "$RSD_VERSION"; then
		RSD_ERROR_MSG="There is a newer version in the repository: $repo_version.  Our version: $RSD_VERSION."
		return 1
	elif [[ $repo_version == "$RSD_VERSION" ]]; then
		RSD_ERROR_MSG="You are using the latest version: $RSD_VERSION."
	else
		RSD_ERROR_MSG="Your version: $RSD_VERSION is newer that the one in the repository: $repo_version."
	fi

	return 0
}

# Search all LIBDIRs for a file and return it on STDOUT
# Returns the first match
# Search order:
# - Each command line argument,
# - Each config option (TODO),
# - Current path,
# - rsd installation dir (if it is a symlink),
# - bash source base,
# - in user's home (TODO) and
# - system wide install (TODO)
# Requires:
#  pwd
# Arguments:
#   $1 - The file to be found
#   $2 - If 1, print the file found
# Returns:
#  0 - if the file is found
#  1 - if the file is not found
function rsd::get_libdir_file() {
	rsd::check_binaries_or_fail pwd
	local file=$1
	local print=${2:-1}
	local libdir

	#check cache first
	# make sure cache exists
	if [[ -v RSD_LIB_CACHE[@] ]]; then
		if [[ -n "${RSD_LIB_CACHE[$file]}" ]]; then
			if ((print)); then
				echo "${RSD_LIB_CACHE[$file]}"
			fi
			return 0
		fi
	fi

	for libdir in "${RSD_LIBRARY_SEARCH_PATH[@]}"; do
		if [[ -e "$libdir/$file" ]]; then
			if ((print)); then
				echo "$libdir/$file"
			fi
			return 0
		fi
	done
	return 1
}

# Same as rsd::get_libdir_file, but returns all occurrences
function rsd::get_all_libdir_file() {
	rsd::check_binaries_or_fail pwd
	local file=$1
	local libdir

	for libdir in "${RSD_LIBRARY_SEARCH_PATH[@]}"; do
		if [[ -e "$libdir/$file" ]]; then
			echo "$libdir/$file"
		fi
	done
	return 0
}

# just check if a file exists in LIBDIR
# Arguments:
#   $1 - The file to be found
# Returns:
#  0 - if the file is found
#  1 - if the file is not found
function rsd::check_libdir_file() {
	rsd::get_libdir_file "$1" 0
	return $?
}

#-----------------------------------------------------
# End of shared functions
#-----------------------------------------------------

# Explicit check when cannot continue without sourcing
if RSD_LIBRARY_LOAD=$(rsd::source_lib lib/bash_extensions.lib); then
	$RSD_LIBRARY_LOAD
else
	$RSD_LIBRARY_LOAD
	exit 5
fi

# Let it get away with a warning
$(rsd::source_lib lib/config.lib)

# run again to add the config paths
rsd::create_search_path

# Run again to add the config paths from config
$(rsd::source_lib lib/config.lib)

RSD_LIB=1