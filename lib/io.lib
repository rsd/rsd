#!/usr/bin/env bash

# Structured IO messaging library for RSD.
# Provides semantic, colorized, origin-tagged output functions.
#
# namespace rsd::io::   (public API)
# namespace rsd::l::io:: (internal helpers)
#
# Dependencies: bash_extensions.lib (already loaded by rsd.lib)
# Load order: after rsd.lib + bash_extensions.lib, before command dispatch.
#
# @see AGENTS.md

if [[ ! -v RSD_ON || $RSD_ON -ne 1 ]]; then
    echo "This is a RSD library file. It should not be executed directly."
    echo "Please call 'rsd' to use it."
    exit 12
fi

[[ "$RSD_IO_LIB" == "1" ]] && return 0 2>/dev/null

RSD_IO_VERSION='0.1.0'

# ---------------------------------------------------------------------------
# Terminal Capability Detection
# Layered: NO_COLOR → TERM=dumb → tput(terminfo) → stderr TTY fallback
# ---------------------------------------------------------------------------

declare -g RSD_IO_COLOR=0

if [[ -v NO_COLOR ]]; then
    RSD_IO_COLOR=0
elif [[ "${TERM:-dumb}" == "dumb" ]]; then
    RSD_IO_COLOR=0
elif command -v tput &>/dev/null; then
    [[ $(tput colors 2>/dev/null) -ge 8 ]] && RSD_IO_COLOR=1
elif [[ -t 2 && -n "$TERM" ]]; then
    RSD_IO_COLOR=1
fi

# ---------------------------------------------------------------------------
# ANSI Color Code Registry
# Standard 8-color palette — works on every terminal that reports colors >= 8
# ---------------------------------------------------------------------------

declare -g _RSD_C_RESET=""
declare -g _RSD_C_DIM=""
declare -g _RSD_C_BOLD=""
declare -g _RSD_C_RED=""
declare -g _RSD_C_GREEN=""
declare -g _RSD_C_YELLOW=""
declare -g _RSD_C_CYAN=""
declare -g _RSD_C_WHITE=""
declare -g _RSD_C_BOLD_RED=""
declare -g _RSD_C_BOLD_CYAN=""
declare -g _RSD_C_BOLD_WHITE=""
declare -g _RSD_C_DIM_CYAN=""

if [[ "$RSD_IO_COLOR" -eq 1 ]]; then
    _RSD_C_RESET=$'\033[0m'
    _RSD_C_DIM=$'\033[2m'
    _RSD_C_BOLD=$'\033[1m'
    _RSD_C_RED=$'\033[31m'
    _RSD_C_GREEN=$'\033[32m'
    _RSD_C_YELLOW=$'\033[33m'
    _RSD_C_CYAN=$'\033[36m'
    _RSD_C_WHITE=$'\033[37m'
    _RSD_C_BOLD_RED=$'\033[1;31m'
    _RSD_C_BOLD_CYAN=$'\033[1;36m'
    _RSD_C_BOLD_WHITE=$'\033[1;37m'
    _RSD_C_DIM_CYAN=$'\033[2;36m'
fi

# ---------------------------------------------------------------------------
# fd 7 — Dedicated RSD output channel
# rsd::io::* functions write to fd 7 (direct stderr copy).
# External command output goes through stdout/stderr and can be piped
# through rsd::l::io::frame_lines without double-prefixing rsd messages.
#
# WHY fd 7?
# fd 3 is used by BATS-core for TAP stream, fd 4-5 by various test harnesses.
# fd 7 is high enough to avoid framework collisions while staying within
# the POSIX single-digit range for shell redirection portability.
# ---------------------------------------------------------------------------

# Unconditionally dup stderr → fd 7.
# Parent processes (IDE terminals, SSH) may leave low fds pointing at unrelated
# resources (e.g., a read-only data file), so existence checks are unreliable.
# RSD owns fd 7 as its messaging channel.
exec 7>&2

# ---------------------------------------------------------------------------
# Origin Tag Computation
# Format: [rsd] (local), [rsd@host] (remote), [rsd@gw→host] (multi-hop)
# ---------------------------------------------------------------------------

declare -g RSD_IO_TAG=""

# Build the origin tag from environment context.
# Called once at load time and can be re-invoked if RSD_REMOTE_TARGET changes.
#
# @return void — sets RSD_IO_TAG global
function rsd::l::io::compute_tag() {
    local origin="${RSD_IO_ORIGIN:-}"
    local self=""

    # Determine the local identity
    if [[ -n "${RSD_REMOTE_TARGET:-}" ]]; then
        # Strip the @ prefix and any user@ portion for display
        self="${RSD_REMOTE_TARGET#@}"
        self="${self##*@}"
    fi

    if [[ -n "$origin" && -n "$self" ]]; then
        # Multi-hop: parent origin → current self
        RSD_IO_TAG="[${origin}→${self}]"
    elif [[ -n "$self" ]]; then
        # Single remote hop
        RSD_IO_TAG="[rsd@${self}]"
    else
        # Local execution
        RSD_IO_TAG="[rsd]"
    fi
}

rsd::l::io::compute_tag

# ---------------------------------------------------------------------------
# Core Emitter
# All semantic functions route through this. Writes to fd 7.
# ---------------------------------------------------------------------------

# Emit a formatted message to fd 7 (stderr bypass).
# Intent: Single output pathway for all RSD-originated messages.
#
# @param string $1 Color code (pre-computed ANSI escape, or empty)
# @param string $2 Prefix symbol (e.g., "▸", "✓", "✗", "⚠")
# @param string $* Message text
# @return void
function rsd::l::io::emit() {
    local color="$1"
    local symbol="$2"
    shift 2
    local msg="$*"

    local tag_display=""
    if [[ "$RSD_IO_COLOR" -eq 1 ]]; then
        tag_display="${_RSD_C_BOLD}${RSD_IO_TAG}${_RSD_C_RESET}"
    else
        tag_display="${RSD_IO_TAG}"
    fi

    local pad=""
    # Pad after tag for alignment (secondary tag column)
    local tag_len=${#RSD_IO_TAG}
    local target_width=14
    if [[ $tag_len -lt $target_width ]]; then
        printf -v pad '%*s' $(( target_width - tag_len )) ''
    fi

    if [[ -n "$symbol" ]]; then
        printf '%s%s %s%s%s%s\n' \
            "$tag_display" "$pad" \
            "$color" "$symbol " "$msg" "$_RSD_C_RESET" >&7
    else
        printf '%s%s %s%s%s\n' \
            "$tag_display" "$pad" \
            "$color" "$msg" "$_RSD_C_RESET" >&7
    fi
}

# ---------------------------------------------------------------------------
# Semantic Message Functions
# ---------------------------------------------------------------------------

# Informational message — background context, low visual weight.
# @param string $* Message text
# @return void
function rsd::io::info() {
    rsd::l::io::emit "$_RSD_C_DIM" "▸" "$@"
}

# Progress/status message — active operations in progress.
# @param string $* Message text
# @return void
function rsd::io::status() {
    rsd::l::io::emit "$_RSD_C_CYAN" "▸" "$@"
}

# Success confirmation — operation completed without error.
# @param string $* Message text
# @return void
function rsd::io::ok() {
    rsd::l::io::emit "$_RSD_C_GREEN" "✓" "$@"
}

# Non-fatal warning — attention needed but execution continues.
# @param string $* Message text
# @return void
function rsd::io::warn() {
    rsd::l::io::emit "$_RSD_C_YELLOW" "⚠" "$@"
}

# Error — operation failed, may affect subsequent steps.
# @param string $* Message text
# @return void
function rsd::io::error() {
    rsd::l::io::emit "$_RSD_C_RED" "✗" "$@"
}

# Critical/fatal — unrecoverable failure, execution will likely abort.
# @param string $* Message text
# @return void
function rsd::io::fatal() {
    rsd::l::io::emit "$_RSD_C_BOLD_RED" "✗✗" "$@"
}

# ---------------------------------------------------------------------------
# Structural Helpers
# ---------------------------------------------------------------------------

# Numbered step indicator for multi-step operations.
# @param string $1 Step counter (e.g., "1/5")
# @param string $* Step description
# @return void
function rsd::io::step() {
    local counter="$1"
    shift
    rsd::l::io::emit "$_RSD_C_BOLD_CYAN" "[${counter}]" "$@"
}

# Box-drawn title banner for section headers.
# @param string $* Banner text
# @return void
function rsd::io::banner() {
    local text="$*"
    local text_len=${#text}
    local box_width=$(( text_len + 4 ))
    local horiz
    printf -v horiz '%*s' "$box_width" ''
    horiz="${horiz// /─}"

    local tag_display=""
    local pad=""
    if [[ "$RSD_IO_COLOR" -eq 1 ]]; then
        tag_display="${_RSD_C_BOLD}${RSD_IO_TAG}${_RSD_C_RESET}"
    else
        tag_display="${RSD_IO_TAG}"
    fi
    local tag_len=${#RSD_IO_TAG}
    local target_width=14
    if [[ $tag_len -lt $target_width ]]; then
        printf -v pad '%*s' $(( target_width - tag_len )) ''
    fi

    local color="${_RSD_C_BOLD_WHITE}"
    printf '%s%s %s┌%s┐%s\n' "$tag_display" "$pad" "$color" "$horiz" "$_RSD_C_RESET" >&7
    printf '%s%s %s│  %s  │%s\n' "$tag_display" "$pad" "$color" "$text" "$_RSD_C_RESET" >&7
    printf '%s%s %s└%s┘%s\n' "$tag_display" "$pad" "$color" "$horiz" "$_RSD_C_RESET" >&7
}

# Empty line — replaces embedded \n hacks in rsd::warn calls.
# @return void
function rsd::io::blank() {
    printf '\n' >&7
}

# Horizontal rule separator.
# @return void
function rsd::io::rule() {
    local tag_display=""
    local pad=""
    if [[ "$RSD_IO_COLOR" -eq 1 ]]; then
        tag_display="${_RSD_C_BOLD}${RSD_IO_TAG}${_RSD_C_RESET}"
    else
        tag_display="${RSD_IO_TAG}"
    fi
    local tag_len=${#RSD_IO_TAG}
    local target_width=14
    if [[ $tag_len -lt $target_width ]]; then
        printf -v pad '%*s' $(( target_width - tag_len )) ''
    fi
    printf '%s%s %s%s%s\n' "$tag_display" "$pad" "$_RSD_C_DIM" "────────────────────────────────────────" "$_RSD_C_RESET" >&7
}

# ---------------------------------------------------------------------------
# External Output Framing
# Reads from stdin, prefixes each line with [cmd] tag and dim pipe character.
# Used via process substitution: cmd > >(rsd::l::io::frame_lines)
# ---------------------------------------------------------------------------

# Global: set by the recipe engine before task execution
declare -g RSD_IO_FRAME_CMD=""

# Frame external command output lines with origin tag and [cmd] secondary tag.
# Reads from stdin, writes to fd 7.
#
# @return void
function rsd::l::io::frame_lines() {
    local line
    local cmd_tag=""
    local tag_display=""
    local pad=""

    if [[ "$RSD_IO_COLOR" -eq 1 ]]; then
        tag_display="${_RSD_C_BOLD}${RSD_IO_TAG}${_RSD_C_RESET}"
    else
        tag_display="${RSD_IO_TAG}"
    fi

    local tag_len=${#RSD_IO_TAG}
    local target_width=14
    if [[ $tag_len -lt $target_width ]]; then
        printf -v pad '%*s' $(( target_width - tag_len )) ''
    fi

    if [[ -n "$RSD_IO_FRAME_CMD" ]]; then
        if [[ "$RSD_IO_COLOR" -eq 1 ]]; then
            cmd_tag=" ${_RSD_C_DIM_CYAN}[${RSD_IO_FRAME_CMD}]${_RSD_C_RESET}"
        else
            cmd_tag=" [${RSD_IO_FRAME_CMD}]"
        fi
    fi

    local _prev_filtered=0
    local _prev_empty=0
    while IFS= read -r line || [[ -n "$line" ]]; do
        # Filter SSH transport noise — OpenSSH prints these on every
        # connection close, producing useless output in recipe runs.
        if [[ "$line" == "Connection to "* && "$line" == *" closed." ]]; then
            _prev_filtered=1
            continue
        fi
        # Skip empty lines immediately following filtered SSH noise
        if [[ -z "$line" && $_prev_filtered -eq 1 ]]; then
            continue
        fi
        _prev_filtered=0

        # Suppress consecutive empty lines (SSH PTY artifacts)
        if [[ -z "$line" ]]; then
            if [[ $_prev_empty -eq 1 ]]; then
                continue
            fi
            _prev_empty=1
        else
            _prev_empty=0
        fi

        printf '%s%s%s %s│%s %s\n' \
            "$tag_display" "$pad" "$cmd_tag" \
            "$_RSD_C_DIM" "$_RSD_C_RESET" \
            "$line" >&7
    done
}

# ---------------------------------------------------------------------------

# ==============================================================================
# Interactive Prompts (TTY-Safe)
# ==============================================================================
# These functions write prompts directly to /dev/tty, bypassing the recipe
# engine's process substitution framing. The framing buffers prompts that
# lack trailing newlines, making them invisible to the user.

# Read a secret value (password, API key) from the terminal.
# Disables echo (-s) and reads from /dev/tty directly.
#
# @param string  $1 Prompt text (displayed before ": ").
# @param string& $2 nameref: output variable for the secret.
# @return int 0 on success, 1 if empty.
function rsd::io::read_secret() {
    local prompt="$1"
    declare -n __secret_out="$2"

    printf "[rsd]          ▸ %s: " "$prompt" > /dev/tty
    read -r -s __secret_out < /dev/tty
    echo "" > /dev/tty

    if [[ -z "$__secret_out" ]]; then
        rsd::io::error "Value cannot be empty."
        return 1
    fi
}

# Read and confirm a secret value from the terminal.
# Prompts twice (input + confirm) and validates match.
#
# @param string  $1 Prompt text (displayed before ": ").
# @param string& $2 nameref: output variable for the confirmed secret.
# @return int 0 on success, 1 on mismatch or empty.
function rsd::io::read_secret_confirm() {
    local prompt="$1"
    declare -n __secret_confirm_out="$2"

    local pw1="" pw2=""

    printf "[rsd]          ▸ %s: " "$prompt" > /dev/tty
    read -r -s pw1 < /dev/tty
    echo "" > /dev/tty

    printf "[rsd]          ▸ Confirm %s: " "$prompt" > /dev/tty
    read -r -s pw2 < /dev/tty
    echo "" > /dev/tty

    if [[ "$pw1" != "$pw2" ]]; then
        rsd::io::error "Values do not match."
        return 1
    fi
    if [[ -z "$pw1" ]]; then
        rsd::io::error "Value cannot be empty."
        return 1
    fi

    __secret_confirm_out="$pw1"
}

# ==============================================================================
# File Size Formatting
# ==============================================================================

# Print a human-readable file size for a local path.
# Falls back to "unknown" if the file is missing or tools unavailable.
#
# @param string $1 File path.
# @stdout Human-readable size (e.g., "1.7GiB") or "unknown".
function rsd::io::filesize() {
    local path="$1"
    local bytes
    bytes=$(stat -c%s "$path" 2>/dev/null) || { echo "unknown"; return; }
    numfmt --to=iec-i --suffix=B "$bytes" 2>/dev/null || echo "${bytes} bytes"
}

# ---------------------------------------------------------------------------

RSD_IO_LIB=1
