#!/usr/bin/env bash

# Declarative recipe provisioning engine.
# namespace rsd::r::
# namespace rsd::l::r::

# @see docs/recipes.md
# @see AGENTS.md

if [[ ! -v RSD_ON || $RSD_ON -ne 1 ]]; then
    echo "This is a RSD library file. It should not be executed directly."
    echo "Please call 'rsd' to use it."
    exit 12
fi

if [[ "$RSD_RECIPE_LIB" == "1" ]]; then
    return 0
fi
RSD_RECIPE_LIB=1
RSD_RECIPE_LIB_VERSION="0.4.0"

# Load target-aware dispatch primitives
[[ "$RSD_TARGET_LIB" != "1" ]] && source "$(rsd::get_libdir_file lib/target.lib)"

# Load structured IO messaging
[[ "$RSD_IO_LIB" != "1" ]] && source "$(rsd::get_libdir_file lib/io.lib)"

# Scoped task definitions — only task names and recovery mode are stored.
# All other hooks (pre_check, rollback) are discovered at dispatch time
# via bash::is_function probing on convention-based function names.
declare -g -a RSD_REGISTERED_TASKS=()
declare -g -A RSD_TASKS_RECOVERY=()
declare -g -A RSD_INCLUDED_RECIPES=()

# Session stack tracking completed tasks
declare -g -a RSD_COMPLETED_STACK=()

# Register a convention-based recipe task.
# The task name maps directly to a function: rsd::r::<task_name>
# Optional hooks are discovered by probing: rsd::r::<task_name>::pre_check,
# rsd::r::<task_name>::rollback, etc.
#
# @param string $1 Task identifier (mandatory). Must match a declared function rsd::r::<name>.
# @param string $2 Recovery mode: 'forward' (default), 'rollback', 'ignore'.
# @return 0 on success
# @return 11 on missing apply function or rollback mismatch
function rsd::r::register_task() {
    local task_name="$1"
    local recovery="${2:-forward}"
    local func="rsd::r::${task_name}"

    # The task name IS the apply function — it must exist
    if ! bash::is_function "$func"; then
        rsd::io::error "Task function '${func}' is not declared."
        return 11
    fi

    # Validate rollback function exists when recovery=rollback
    if [[ "$recovery" == "rollback" ]] && ! bash::is_function "${func}::rollback"; then
        rsd::io::error "Task '${task_name}' has recovery='rollback' but no ::rollback function."
        return 11
    fi

    RSD_REGISTERED_TASKS+=("$task_name")
    RSD_TASKS_RECOVERY["$task_name"]="$recovery"
    return 0
}

# Compile and include a sub-recipe dynamically into the active task stack
#
# @param string $1 Sub-recipe file path (e.g. 'zsh/core')
# @return 0 on success
# @return 5 on file not resolved
# @return 11 on missing registration hook
function rsd::r::include() {
    rsd::arguments_or_usage 1 "$@"
    local name="$1"

    # Reset included registry if starting a completely fresh task stack compilation
    if [[ ${#RSD_REGISTERED_TASKS[@]} -eq 0 ]]; then
        RSD_INCLUDED_RECIPES=()
    fi

    # Normalize name to get a valid function identifier (slash becomes underscore)
    local clean_name="${name//\//_}"

    # Double-inclusion guard prevents duplicate task registration
    if [[ "${RSD_INCLUDED_RECIPES["$clean_name"]}" == "1" ]]; then
        return 0
    fi
    RSD_INCLUDED_RECIPES["$clean_name"]=1

    if ! rsd::check_libdir_file "lib/recipe/${name}.recipe"; then
        rsd::io::error "Sub-recipe file '${name}' could not be resolved."
        exit 5
    fi

    # Source the sub-recipe file dynamically
    source "$(rsd::get_libdir_file "lib/recipe/${name}.recipe")"

    # Re-parse leftover arguments if the recipe declared custom options.
    # This must happen AFTER sourcing (which declares RSD_RECIPE_OPTIONS)
    # and BEFORE calling register() (which reads RSD_COMMAND_ARGS).
    if declare -p RSD_RECIPE_OPTIONS &>/dev/null && [[ ${#RSD_RECIPE_OPTIONS[@]} -gt 0 ]] \
       && [[ ${#RSD_ARGS_UNPROCESSED[@]} -gt 0 ]]; then
        local -A _recipe_parsed=()
        local -a _recipe_remaining=()

        rsd::parse_args "RSD_RECIPE_OPTIONS" _recipe_parsed _recipe_remaining \
            "${RSD_ARGS_UNPROCESSED[@]}"

        local _key
        for _key in "${!_recipe_parsed[@]}"; do
            RSD_COMMAND_ARGS["$_key"]="${_recipe_parsed[$_key]}"
        done
        RSD_ARGS_UNPROCESSED=("${_recipe_remaining[@]}")
    fi

    # Invoke the registration hook
    local reg_func="rsd::r::${clean_name}::register"
    if bash::is_function "$reg_func"; then
        "$reg_func"
    else
        rsd::io::error "Recipe registration hook '${reg_func}' is missing."
        exit 11
    fi
    return 0
}

# Executes the compiled flat task stack via direct function dispatch.
# No eval — all hooks are called as native Bash functions.
#
# @param int $1 dry_run (0 or 1, default 0)
# @param int $2 verbose (0 or 1, default 0)
# @return 0 on success
# @return 10 on task execution failure
function rsd::l::r::execute_engine() {
    local dry_run="${1:-0}"
    local verbose="${2:-0}"

    RSD_COMPLETED_STACK=()
    local name func recovery

    for name in "${RSD_REGISTERED_TASKS[@]}"; do
        func="rsd::r::${name}"
        recovery="${RSD_TASKS_RECOVERY["$name"]}"

        # 1. Pre-flight Necessity Guard
        if bash::is_function "${func}::pre_check"; then
            if ((verbose)); then
                rsd::io::info "Checking task '$name'..."
            fi
            if "${func}::pre_check" &>/dev/null; then
                rsd::io::info "Task '$name' is already satisfied. Skipping."
                continue
            fi
        fi

        # 2. Dry-Run Isolation Check
        if ((dry_run)); then
            rsd::io::status "[DRY-RUN] Would apply task '$name'"
            continue
        fi

        # 3. Execution Phase — call the task function directly
        rsd::io::status "Executing task '$name'..."

        # fd 3 framing: external command output gets [cmd] tag + dim pipe
        RSD_IO_FRAME_CMD="${name##*::}"
        if ! "$func" > >(rsd::l::io::frame_lines) 2> >(rsd::l::io::frame_lines >&2); then
            if [[ "$recovery" == "ignore" ]]; then
                rsd::io::warn "Task '$name' failed. Skipping optional step."
                continue
            else
                rsd::l::r::handle_failure "$name" "$recovery"
                return 10
            fi
        fi

        # 4. Registry Success Track
        RSD_IO_FRAME_CMD=""
        # Small delay to flush asynchronous process substitution buffers
        sleep 0.05

        RSD_COMPLETED_STACK+=("$name")
        rsd::io::ok "Task '$name' applied successfully."
    done

    rsd::io::blank
    rsd::io::ok "Recipe execution completed successfully."
    return 0
}

# Coordinate state-specific failure recovery
#
# @param string $1 Failed task name
# @param string $2 Recovery mode ('forward', 'rollback')
function rsd::l::r::handle_failure() {
    local name="$1"
    local recovery="$2"

    rsd::io::blank
    rsd::io::fatal "Recipe failed at step: '$name'"

    if [[ "$recovery" == "rollback" ]]; then
        rsd::io::status "Initiating Backward Recovery (Rollback)..."
        local i completed rollback_func
        for (( i=${#RSD_COMPLETED_STACK[@]}-1; i>=0; i-- )); do
            completed="${RSD_COMPLETED_STACK[i]}"
            rollback_func="rsd::r::${completed}::rollback"
            if bash::is_function "$rollback_func"; then
                rsd::io::warn "Undoing changes for task '$completed'..."
                RSD_IO_FRAME_CMD="${completed##*::}"
                if ! "$rollback_func" > >(rsd::l::io::frame_lines) 2> >(rsd::l::io::frame_lines >&2); then
                    rsd::io::fatal "Rollback failed for task '$completed'! Manual cleanup required."
                fi
                RSD_IO_FRAME_CMD=""
                sleep 0.05
            fi
        done
        exit 10
    else
        rsd::io::status "Recovery Mode: FORWARD."
        rsd::io::info "Please resolve the environmental issue, then run the recipe again."
        rsd::io::info "Already satisfied steps will be automatically skipped."
        exit 10
    fi
}

# ==============================================================================
# Recipe-Specific Helpers
# ==============================================================================
# Intent: Helpers that are inherently tied to the recipe provisioning subsystem.
#         System-wide target-aware primitives live in lib/target.lib.

# Install a package via the RSD install subsystem.
# Intent: Sources `command/install` lazily and delegates to the native
#         local/remote routing already built into `rsd::c::install::command`.
#
# @param string $1 The package name.
# @return int Exit code of the install subsystem.
function rsd::l::r::install_pkg() {
    local package="$1"
    source "$(rsd::get_libdir_file command/install)"
    rsd::c::install::command "$package"
}

# Finds all *.recipe files recursively under a base directory.
# This function is pure-Bash and does not call external binaries like find.
#
# @param string $1 The absolute base directory path.
# @param string $2 The current subfolder relative path (empty for root).
# @return stdout Relative paths of found recipes (without .recipe extension).
function rsd::l::r::find_recursive() {
    local base_dir="$1"
    local sub_dir="$2"
    local path="${base_dir}/${sub_dir}"
    local item

    [[ ! -d "$path" ]] && return 0

    for item in "$path"/*; do
        [[ ! -e "$item" ]] && continue
        if [[ -d "$item" ]]; then
            local next_sub
            if [[ -z "$sub_dir" ]]; then
                next_sub="$(basename "$item")"
            else
                next_sub="${sub_dir}/$(basename "$item")"
            fi
            rsd::l::r::find_recursive "$base_dir" "$next_sub"
        elif [[ -f "$item" && "$item" == *.recipe ]]; then
            local relative_file="${item#$base_dir/}"
            echo "${relative_file%.recipe}"
        fi
    done
}
