#!/usr/bin/env bash

# Declarative recipe provisioning engine.
# namespace rsd::recipe::
# namespace rsd::l::recipe::

# @see docs/recipes.md
# @see AGENTS.md

if [[ ! -v RSD_ON || $RSD_ON -ne 1 ]]; then
    echo "This is a RSD library file. It should not be executed directly."
    echo "Please call 'rsd' to use it."
    exit 12
fi

if [[ "$RSD_RECIPE_LIB" == "1" ]]; then
    return 0
fi
RSD_RECIPE_LIB=1
RSD_RECIPE_LIB_VERSION="0.3.0"

# Load target-aware dispatch primitives
[[ "$RSD_TARGET_LIB" != "1" ]] && source "$(rsd::get_libdir_file lib/target.lib)"

# Scoped task definitions
declare -g -a RSD_REGISTERED_TASKS=()
declare -g -A RSD_TASKS_PRE
declare -g -A RSD_TASKS_APPLY
declare -g -A RSD_TASKS_POST
declare -g -A RSD_TASKS_RECOVERY
declare -g -A RSD_TASKS_ROLLBACK
declare -g -A RSD_INCLUDED_RECIPES=()

# Session stack tracking completed tasks
declare -g -a RSD_COMPLETED_STACK=()

# Register a declarative recipe task
# Arguments:
#   --name) Task identifier (mandatory)
#   --pre-check) State detection function/command
#   --apply) Execution payload (mandatory)
#   --post-check) State verification function/command
#   --recovery) Fault handling mode ('forward', 'rollback', 'ignore')
#   --rollback) Rollback execution payload (required if recovery is 'rollback')
# Returns:
#   0 - Success
#   11 - Mandatory parameter missing
function rsd::recipe::register_task() {
    local name="" pre="" apply="" post="" recovery="forward" rollback=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --name) name="$2"; shift ;;
            --pre-check) pre="$2"; shift ;;
            --apply) apply="$2"; shift ;;
            --post-check) post="$2"; shift ;;
            --recovery) recovery="$2"; shift ;;
            --rollback) rollback="$2"; shift ;;
        esac
        shift
    done

    if [[ -z "$name" || -z "$apply" ]]; then
        rsd::warn "Error: Task registration requires --name and --apply parameters."
        return 11
    fi

    RSD_REGISTERED_TASKS+=("$name")
    RSD_TASKS_PRE["$name"]="$pre"
    RSD_TASKS_APPLY["$name"]="$apply"
    RSD_TASKS_POST["$name"]="$post"
    RSD_TASKS_RECOVERY["$name"]="$recovery"
    RSD_TASKS_ROLLBACK["$name"]="$rollback"
    return 0
}

# Compile and include a sub-recipe dynamically into the active task stack
# Arguments:
#   $1 - sub-recipe file basename (e.g. 'zsh_core')
# Returns:
#   0 - Success
#   5 - File not resolved
#   11 - Registration hook missing
function rsd::recipe::include_recipe() {
    rsd::arguments_or_usage 1 "$@"
    local name="$1"

    # Reset included registry if starting a completely fresh task stack compilation
    if [[ ${#RSD_REGISTERED_TASKS[@]} -eq 0 ]]; then
        RSD_INCLUDED_RECIPES=()
    fi

    # Normalize name to get a valid function identifier (slash becomes underscore)
    local clean_name="${name//\//_}"

    # Double-inclusion guard prevents duplicate task registration
    if [[ "${RSD_INCLUDED_RECIPES["$clean_name"]}" == "1" ]]; then
        return 0
    fi
    RSD_INCLUDED_RECIPES["$clean_name"]=1

    if ! rsd::check_libdir_file "lib/recipe/${name}.recipe"; then
        rsd::warn "Error: Sub-recipe file '${name}' could not be resolved."
        exit 5
    fi

    # Source the sub-recipe file dynamically
    source "$(rsd::get_libdir_file "lib/recipe/${name}.recipe")"

    # Invoke the registration hook
    local reg_func="rsd::recipe::${clean_name}::register"
    if bash::is_function "$reg_func"; then
        "$reg_func"
    else
        rsd::warn "Error: Recipe registration hook '${reg_func}' is missing."
        exit 11
    fi
    return 0
}

# Dispatches a registered hook string through eval for argument support.
# Intent: Enables hooks like "rsd::l::target::has_bin zsh" where the
#         string contains both the function name and its arguments, separated
#         by whitespace. Bare function names (legacy style) work identically.
#
# TAINT GUARD: This is defense-in-depth, not a security boundary. Recipe files
#   are trusted code loaded from $RSD_LIBRARY_SEARCH_PATH. The guard catches:
#   - Accidental shell metacharacter injection in hook strings
#   - Typos in function names (caught at dispatch time, not silently eval'd)
#   - Copy-paste errors from shell snippets into registration blocks
#
# @param string $1 The hook string stored in RSD_TASKS_* associative arrays.
# @return int Exit code of the dispatched function.
# @return 2 on taint validation failure.
function rsd::l::recipe::eval_hook() {
    local hook="$1"

    # Stage 1: Metacharacter taint rejection
    if [[ "$hook" =~ [\;\|\`] ]] || [[ "$hook" == *'$('* ]]; then
        rsd::warn "TAINT: Hook contains forbidden shell metacharacters: '$hook'"
        return 2
    fi

    # Stage 2: Function existence validation
    local func_name="${hook%% *}"
    if ! bash::is_function "$func_name"; then
        rsd::warn "TAINT: Hook function '$func_name' is not a declared function."
        return 2
    fi

    eval "$hook"
}

# Executes the compiled flat task stack
# Arguments:
#   $1 - dry_run (0 or 1, default 0)
#   $2 - verbose (0 or 1, default 0)
# Returns:
#   0 - Success
#   10 - Task execution failed
function rsd::l::recipe::execute_engine() {
    local dry_run="${1:-0}"
    local verbose="${2:-0}"
    
    RSD_COMPLETED_STACK=()
    local name pre apply post recovery rollback

    for name in "${RSD_REGISTERED_TASKS[@]}"; do
        pre="${RSD_TASKS_PRE["$name"]}"
        apply="${RSD_TASKS_APPLY["$name"]}"
        post="${RSD_TASKS_POST["$name"]}"
        recovery="${RSD_TASKS_RECOVERY["$name"]}"
        rollback="${RSD_TASKS_ROLLBACK["$name"]}"

        # 1. Pre-flight Necessity Guard
        if [[ -n "$pre" ]]; then
            if ((verbose)); then
                rsd::warn "  [CHECKING] Task '$name'..."
            fi
            if rsd::l::recipe::eval_hook "$pre" &>/dev/null; then
                rsd::warn "  [SKIPPED] Task '$name' is already satisfied."
                continue
            fi
        fi

        # 2. Dry-Run Isolation Check
        if ((dry_run)); then
            rsd::warn "  [DRY-RUN] Would apply task '$name'"
            continue
        fi

        # 3. Execution Phase
        rsd::warn "  [APPLYING] Executing task '$name'..."
        if ! rsd::l::recipe::eval_hook "$apply"; then
            if [[ "$recovery" == "ignore" ]]; then
                rsd::warn "  [WARNING] Task '$name' failed. Skipping optional step."
                continue
            else
                rsd::l::recipe::handle_failure "$name" "$recovery"
                return 10
            fi
        fi

        # 4. Post-flight Verification
        if [[ -n "$post" ]]; then
            if ((verbose)); then
                rsd::warn "  [VERIFYING] Task '$name'..."
            fi
            if ! rsd::l::recipe::eval_hook "$post" &>/dev/null; then
                if [[ "$recovery" == "ignore" ]]; then
                    rsd::warn "  [WARNING] Task '$name' verification failed. Skipping optional step."
                    continue
                else
                    rsd::warn "  [ERROR] Verification failed for task '$name'."
                    rsd::l::recipe::handle_failure "$name" "$recovery"
                    return 10
                fi
            fi
        fi

        # 5. Registry Success Track
        RSD_COMPLETED_STACK+=("$name")
        rsd::warn "  [OK] Task '$name' applied successfully."
    done

    rsd::warn "\nRecipe execution completed successfully."
    return 0
}

# Coordinate state-specific failure recovery
# Arguments:
#   $1 - failed task name
#   $2 - recovery mode ('forward', 'rollback')
function rsd::l::recipe::handle_failure() {
    local name="$1"
    local recovery="$2"

    rsd::warn "\n!!! [FAILURE] Recipe failed at step: '$name' !!!"

    if [[ "$recovery" == "rollback" ]]; then
        rsd::warn "Initiating Backward Recovery (Rollback)..."
        local i completed rollback
        for (( i=${#RSD_COMPLETED_STACK[@]}-1; i>=0; i-- )); do
            completed="${RSD_COMPLETED_STACK[i]}"
            rollback="${RSD_TASKS_ROLLBACK["$completed"]}"
            if [[ -n "$rollback" ]]; then
                rsd::warn "  [ROLLBACK] Undoing changes for task '$completed'..."
                if ! rsd::l::recipe::eval_hook "$rollback"; then
                    rsd::warn "  [CRITICAL] Rollback failed for task '$completed'! Manual cleanup required."
                fi
            fi
        done
        exit 10
    else
        rsd::warn "Recovery Mode: FORWARD."
        rsd::warn "Please resolve the environmental issue, then run the recipe again."
        rsd::warn "Already satisfied steps will be automatically skipped."
        exit 10
    fi
}

# ==============================================================================
# Recipe-Specific Helpers
# ==============================================================================
# Intent: Helpers that are inherently tied to the recipe provisioning subsystem.
#         System-wide target-aware primitives live in lib/target.lib.

# Install a package via the RSD install subsystem.
# Intent: Sources `command/install` lazily and delegates to the native
#         local/remote routing already built into `rsd::c::install::command`.
#
# @param string $1 The package name.
# @return int Exit code of the install subsystem.
function rsd::l::recipe::install_pkg() {
    local package="$1"
    source "$(rsd::get_libdir_file command/install)"
    rsd::c::install::command "$package"
}

# Finds all *.recipe files recursively under a base directory.
# This function is pure-Bash and does not call external binaries like find.
#
# @param string $1 The absolute base directory path.
# @param string $2 The current subfolder relative path (empty for root).
# @return stdout Relative paths of found recipes (without .recipe extension).
function rsd::l::recipe::find_recursive() {
    local base_dir="$1"
    local sub_dir="$2"
    local path="${base_dir}/${sub_dir}"
    local item

    [[ ! -d "$path" ]] && return 0

    for item in "$path"/*; do
        [[ ! -e "$item" ]] && continue
        if [[ -d "$item" ]]; then
            local next_sub
            if [[ -z "$sub_dir" ]]; then
                next_sub="$(basename "$item")"
            else
                next_sub="${sub_dir}/$(basename "$item")"
            fi
            rsd::l::recipe::find_recursive "$base_dir" "$next_sub"
        elif [[ -f "$item" && "$item" == *.recipe ]]; then
            local relative_file="${item#$base_dir/}"
            echo "${relative_file%.recipe}"
        fi
    done
}
