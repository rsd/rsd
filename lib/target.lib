#!/usr/bin/env bash

# @see docs/recipes.md
# @see AGENTS.md

if [[ ! -v RSD_ON || $RSD_ON -ne 1 ]]; then
    echo "This is a RSD library file. It should not be executed directly."
    echo "Please call 'rsd' to use it."
    exit 12
fi

if [[ "$RSD_TARGET_LIB" == "1" ]]; then
    return 0
fi
RSD_TARGET_LIB=1
RSD_TARGET_LIB_VERSION="0.1.0"

# ==============================================================================
# Target-Aware Dispatch Primitives
# ==============================================================================
# Intent: Provide a single routing decision point for local vs. remote execution.
#         ALL derived helpers delegate to rsd::l::target::exec, eliminating the
#         duplicated `if [[ -n "$RSD_REMOTE_TARGET" ]]; then ... else ... fi`
#         branching pattern from every consumer.

# Execute a command on the current target host (local or remote).
# Intent: The single point in the framework where the local/remote dispatch
#         decision is made. Every other target-aware helper is built on this.
#
# @param string $@ The full command and arguments.
# @return int Exit code of the command.
function rsd::l::target::exec() {
    if [[ -n "$RSD_REMOTE_TARGET" ]]; then
        rsd::l::remote::execute "$RSD_REMOTE_TARGET" "$@"
    else
        "$@"
    fi
}

# Execute a command elevated via sudo on the current target host.
# Intent: Encapsulates local `sudo.lib` askpass and remote `,sudo://root`
#         target appending in a single call.
#         This retains its own branching because the sudo pathway semantics
#         differ at the protocol level: remote appends `,sudo://root` to
#         the target string, while local uses `sudo.lib`.
#
# @param string $1 The target user (or empty string for root).
# @param string $@ The command payload to elevate.
# @return int Exit code of the elevated command.
function rsd::l::target::exec_sudo() {
    local user="$1"
    shift
    if [[ -n "$RSD_REMOTE_TARGET" ]]; then
        local elevated_target="${RSD_REMOTE_TARGET},sudo://${user:-root}"
        rsd::l::remote::execute "$elevated_target" "$@"
    else
        [[ "$RSD_SUDO_LIB" != "1" ]] && source "$(rsd::get_libdir_file lib/sudo.lib)"
        rsd::l::sudo::run "$user" "$@"
    fi
}

# ==============================================================================
# Derived Helpers — Zero Branching, All Delegate to exec
# ==============================================================================

# Check if a binary exists in $PATH on the target host.
#
# @param string $1 The binary name (e.g., "zsh", "cargo").
# @return int 0 if found, 1 if missing.
function rsd::l::target::has_bin() {
    rsd::l::target::exec which "$1" &>/dev/null
}

# Check if a directory exists on the target host.
#
# @param string $1 The directory path (supports remote shell expansions like \$HOME).
# @return int 0 if exists, 1 if missing.
function rsd::l::target::dir_exists() {
    rsd::l::target::exec test -d "$1"
}

# Check if a file exists on the target host.
#
# @param string $1 The file path (supports remote shell expansions).
# @return int 0 if exists, 1 if missing.
function rsd::l::target::file_exists() {
    rsd::l::target::exec test -f "$1"
}

# Check if a file contains a matching pattern on the target host.
#
# @param string $1 The grep pattern.
# @param string $2 The file path.
# @return int 0 if matched, 1 if no match.
function rsd::l::target::file_contains() {
    rsd::l::target::exec grep -q "$1" "$2"
}

# Clone a git repository on the target host.
#
# @param string $1 The repository URL.
# @param string $2 The destination path (supports remote shell expansions).
# @param string $3 Optional --depth value (e.g. "1" for shallow clone).
# @return int Exit code of git clone.
function rsd::l::target::git_clone() {
    local repo="$1"
    local dest="$2"
    local depth="${3:-}"
    local -a depth_args=()
    [[ -n "$depth" ]] && depth_args=("--depth" "$depth")

    rsd::l::target::exec git clone "${depth_args[@]}" "$repo" "$dest"
}
