#!/usr/bin/env bash

# Configuration loading, parsing, and management utilities.
# namespace rsd::config::
# namespace rsd::l::config::

if [[ ! -v RSD_ON || $RSD_ON -ne 1 ]]; then
    echo "This is a RSD library file. It should not be executed directly."
    echo "Please call 'rsd' to use it."
    exit 12
fi

# configuration related stuff for RSD
# Configurations are read from files as global variables.
# There are 2 types of configuration files:
# 1. .conf files - they are sourced directly, so manypulations can be done - use with care.
# 2. .ini files  - they are read into global associative arrays, so they are safer to use, but limited.
#                - the ini config is saved in the global "R::INI::<command>" associative array.

# FIXME: config is being evaluated after command line parsing.
#        command line parsing should have precedence.
# FIXME: Some searchpaths end up duplicates.  It is not a real problem, but should be sanitized too.

RSD_CONFIGLIB_VERSION='0.3.1'

declare -ga RSD_CONFIGLIB_SEARCH_PATH
RSD_CONFIGDIR=()
RSD_CONFIGDIR_temp=()

# Searchs for all occurences of a file
# Every one is loaded.
# The same file can be loaded multiple times.
# The config is a bash script anyways
# TODO: Migrate to ini and merge multiple inis
RSD_CONFIGLIB_SEARCH_PATH=()
function rsd::config::get_file() {
    declare -ga RSD_CONFIGLIB_SEARCH_PATH
    RSD_CONFIGLIB_SEARCH_PATH=()
	local command=${1:-rsd}
	local found=1
    local key
    local configdir
    local keys=(".")

    # 1. Base/Vendor/System Defaults (lowest priority, processed first)
    RSD_CONFIGLIB_SEARCH_PATH+=("/etc/rsd/")
    RSD_CONFIGLIB_SEARCH_PATH+=("/usr/local/etc/rsd/")
    RSD_CONFIGLIB_SEARCH_PATH+=("${RSD_LIBRARY_SEARCH_PATH[@]}")
    RSD_CONFIGLIB_SEARCH_PATH+=("$(dirname "${BASH_SOURCE[0]:-.}")/config")
    RSD_CONFIGLIB_SEARCH_PATH+=("$RSD_RUN_DIR/config")

    if [[ $RSD_MODE == "local" ]]; then
        RSD_CONFIGLIB_SEARCH_PATH+=("/usr/local/etc/rsd")
    elif [[ $RSD_MODE == "opt" ]]; then
        #FIXME:  No opt installation yet
        RSD_CONFIGLIB_SEARCH_PATH+=("/opt/rsd/config")
    elif [[ $RSD_MODE == "distro" ]]; then
        RSD_CONFIGLIB_SEARCH_PATH+=("/etc/rsd")
    fi

    # 2. User Space Configurations
    if [[ -v RSD_CONFIG_DIR ]]; then
        RSD_CONFIGLIB_SEARCH_PATH+=("$RSD_CONFIG_DIR")
        RSD_CONFIGLIB_SEARCH_PATH+=("$RSD_CONFIG_DIR/")
    fi
    RSD_CONFIGLIB_SEARCH_PATH+=("$HOME/.rsd/")
    RSD_CONFIGLIB_SEARCH_PATH+=("$HOME/.config/rsd/")
    RSD_CONFIGLIB_SEARCH_PATH+=("$HOME/.config/rsd")
    RSD_CONFIGLIB_SEARCH_PATH+=("$HOME/.local/etc/rsd")
    RSD_CONFIGLIB_SEARCH_PATH+=("$HOME/.rsd/config")

    # 3. Workspace / Active Working Directories
    if [[ $RSD_MODE == "devel" ]]; then
        RSD_CONFIGLIB_SEARCH_PATH+=("$RSD_RUN_DIR/config")
    fi
    # TRUST BOUNDARY: The current working directory is included in the config
    # search path. A .conf file in $(pwd)/config/ is SOURCED as executable Bash
    # code into the running process. This means running `rsd` from a directory
    # containing a crafted config/rsd.conf will execute arbitrary shell code.
    #
    # This is an intentional design tradeoff (similar to direnv's .envrc or
    # git's .gitconfig). The feature enables per-project configuration overrides
    # (e.g., RSD_CONFIG_DIR pointing to a project-specific config tree).
    #
    # Mitigation: Users should only run `rsd` from directories they own and trust.
    # @see AGENTS.md Section 9 (Configuration Sourcing Trust Boundary)
    RSD_CONFIGLIB_SEARCH_PATH+=("$(pwd)/config")

    # 4. Sourced Configurations (only populated after first conf load)
    RSD_CONFIGLIB_SEARCH_PATH+=("${RSD_CONFIG_CONFIG_SEARCH_PATH[@]}")

    # 5. CLI Overrides (highest priority, processed last)
    local cli_keys=("config-dir" "config" "c")
    local cli_key
    for cli_key in "${cli_keys[@]}"; do
        if bash::key_exists "$cli_key" in RSD_ARGS; then
            IFS=',' read -r -a RSD_CONFIGDIR_temp <<< "${RSD_ARGS[$cli_key]}"
            RSD_CONFIGDIR=("${RSD_CONFIGDIR[@]}" "${RSD_CONFIGDIR_temp[@]}")
        fi
    done
    RSD_CONFIGLIB_SEARCH_PATH+=("${RSD_CONFIGDIR[@]}")

    # Print all paths in the array for debugging
    #printf "Library Search Paths for $RSD_MODE:\n%s\n" "${RSD_CONFIGLIB_SEARCH_PATH[@]}"


    for configdir in "${RSD_CONFIGLIB_SEARCH_PATH[@]}"; do
	    for key in "${keys[@]}"; do
	        path=$(readlink -f "$configdir/$key" 2>/dev/null || true)

	        # .conf files are sourced
            if [[ -f "$path/$command.conf" ]]; then
                rsd::debug2 9 "rsd::config::get_file: Found as $path/$command.conf"
			    echo source "$path/$command.conf"
            fi

            # .ini files are processed (echoed to be evaluated in parent process scope)
            if [[ -f "$path/$command.ini" ]]; then
                rsd::debug2 9 "rsd::config::get_file: Found as $path/$command.ini"
                echo "if [[ ! -v \"R_INI_$command\" ]]; then declare -gA \"R_INI_$command\"; fi; rsd::config::read_ini '$path/$command.ini' 'R_INI_$command'"
            fi
        done
	done
}


# Read an Ini File Into an existing associative array
# Arguments:
#   $1: The file to read
#   $2: The name of the associative array to save the config
# Notes:
#   - The config name can contain data from other configs for the same command that will be appended or replaced
function rsd::config::read_ini() {
    rsd::arguments_or_usage 2 $@
    local file="$1"
    local config_name="$2"
    declare -n config="$config_name"

    local section
    local key
    local value
    local line
    local section_re='^\[([^]]+)\]$'
    local key_re='^[[:space:]]*([^=]*[^=[:space:]])[[:space:]]*=[[:space:]]*(.*)$'

    if [[ ! -f "$file" ]]; then
        rsd::warn "Error: File does not exist."
        return 1
    fi

    while IFS= read -r line || [[ -n "$line" ]]; do

        # Trim leading and trailing whitespace using Bash parameter expansion
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"

        if [[ -z "$line" || "$line" =~ ^[\;#] ]]; then
            continue  # Skip blank lines and lines starting with ';' or '#'
        fi
        if [[ $line =~ $section_re ]]; then
            section="${BASH_REMATCH[1]}"
        elif [[ $line =~ $key_re ]]; then
            key="${BASH_REMATCH[1]}"
            value="${BASH_REMATCH[2]}"
            config["$section.$key"]="$value"
        fi
    done < "$file"
}

# Write an ini file from a config associative array
# Arguments:
#   $1: The file to write
#   $2: The name of the associative array to read the config
# Notes:
#   - The config name can contain data from other configs for the same command that will be appended or replaced
#   - the keys in the associative array should be in the form "section.key"
function rsd::config::write_ini() {
    local file="$1"
    local config_name="$2"
    declare -n config="$config_name"

    local section
    local key
    local previous_section=""

    # FIXME: Should do a backup first
    > "$file"  # Clear the file if it exists or create a new one

    for key in "${!config[@]}"; do
        section="${key%%.*}"
        local actual_key="${key#*.}"

        if [[ "$section" != "$previous_section" ]]; then
                printf "[%s]\n" "$section" >> "$file"
                previous_section="$section"
        fi
        printf "%s = %s\n" "$actual_key" "${config[$key]}" >> "$file"
    done
}

# Safely write or update a key-value variable in a Bash .conf file.
# If the variable exists, its value is replaced atomically. If not, it is appended.
#
# @param string $1 Path to the .conf file.
# @param string $2 Variable key (e.g., RSD_GPG_USER_ID).
# @param string $3 Value to assign to the variable.
# @return int 0 on success, 13 on write failure, 14 on temp file failure.
function rsd::l::config::set_conf_value() {
    rsd::arguments_or_usage 3 "$@"
    local file="$1"
    local key="$2"
    local value="$3"

    # Intent: Ensure the target directory exists
    local dir
    dir=$(dirname "$file")
    if [[ ! -d "$dir" ]]; then
        mkdir -p "$dir" || return 13
    fi

    # Create file if it does not exist
    if [[ ! -f "$file" ]]; then
        touch "$file" || return 13
    fi

    # Escape value for safe sed/regex usage
    local escaped_value
    escaped_value=$(echo "$value" | sed 's/[&/\]/\\&/g')

    # Intent: Atomic update via temp file if key already exists, otherwise append
    if grep -q "^[[:space:]]*${key}=" "$file" 2>/dev/null; then
        local temp_file
        temp_file=$(mktemp) || return 14
        sed "s/^[[:space:]]*${key}=.*/${key}=\"${escaped_value}\"/" "$file" > "$temp_file" && mv "$temp_file" "$file" || {
            rm -f "$temp_file"
            return 13
        }
    else
        echo "${key}=\"${value}\"" >> "$file" || return 13
    fi
    return 0
}


$(rsd::config::get_file)
