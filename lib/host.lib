#!/usr/bin/env bash

# @see docs/host.md
# @see AGENTS.md

if [[ ! -v RSD_ON || $RSD_ON -ne 1 ]]; then
    echo "This is a RSD library file. It should not be executed directly."
    echo "Please call 'rsd' to use it."
    exit 12
fi

if [[ "$RSD_HOST_LIB" == "1" ]]; then
    return 0
fi
RSD_HOST_LIB=1
RSD_HOST_LIB_VERSION="0.1.1"

# Sourcing hosts.ini if not loaded yet.
# Intent: Lazy-load hosts configuration profiles to save memory and parsing overhead.
#
# @return void
# @throws 5 Sourced library file cannot be resolved during config delegation.
function rsd::l::host::load_config() {
    if [[ ! -v "R_INI_hosts" ]]; then
        declare -gA R_INI_hosts
    fi
    if bash::is_function rsd::config::get_file; then
        eval "$(rsd::config::get_file hosts)"
    fi
}

# Performs host platform identification.
# Intent: Safely scan system-level releases (such as /etc/os-release) using string parsing
#         to extract distribution family, kernel OS type, architecture, and package manager.
#
# @param AssociativeArray& $1 nameref output variable for associative array of host properties.
# @return int 0 on success.
# @throws 3 Program not found if 'uname' binary is missing from PATH.
function rsd::l::host::identify() {
    rsd::arguments_or_usage 1 "$@"
    local _out_var="$1"
    declare -n _r_props="$_out_var"
    
    rsd::check_binaries_or_fail uname
    
    # 1. Detect OS (convert to standard lowercase representation)
    local os
    os=$(uname -s | tr '[:upper:]' '[:lower:]')
    _r_props[os]="$os"
    
    # 2. Detect Architecture (convert to standard lowercase representation)
    local arch
    arch=$(uname -m | tr '[:upper:]' '[:lower:]')
    _r_props[arch]="$arch"
    
    # Defaults
    _r_props[distro]="unknown"
    _r_props[family]="unknown"
    _r_props[version]="unknown"
    _r_props[pkg_manager]="unknown"
    _r_props[writable_bins]="none"
    
    if [[ "$os" == "linux" ]]; then
        local os_release_file="${RSD_MOCK_OS_RELEASE:-/etc/os-release}"
        # Intent: Fallback to usr/lib/os-release if /etc/os-release is missing
        if [[ ! -f "$os_release_file" && -f "/usr/lib/os-release" && -z "$RSD_MOCK_OS_RELEASE" ]]; then
            os_release_file="/usr/lib/os-release"
        fi
        
        if [[ -f "$os_release_file" ]]; then
            local line key value
            local raw_id=""
            local raw_id_like=""
            local raw_version_id=""
            
            while IFS= read -r line || [[ -n "$line" ]]; do
                # Trim whitespace
                line="${line#"${line%%[![:space:]]*}"}"
                line="${line%"${line##*[![:space:]]}"}"
                
                [[ -z "$line" || "$line" =~ ^# ]] && continue
                
                if [[ "$line" =~ ^([A-Za-z0-9_]+)=(.*)$ ]]; then
                    key="${BASH_REMATCH[1]}"
                    value="${BASH_REMATCH[2]}"
                    
                    # Trim quotes around value assignments
                    if [[ "$value" =~ ^\"(.*)\"$ ]] || [[ "$value" =~ ^\'(.*)\'$ ]]; then
                        value="${BASH_REMATCH[1]}"
                    fi
                    
                    case "$key" in
                        ID) raw_id="$value" ;;
                        ID_LIKE) raw_id_like="$value" ;;
                        VERSION_ID) raw_version_id="$value" ;;
                    esac
                fi
            done < "$os_release_file"
            
            # Populate fields
            if [[ -n "$raw_id" ]]; then
                _r_props[distro]=$(echo "$raw_id" | tr '[:upper:]' '[:lower:]')
            fi
            
            if [[ -n "$raw_version_id" ]]; then
                _r_props[version]=$(echo "$raw_version_id" | tr '[:upper:]' '[:lower:]')
            else
                _r_props[version]="rolling"
            fi
            
            # Intent: Inferred family mapping. If ID_LIKE is defined, extract first entry as family;
            #         otherwise fall back to ID.
            if [[ -n "$raw_id_like" ]]; then
                # Get first word of ID_LIKE
                local family_cand
                read -r family_cand _ <<< "$raw_id_like"
                _r_props[family]=$(echo "$family_cand" | tr '[:upper:]' '[:lower:]')
            else
                _r_props[family]="${_r_props[distro]}"
            fi
            
            # Map Package Manager based on family / distro
            case "${_r_props[family]}" in
                debian)  _r_props[pkg_manager]="apt" ;;
                arch)    _r_props[pkg_manager]="pacman" ;;
                fedora|rhel|centos) _r_props[pkg_manager]="dnf" ;;
                suse|opensuse)      _r_props[pkg_manager]="zypper" ;;
                alpine)  _r_props[pkg_manager]="apk" ;;
                *)       _r_props[pkg_manager]="unknown" ;;
            esac
        fi
    elif [[ "$os" == "darwin" ]]; then
        _r_props[distro]="macos"
        _r_props[family]="darwin"
        _r_props[pkg_manager]="brew"
        if rsd::check_binary sw_vers; then
            _r_props[version]=$(sw_vers -productVersion)
        fi
    fi
    
    # Detect all user-writable directories in PATH
    local -a local_list=()
    local path_dir
    local IFS=":"
    for path_dir in $PATH; do
        if [[ -d "$path_dir" && -w "$path_dir" ]]; then
            local_list+=("$path_dir")
        fi
    done
    if [[ ${#local_list[@]} -gt 0 ]]; then
        local IFS=","
        _r_props[writable_bins]="${local_list[*]}"
    fi
    
    return 0
}

# Retrieve a host property safely.
# Intent: Resolves the requested metadata attribute for a designated host alias. If the
#         requested host is 'localhost' and no configuration exists, falls back dynamically.
#
# @param string $1 target host alias (e.g., 'localhost', 'server1').
# @param string $2 property key (e.g., 'distro', 'family', 'version', 'arch', 'pkg_manager').
# @param string& $3 nameref output variable for resolved string value.
# @return int 0 on success, 1 if property not found.
function rsd::l::host::get_property() {
    rsd::arguments_or_usage 3 "$@"
    local alias="$1"
    local prop="$2"
    local _out_val="$3"
    declare -n _r_val="$_out_val"
    
    rsd::l::host::load_config
    
    local key="hosts.${alias}.${prop}"
    if [[ -n "${R_INI_hosts[$key]}" ]]; then
        _r_val="${R_INI_hosts[$key]}"
        return 0
    fi
    
    # Intent: Fallback dynamically if requested for local environment and no config is saved
    if [[ "$alias" == "localhost" ]]; then
        declare -A local_props
        if rsd::l::host::identify local_props; then
            if [[ -n "${local_props[$prop]}" ]]; then
                _r_val="${local_props[$prop]}"
                return 0
            fi
        fi
    fi
    
    _r_val=""
    return 1
}

# Generates a standalone, self-contained Bash script for platform discovery.
# Intent: Construct a zero-dependency platform detection snippet that can be executed
#         directly by bash -s on a remote system via standard input redirection.
#
# @param string& $1 nameref output variable for script contents.
# @return int 0.
function rsd::l::host::generate_standalone_script() {
    rsd::arguments_or_usage 1 "$@"
    local _out_script="$1"
    declare -n _r_script="$_out_script"
    
    _r_script=$(cat << 'EOF'
os=$(uname -s | tr '[:upper:]' '[:lower:]')
arch=$(uname -m | tr '[:upper:]' '[:lower:]')
distro="unknown"
family="unknown"
version="unknown"
pkg_manager="unknown"
writable_bins="none"

if [[ "$os" == "linux" ]]; then
    os_release_file="/etc/os-release"
    if [[ ! -f "$os_release_file" && -f "/usr/lib/os-release" ]]; then
        os_release_file="/usr/lib/os-release"
    fi
    if [[ -f "$os_release_file" ]]; then
        while IFS= read -r line || [[ -n "$line" ]]; do
            line="${line#"${line%%[![:space:]]*}"}"
            line="${line%"${line##*[![:space:]]}"}"
            [[ -z "$line" || "$line" =~ ^# ]] && continue
            if [[ "$line" =~ ^([A-Za-z0-9_]+)=(.*)$ ]]; then
                key="${BASH_REMATCH[1]}"
                value="${BASH_REMATCH[2]}"
                if [[ "$value" =~ ^\"(.*)\"$ ]] || [[ "$value" =~ ^\'(.*)\'$ ]]; then
                    value="${BASH_REMATCH[1]}"
                fi
                case "$key" in
                    ID) raw_id="$value" ;;
                    ID_LIKE) raw_id_like="$value" ;;
                    VERSION_ID) raw_version_id="$value" ;;
                esac
            fi
        done < "$os_release_file"
        
        if [[ -n "$raw_id" ]]; then
            distro=$(echo "$raw_id" | tr '[:upper:]' '[:lower:]')
        fi
        if [[ -n "$raw_version_id" ]]; then
            version=$(echo "$raw_version_id" | tr '[:upper:]' '[:lower:]')
        else
            version="rolling"
        fi
        if [[ -n "$raw_id_like" ]]; then
            read -r family_cand _ <<< "$raw_id_like"
            family=$(echo "$family_cand" | tr '[:upper:]' '[:lower:]')
        else
            family="$distro"
        fi
        case "$family" in
            debian)  pkg_manager="apt" ;;
            arch)    pkg_manager="pacman" ;;
            fedora|rhel|centos) pkg_manager="dnf" ;;
            suse|opensuse)      pkg_manager="zypper" ;;
            alpine)  pkg_manager="apk" ;;
        esac
    fi
elif [[ "$os" == "darwin" ]]; then
    distro="macos"
    family="darwin"
    pkg_manager="brew"
    if hash sw_vers 2>/dev/null; then
        version=$(sw_vers -productVersion)
    fi
fi

local_list=()
IFS=":"
for p_dir in $PATH; do
    if [[ -d "$p_dir" && -w "$p_dir" ]]; then
        local_list+=("$p_dir")
    fi
done
if [[ ${#local_list[@]} -gt 0 ]]; then
    IFS=","
    writable_bins="${local_list[*]}"
fi

echo "os=$os"
echo "arch=$arch"
echo "distro=$distro"
echo "family=$family"
echo "version=$version"
echo "pkg_manager=$pkg_manager"
echo "writable_bins=$writable_bins"
EOF
)
    return 0
}
