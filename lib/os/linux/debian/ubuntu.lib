#!/usr/bin/env bash

# @see docs/host.md
# @see AGENTS.md

if [[ ! -v RSD_ON || $RSD_ON -ne 1 ]]; then
    echo "This is a RSD library file. It should not be executed directly."
    echo "Please call 'rsd' to use it."
    exit 12
fi

# Upstream Recursive Sourcing Hook: Load Debian parent library
[[ "$RSD_OS_DEBIAN_LIB" != "1" ]] && source "$(rsd::get_libdir_file lib/os/linux/debian.lib)"

if [[ "$RSD_OS_UBUNTU_LIB" == "1" ]]; then
    return 0
fi
RSD_OS_UBUNTU_LIB=1
RSD_OS_UBUNTU_LIB_VERSION="0.1.0"

# Sets the default editor for Ubuntu.
# Intent: Overrides generic Debian editor setups.
#
# @return int exit code.
function rsd::l::os::set_default_editor() {
    rsd::warn "Ubuntu specific: setting default editor to nano..."
    return 0
}
