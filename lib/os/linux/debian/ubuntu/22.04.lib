#!/usr/bin/env bash

# @see docs/host.md
# @see AGENTS.md

if [[ ! -v RSD_ON || $RSD_ON -ne 1 ]]; then
    echo "This is a RSD library file. It should not be executed directly."
    echo "Please call 'rsd' to use it."
    exit 12
fi

# Upstream Recursive Sourcing Hook: Load Ubuntu 24.04 parent library
[[ "$RSD_OS_UBUNTU_2404_LIB" != "1" ]] && source "$(rsd::get_libdir_file lib/os/linux/debian/ubuntu/24.04.lib)"

if [[ "$RSD_OS_UBUNTU_2204_LIB" == "1" ]]; then
    return 0
fi
RSD_OS_UBUNTU_2204_LIB=1
RSD_OS_UBUNTU_2204_LIB_VERSION="0.1.0"

# Sets the default editor for Ubuntu 22.04.
# Intent: Overrides generic Ubuntu editor setup to use vim-tiny specifically.
#
# @return int exit code.
function rsd::l::os::set_default_editor() {
    rsd::io::status "Ubuntu 22.04 specific: setting default editor to vim-tiny..."
    return 0
}
