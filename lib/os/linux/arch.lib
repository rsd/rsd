#!/usr/bin/env bash

# @see docs/host.md
# @see AGENTS.md

if [[ ! -v RSD_ON || $RSD_ON -ne 1 ]]; then
    echo "This is a RSD library file. It should not be executed directly."
    echo "Please call 'rsd' to use it."
    exit 12
fi

# Upstream Recursive Sourcing Hook: Load base parent library
[[ "$RSD_OS_LINUX_LIB" != "1" ]] && source "$(rsd::get_libdir_file lib/os/linux.lib)"

if [[ "$RSD_OS_ARCH_LIB" == "1" ]]; then
    return 0
fi
RSD_OS_ARCH_LIB=1
RSD_OS_ARCH_LIB_VERSION="0.1.0"

# Install a package dynamically using Pacman.
# Intent: Overrides generic Linux package installation to use pacman.
#         TODO/FIXME: Offload elevation and privilege validation to a dedicated sudo.lib later.
#
# @param string $1 The name of the package.
# @return int exit code of execution.
function rsd::l::os::install_package() {
    rsd::arguments_or_usage 1 "$@"
    local package="$1"
    
    local cmd=("pacman" "-Sy" "--noconfirm" "$package")
    if [[ "$RSD_INSTALL_DRY_RUN" == "1" ]]; then
        echo "sudo ${cmd[@]}"
        return 0
    fi
    
    sudo "${cmd[@]}"
    return $?
}

# Check if a package is installed on Arch Linux.
# Intent: Overrides base command presence check to query pacman local package list.
#
# @param string $1 Package name.
# @return int 0 if installed, 1 if missing.
function rsd::l::os::is_package_installed() {
    rsd::arguments_or_usage 1 "$@"
    local package="$1"
    pacman -Qq "$package" &>/dev/null
}
