#!/usr/bin/env bash

# Remote target checking, bootstrapping, and execution library.
# namespace rsd::l::remote::

if [[ ! -v RSD_ON || $RSD_ON -ne 1 ]]; then
    echo "This is a RSD library file. It should not be executed directly."
    echo "Please call 'rsd' to use it."
    exit 12
fi

RSD_REMOTE_LIB=1
RSD_REMOTE_LIB_VERSION="0.1.4"

# Load structured IO messaging
[[ "$RSD_IO_LIB" != "1" ]] && source "$(rsd::get_libdir_file lib/io.lib)"

# Load necessary static libraries with short-circuit evaluation
[[ "$RSD_PROTOCOL_LIB" != "1" ]] && source "$(rsd::get_libdir_file lib/protocol.lib)"

# Load remote.ini configuration if configuration library is present.
# Pre-declare as associative array — if no config file exists, the eval
# is a no-op and callers would hit an arithmetic syntax error when
# accessing R_INI_remote["pathways.host"] on an undeclared variable.
declare -g -A R_INI_remote 2>/dev/null || true
if bash::is_function rsd::config::get_file; then
    eval "$(rsd::config::get_file remote)"
fi

# ==============================================================================
# Pathway & Connection Parsing Engine
# ==============================================================================

# Parses a single remote target string into scheme, user, host, and port components
# Arguments:
#   $1 - remote target string (e.g., ssh://admin@10.0.0.1:2222)
#   $2 - nameref output variable for protocol
#   $3 - nameref output variable for user
#   $4 - nameref output variable for host
#   $5 - nameref output variable for port
function rsd::l::remote::parse_spec() {
    local spec="$1"
    
    # Use highly unique, prefixed local names to prevent nameref circular reference shadowing
    local _out_proto="$2";  declare -n _r_proto="$_out_proto"
    local _out_user="$3";   declare -n _r_user="$_out_user"
    local _out_host="$4";   declare -n _r_host="$_out_host"
    local _out_port="$5";   declare -n _r_port="$_out_port"

    # Trim leading '@'
    spec="${spec#@}"

    # Set default values
    _r_proto="ssh"
    _r_user=""
    _r_host=""
    _r_port=""

    # 1. Parse Protocol Scheme: scheme://
    if [[ "$spec" =~ ^([a-zA-Z0-9]+)://(.*)$ ]]; then
        _r_proto="${BASH_REMATCH[1]}"
        spec="${BASH_REMATCH[2]}"
    fi

    # 2. Parse User Spec: user@host
    if [[ "$spec" =~ ^([^@]+)@(.*)$ ]]; then
        _r_user="${BASH_REMATCH[1]}"
        spec="${BASH_REMATCH[2]}"
    elif [[ "$_r_proto" == "sudo" ]]; then
        _r_user="$spec"
        spec=""
    fi

    # 3. Parse Port Map: host:port
    if [[ -n "$spec" ]]; then
        if [[ "$spec" =~ ^([^:]+):([0-9]+)$ ]]; then
            _r_host="${BASH_REMATCH[1]}"
            _r_port="${BASH_REMATCH[2]}"
        else
            _r_host="$spec"
        fi
    fi
}

# Recursively resolves aliases and comma-delimited pathways into clean hop specifications
# Arguments:
#   $1 - target pathway or host spec
#   $2 - nameref output array to accumulate resolved hops
function rsd::l::remote::resolve_pathway() {
    local spec="$1"
    
    # Avoid circular reference shadowing: declare nameref to the outer variable name passed
    local _out_array="$2"; declare -n _r_resolved_hops="$_out_array"

    # Trim leading '@'
    spec="${spec#@}"

    local pathway_key="pathways.${spec}"
    local host_key="hosts.${spec}"

    # Use R_INI_ namespace rather than R::INI:: to ensure compatibility with Bash parser rules
    if [[ -n "${R_INI_remote[$pathway_key]}" ]]; then
        # Segment matches pathway configuration alias
        local expanded_pathway="${R_INI_remote[$pathway_key]}"
        rsd::debug "Resolving pathway alias '$spec' -> '$expanded_pathway'" 15

        local hop
        local IFS=$',@'
        local -a raw_hops
        read -r -a raw_hops <<< "$expanded_pathway"

        for hop in "${raw_hops[@]}"; do
            [[ -z "$hop" ]] && continue
            # CRITICAL: Pass the original parent scope variable name down the recursion stack
            # to prevent circular nameref references to the local '_r_resolved_hops' shadow.
            rsd::l::remote::resolve_pathway "$hop" "$_out_array"
        done
    elif [[ -n "${R_INI_remote[$host_key]}" ]]; then
        # Segment matches individual host alias
        local expanded_host="${R_INI_remote[$host_key]}"
        rsd::debug "Resolving host alias '$spec' -> '$expanded_host'" 15
        rsd::l::remote::resolve_pathway "$expanded_host" "$_out_array"
    else
        # Literal segment or comma-separated raw values
        if [[ "$spec" == *","* ]]; then
            local hop
            local IFS=$','
            local -a raw_hops
            read -r -a raw_hops <<< "$spec"
            for hop in "${raw_hops[@]}"; do
                [[ -z "$hop" ]] && continue
                rsd::l::remote::resolve_pathway "$hop" "$_out_array"
            done
        else
            _r_resolved_hops+=("$spec")
        fi
    fi
}

# ==============================================================================
# Dynamic Command Orchestration & Tunneling
# ==============================================================================

# Orchestrates and executes the delegated command payload recursively through resolved hops
# Arguments:
#   $1 - target remote specification
#   $2..$* - Command payload to execute
# Returns:
#   Exit code of the execution pipeline
function rsd::l::remote::delegate() {
    rsd::arguments_or_usage 2 "$@"
    local remote_spec="$1"
    local command_payload=("${@:2}")

    # 1. Resolve target pathway recursively
    local -a hops=()
    rsd::l::remote::resolve_pathway "$remote_spec" hops

    if [[ ${#hops[@]} -eq 0 ]]; then
        rsd::io::error "Failed to resolve remote target spec '$remote_spec'."
        exit 20
    fi

    # 2. Compile execution blocks right-to-left (backwards)
    local -a active_payload=("${command_payload[@]}")

    # Save-on-first-use tracking for sudo hops
    local _sudo_save_entry="" _sudo_save_user="" _sudo_save_pass=""

    local i
    for (( i=${#hops[@]}-1; i>=0; i-- )); do
        local hop="${hops[i]}"
        local proto user host port
        rsd::l::remote::parse_spec "$hop" proto user host port

        local run_func="rsd::l::protocol::${proto}::run"
        if ! bash::is_function "$run_func"; then
            rsd::io::error "Protocol transport '$proto' is unsupported or missing handler."
            exit 3
        fi

        # For nested jumps (i > 0), wrap the active command block for outer shell environments
        if (( i > 0 )); then
            if [[ "$proto" == "ssh" ]]; then
                local target
                if [[ -n "$user" ]]; then
                    target="${user}@${host}"
                else
                    target="$host"
                fi
                local port_opt=""
                [[ -n "$port" ]] && port_opt="-p $port"

                # Shell-escape the active payload arguments cleanly
                local escaped_cmd=""
                local item
                for item in "${active_payload[@]}"; do
                    escaped_cmd="${escaped_cmd} '$(printf '%s' "$item" | sed "s/'/'\\\\''/g")'"
                done

                active_payload=("ssh" $port_opt "$target" "$escaped_cmd")
            elif [[ "$proto" == "lxc" ]]; then
                local -a lxc_opts=()
                if [[ -n "$user" ]]; then
                    lxc_opts+=("--clear-env" "--user" "$user")
                fi
                active_payload=("lxc-attach" -n "$host" "${lxc_opts[@]}" -- "${active_payload[@]}")
            elif [[ "$proto" == "sudo" ]]; then
                # Sudo intermediate hop packaging:
                # Find password of host reached in the previous hop (hops[i-1])
                local prev_hop="${hops[i-1]}"
                local p_proto p_user p_host p_port
                rsd::l::remote::parse_spec "$prev_hop" p_proto p_user p_host p_port

                # Sourcing-Inheritance hook for sudo.lib if not active
                [[ "$RSD_SUDO_LIB" != "1" ]] && source "$(rsd::get_libdir_file lib/sudo.lib)"

                local password="" password_source=""
                rsd::l::sudo::get_password "${p_host:-localhost}" "$user" password password_source

                # Stash for post-execution save hook
                if [[ "$password_source" == "interactive" ]]; then
                    _sudo_save_entry="Sudo/${p_host:-localhost}"
                    _sudo_save_user="${user:-root}"
                    _sudo_save_pass="$password"
                fi

                # Shell-escape the active payload arguments cleanly
                local escaped_cmd=""
                local item
                for item in "${active_payload[@]}"; do
                    escaped_cmd="${escaped_cmd} '$(printf '%s' "$item" | sed "s/'/'\\\\''/g")'"
                done

                if [[ -n "$password" ]]; then
                    # SECURITY NOTE: For intermediate hops, the password must be embedded
                    # in the compiled command string because stdin belongs to the outermost
                    # SSH tunnel and cannot be multiplexed per hop. This means the password
                    # is briefly visible in `ps aux` on the intermediate host.
                    # The outermost hop (protocol.lib::sudo::run) uses stdin piping instead,
                    # which does NOT expose the password in process arguments.
                    # This is an inherent limitation of multi-hop command compilation.
                    local escaped_pass
                    escaped_pass=$(printf '%s' "$password" | sed "s/'/'\\\\''/g")

                    # Build the sh -c command string, then shell-escape it as a single
                    # word using printf '%q'. Without this, SSH transport causes the
                    # remote shell to split on the unquoted pipe '|', so 'sh -c echo'
                    # runs alone (outputting nothing) and sudo gets empty input.
                    local _sh_c_cmd="echo '${escaped_pass}' | sudo -S -p '' -u ${user:-root} -- ${escaped_cmd}"
                    local _escaped_sh_c
                    printf -v _escaped_sh_c '%q' "$_sh_c_cmd"
                    active_payload=("sh" "-c" "$_escaped_sh_c")
                else
                    active_payload=("sudo" "-u" "${user:-root}" "--" "${active_payload[@]}")
                fi
            else
                rsd::io::error "Protocol '$proto' does not support intermediate hop packaging."
                exit 3
            fi
        else
            # Outermost hop (index 0) is executed locally
            "$run_func" "$user" "$host" "$port" "${active_payload[@]}"
            local exit_status=$?

            # Save-on-first-use hook (after outermost hop returns)
            if [[ $exit_status -eq 0 && -n "$_sudo_save_pass" ]]; then
                [[ "$RSD_SUDO_LIB" != "1" ]] && source "$(rsd::get_libdir_file lib/sudo.lib)"
                rsd::l::sudo::offer_vault_save "$_sudo_save_entry" "$_sudo_save_user" "$_sudo_save_pass"
            fi

            return $exit_status
        fi
    done
}

# Orchestrates local-aware execution (Mode A) or remote-delegation fallback (Mode B)
# Arguments:
#   $1 - target remote specification
#   $2..$* - Command payload to execute
function rsd::l::remote::execute() {
    rsd::arguments_or_usage 2 "$@"
    local remote_spec="$1"
    local command_payload=("${@:2}")

    # Check if remote target has been verified and resolved
    # Sourced library delegates execution natively
    rsd::l::remote::delegate "$remote_spec" "${command_payload[@]}"
    return $?
}

# Securely prompt the user for interactive confirmations via /dev/tty.
# Intent: Hook into the controlling terminal device so that redirected stdin pipelines
#         do not bypass or break input queries.
#
# @param string $1 The prompt message to show.
# @return int 0 if the user replied Yes/Y, 1 if the user declined.
function rsd::l::remote::prompt_user() {
    rsd::arguments_or_usage 1 "$@"
    local prompt_msg="$1"
    local reply
    
    # Check if mock prompt reply is set to bypass interactive read
    if [[ -v RSD_MOCK_PROMPT_REPLY ]]; then
        if [[ "${RSD_MOCK_PROMPT_REPLY}" == "Y" ]]; then
            echo "(Mocked Y)" >&2
            return 0
        fi
        return 1
    fi
    
    # Prompt the user on stderr and read from /dev/tty
    echo -n "$prompt_msg " >&2
    if { read -n 1 -r reply < /dev/tty; } 2>/dev/null; then
        echo >&2 # line break
        if [[ -z "$reply" || "$reply" =~ ^[Yy]$ || "$reply" == $'\n' ]]; then
            return 0
        fi
    else
        # Fallback to standard input in case of redirected stdin in active terminals
        if [[ ! -t 0 ]]; then
            if read -n 1 -r reply 2>/dev/null; then
                if [[ -z "$reply" || "$reply" =~ ^[Yy]$ || "$reply" == $'\n' ]]; then
                    return 0
                fi
            fi
        fi
    fi
    return 1
}

# Packages the local RSD tree into a tar stream, dispatches it, and installs it user-space.
# Intent: Performs a zero-dependency remote bootstrap installation. Automatically cleans up
#         temporary files on the destination target on completion.
#
# @param string $1 The target remote specification.
# @return int 0 on success, 13 on write failure, 14 on temp directory failure.
function rsd::l::remote::bootstrap_install() {
    rsd::arguments_or_usage 1 2 "$@"
    local remote_spec="$1"
    local mode="${2:-user}"
    
    rsd::check_binaries_or_fail tar
    
    rsd::io::status "Bootstrapping RSD on remote target '$remote_spec'..."
    
    # Intent: Create a secure temporary directory on the remote host using mktemp.
    #         The old approach used `openssl rand -hex 6` locally to generate a suffix,
    #         which prevented collisions but NOT symlink attacks (CWE-377) — an attacker
    #         watching /tmp could race the mkdir-to-tar window (CWE-367).
    #         Using remote mktemp -d atomically creates an unpredictable directory.
    #
    # NOTE: Cannot use rsd::l::target::mktemp here because bootstrap operates on
    #       $remote_spec (a parameter), not $RSD_REMOTE_TARGET (a global).
    local remote_tmp
    remote_tmp=$(rsd::l::remote::execute "$remote_spec" "mktemp" "-d" "-t" "rsd-bootstrap.XXXXXX" 2>/dev/null)
    # Trim leading/trailing whitespace from remote output
    bash::trim remote_tmp
    if [[ -z "$remote_tmp" ]]; then
        rsd::io::error "Failed to create secure temp directory on remote host."
        return 14
    fi
    local rsd_bin_dir="$RSD_RUN_DIR"
    local rsd_share_dir="$RSD_RUN_DIR"
    if [[ "$RSD_MODE" != "devel" ]]; then
        rsd_share_dir="$(dirname "$RSD_RUN_DIR")/share/rsd"
    fi
    
    # 1. Dispatch tarball and unpack remotely
    rsd::io::status "Streaming local RSD files to remote target..."
    if ! tar -cf - -C "$rsd_bin_dir" rsd -C "$rsd_share_dir" lib command config data LICENSE README.md 2>/dev/null | \
         rsd::l::remote::execute "$remote_spec" "mkdir" "-p" "$remote_tmp" "&&" "tar" "-xf" "-" "-C" "$remote_tmp" >/dev/null; then
        rsd::io::error "Failed to stream and unpack RSD on remote host."
        # Clean up in case directory was created
        rsd::l::remote::execute "$remote_spec" "rm" "-rf" "$remote_tmp" 2>/dev/null
        return 13
    fi
    
    # 2. Run remote installer
    rsd::io::status "Executing remote framework installer..."
    if ! rsd::l::remote::execute "$remote_spec" "env" "RSD_INSTALLATION_STEP=2" "TEMP_DIR=${remote_tmp}" "bash" "${remote_tmp}/rsd" "--install" "$mode" >/dev/null; then
        rsd::io::error "Remote framework installer failed."
        rsd::l::remote::execute "$remote_spec" "rm" "-rf" "$remote_tmp" 2>/dev/null
        return 13
    fi
    
    # 3. Clean up remote temp directory
    rsd::l::remote::execute "$remote_spec" "rm" "-rf" "$remote_tmp" >/dev/null
    
    rsd::io::ok "Successfully bootstrapped RSD on remote target '$remote_spec'."
    return 0
}

# Coordinate remote pre-flight framework validation.
# Intent: Probes for remote RSD presence, guides self-healing copy-install bootstrap
#         on target hosts, and compares version parity for compliance sync-upgrades.
#         Respects hosts.<alias>.allow_bootstrap settings to protect guest servers.
#
# @param string $1 The target remote specification.
# @param string& $2 nameref output variable for resolved remote binary string (e.g. 'rsd' or '$HOME/.local/bin/rsd').
# @return int 0 on success, 1 on failure.
function rsd::l::remote::bootstrap_check() {
    rsd::arguments_or_usage 2 "$@"
    local remote_spec="$1"
    local _out_bin="$2"
    declare -n _r_bin="$_out_bin"
    
    _r_bin="rsd"
    
    # Lazy load hosts configuration to check bootstrap permission keys
    if bash::is_function rsd::l::host::load_config; then
        rsd::l::host::load_config
    fi
    
    # 1. Probe for framework presence
    local remote_ver=""
    rsd::debug "Probing remote framework on '$remote_spec' via raw 'rsd --version'..." 15
    remote_ver=$(rsd::l::remote::execute "$remote_spec" "rsd" "--version" 2>/dev/null)
    local probe_status=$?
    
    if [[ $probe_status -ne 0 ]]; then
        # Try local user-space path fallback
        rsd::debug "Raw probe failed. Probing via '\$HOME/.local/bin/rsd'..." 15
        remote_ver=$(rsd::l::remote::execute "$remote_spec" "\$HOME/.local/bin/rsd" "--version" 2>/dev/null)
        probe_status=$?
        if [[ $probe_status -eq 0 ]]; then
            _r_bin="\$HOME/.local/bin/rsd"
        fi
    fi
    
    # 2. Trigger bootstrapper if missing
    if [[ $probe_status -ne 0 ]]; then
        # Check if bootstrapping is explicitly blocked for this target
        local host_alias="${remote_spec#@}"
        local allowed=""
        if [[ -v "R_INI_hosts" ]]; then
            if [[ -n "${R_INI_hosts["hosts.${host_alias}.allow_bootstrap"]}" ]]; then
                allowed="${R_INI_hosts["hosts.${host_alias}.allow_bootstrap"]}"
            elif [[ -n "${R_INI_hosts["${host_alias}.allow_bootstrap"]}" ]]; then
                allowed="${R_INI_hosts["${host_alias}.allow_bootstrap"]}"
            fi
        fi
        if [[ -n "$allowed" ]]; then
            if [[ "$allowed" == "false" || "$allowed" == "0" || "$allowed" == "no" ]]; then
                rsd::io::warn "Bootstrapping is disabled for target '$remote_spec' in hosts.ini."
                return 1
            fi
        fi

        if rsd::l::remote::prompt_user "RSD is not installed on remote target '$remote_spec'. Would you like to bootstrap the installation now? [Y/n]"; then
            if ! rsd::l::remote::bootstrap_install "$remote_spec"; then
                rsd::io::error "Failed to bootstrap remote target."
                return 1
            fi
            
            # Re-verify and set resolved binary
            remote_ver=$(rsd::l::remote::execute "$remote_spec" "\$HOME/.local/bin/rsd" "--version" 2>/dev/null)
            if [[ $? -eq 0 ]]; then
                _r_bin="\$HOME/.local/bin/rsd"
            else
                rsd::io::error "Bootstrapper completed but framework remains unresolvable on target."
                return 1
            fi
        else
            rsd::io::warn "Command delegation declined because remote framework is missing."
            return 1
        fi
    fi
    
    # 3. Parity & Version Compliance check
    # Trim leading/trailing whitespace
    bash::trim remote_ver
    
    if rsd::version_gt "$RSD_VERSION" "$remote_ver"; then
        rsd::io::warn "Remote framework version ($remote_ver) is older than your local version ($RSD_VERSION)."
        
        # Check if upgrades/writes are blocked for this target
        local host_alias="${remote_spec#@}"
        local allowed=""
        if [[ -v "R_INI_hosts" ]]; then
            if [[ -n "${R_INI_hosts["hosts.${host_alias}.allow_bootstrap"]}" ]]; then
                allowed="${R_INI_hosts["hosts.${host_alias}.allow_bootstrap"]}"
            elif [[ -n "${R_INI_hosts["${host_alias}.allow_bootstrap"]}" ]]; then
                allowed="${R_INI_hosts["${host_alias}.allow_bootstrap"]}"
            fi
        fi
        local can_upgrade=1
        if [[ -n "$allowed" ]]; then
            if [[ "$allowed" == "false" || "$allowed" == "0" || "$allowed" == "no" ]]; then
                can_upgrade=0
            fi
        fi
        
        if [[ $can_upgrade -eq 1 ]]; then
            if rsd::l::remote::prompt_user "Would you like to sync-upgrade remote target '$remote_spec' to $RSD_VERSION? [Y/n]"; then
                if ! rsd::l::remote::bootstrap_install "$remote_spec"; then
                    rsd::io::error "Failed to upgrade remote target. Executing with existing version $remote_ver."
                else
                    _r_bin="\$HOME/.local/bin/rsd"
                fi
            fi
        else
            rsd::io::info "Upgrade skipped because bootstrapping is disabled for target '$remote_spec' (allow_bootstrap=false)."
        fi
    fi
    
    return 0
}
