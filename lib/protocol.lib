#!/usr/bin/env bash

# Unified Protocol Interface (UPI) handlers.
# namespace rsd::l::protocol::

if [[ ! -v RSD_ON || $RSD_ON -ne 1 ]]; then
    echo "This is a RSD library file. It should not be executed directly."
    echo "Please call 'rsd' to use it."
    exit 12
fi

RSD_PROTOCOL_LIB=1
RSD_PROTOCOL_LIB_VERSION="0.2.0"

# Unified Protocol Interface (UPI) Library
# All protocol handlers are prefixed using rsd::l::protocol::<scheme>::

# ==============================================================================
# SSH Protocol Handler
# ==============================================================================

# Executes a command payload remotely via SSH
# Arguments:
#   $1 - user (optional, can be empty)
#   $2 - host/address (mandatory)
#   $3 - port (optional, can be empty)
#   $4..$* - Command payload to execute
# Returns:
#   Exit code of the remote command execution
function rsd::l::protocol::ssh::run() {
    rsd::arguments_or_usage 2 "$@"
    rsd::check_binaries_or_fail ssh mktemp chmod

    local user="$1"
    local host="$2"
    local port="$3"
    shift 3
    local payload=("$@")

    # Build SSH connection target and options
    local connection_target
    if [[ -n "$user" ]]; then
        connection_target="${user}@${host}"
    else
        connection_target="$host"
    fi

    local -a ssh_opts=("-o" "LogLevel=ERROR")
    if [[ -n "$port" ]]; then
        ssh_opts+=("-p" "$port")
    fi
    # Force pseudo-terminal allocation if local session is interactive (stdin is a terminal)
    # This allows remote prompts (such as sudo passwords) to securely disable character echo
    if [[ -t 0 ]]; then
        ssh_opts+=("-t")
    fi

    # Retrieve credentials from KeePassXC if available
    local password=""
    local askpass_tmp=""
    
    # Check if kpx.lib is available and loaded
    if [[ "$RSD_KPX_LIB" == "1" && "${RSD_VAULT_MODE:-opportunistic}" != "never" ]]; then
        # Try user-specific entry first, then host-only fallback
        local -a entry_paths=()
        if [[ -n "$user" ]]; then
            entry_paths+=("RemoteHosts/${user}@${host}" "RemoteHosts/${host}")
        else
            entry_paths+=("RemoteHosts/${host}")
        fi

        local entry
        for entry in "${entry_paths[@]}"; do
            rsd::debug "Checking vault credentials for $entry..." 15
            if rsd::l::kpx::get_password "$entry" password 2>/dev/null; then
                break
            fi
        done
    fi

    # Set up secure in-memory SSH_ASKPASS pipeline if credential found
    if [[ -n "$password" ]]; then
        rsd::debug "Secure credential found in vault. Configuring SSH_ASKPASS..." 12
        askpass_tmp=$(mktemp -t rsd-sshpass.XXXXXX)
        
        # Write secure helper script that outputs the password variable from environment
        cat << 'EOF' > "$askpass_tmp"
#!/usr/bin/env bash
echo "$RSD_SSH_PASS"
EOF
        # Owner-only permissions (rwx------).
        # Prevents other local users from reading the askpass script, which
        # would reveal the credential environment variable name (CWE-377 defense).
        chmod 0700 "$askpass_tmp"

        # Export active pipeline environment securely
        export RSD_SSH_PASS="$password"
        export SSH_ASKPASS="$askpass_tmp"
        export SSH_ASKPASS_REQUIRE="force"

        # Preserve original DISPLAY and set a dummy value to trigger SSH_ASKPASS.
        # Without a DISPLAY, SSH skips the ASKPASS helper entirely on some systems.
        local _rsd_saved_display="${DISPLAY:-}"
        export DISPLAY=":0.0"

        # Trap-guarded cleanup: ensures askpass file and credential variables
        # are removed even if SSH is interrupted by SIGINT/SIGTERM (e.g. Ctrl+C).
        # Without this, an interrupted session would leave a credential-bearing
        # temp file in /tmp/ indefinitely.
        trap 'rm -f "$askpass_tmp"; unset RSD_SSH_PASS SSH_ASKPASS SSH_ASKPASS_REQUIRE; if [[ -n "$_rsd_saved_display" ]]; then export DISPLAY="$_rsd_saved_display"; else unset DISPLAY; fi; trap - EXIT INT TERM' EXIT INT TERM
    fi

    # Execute remote command securely
    # Sanitize credential material from debug output.
    # Bash-native approach: match on payload array elements, not password content.
    # This is safe regardless of special characters in the password (|, $, &, etc.)
    local -a _dbg_parts=()
    local _el
    for _el in "${payload[@]}"; do
        if [[ "$_el" == RSD_SUDO_PASS_INJECT=* ]]; then
            _dbg_parts+=("RSD_SUDO_PASS_INJECT=***")
        elif [[ "$_el" == *'| sudo -S'* || "$_el" == *'\|\ sudo\ -S'* ]]; then
            _dbg_parts+=("<redacted-sudo-pipeline>")
        else
            _dbg_parts+=("$_el")
        fi
    done
    rsd::debug "Executing remote SSH command: ssh ${ssh_opts[*]} $connection_target ${_dbg_parts[*]}" 10

    # SSH -t PTY exit code defense (defense-in-depth):
    #
    # CONTEXT: We initially observed SSH returning exit 0 despite remote command
    # failures (e.g. sudo auth failure). The ROOT CAUSE was rsd::command() calling
    # exit 0 unconditionally (now fixed). However, a secondary risk remains:
    #
    # When SSH allocates a PTY (-t), the remote PTY teardown can theoretically
    # race with the exit-status channel message (OpenSSH known behavior). If the
    # PTY is destroyed before the exit-status message is transmitted, SSH defaults
    # to exit 0 on the client side.
    #
    # DEFENSE: We append '; _rsd_rc=$?; exit $_rsd_rc' to the remote command
    # string. This forces the remote shell to:
    #   1. Capture the command's exit code into a variable
    #   2. Explicitly call exit with that code
    # This ensures the shell transmits exit-status before channel close, even
    # during aggressive PTY teardown scenarios.
    #
    # NOTE: ${payload[*]} (not ${payload[@]}) is intentional — SSH concatenates
    # all trailing arguments into a single remote command string anyway. Using [*]
    # makes the string concatenation with the suffix explicit and correct.

    # Credential return capture: when a delegated worker returns credentials via
    # stderr (sentinel __RSD_SUDO_CRED__), we tee stderr to a temp file for
    # post-execution parsing while preserving real-time output to the user.
    local _stderr_cap=""
    _stderr_cap=$(mktemp "${TMPDIR:-/tmp}/rsd-stderr.XXXXXX")
    chmod 0700 "$_stderr_cap"

    local remote_cmd="${payload[*]}"
    # Trim trailing whitespace
    remote_cmd="${remote_cmd%"${remote_cmd##*[![:space:]]}"}"
    
    # Avoid duplicate semicolons (e.g. command already ending in ;)
    local suffix
    if [[ "$remote_cmd" == *";" ]]; then
        suffix=" _rsd_rc=\$?; exit \$_rsd_rc"
    else
        suffix="; _rsd_rc=\$?; exit \$_rsd_rc"
    fi

    ssh "${ssh_opts[@]}" "$connection_target" "${remote_cmd}${suffix}" \
        2> >(tee "$_stderr_cap" >&2)
    local exit_status=$?

    # Post-SSH terminal recovery: SSH -t allocates a PTY that disrupts the
    # controlling terminal. After the session closes, gpg-agent may hold a stale
    # TTY reference. Refresh GPG_TTY so that post-SSH vault operations
    # (e.g. add_password → decrypt_key → pinentry) can attach to the correct terminal.
    if [[ -t 0 || -t 1 ]] && { : < /dev/tty; } 2>/dev/null; then
        export GPG_TTY=$(tty)
    fi

    # Allow tee's process substitution to flush before we read the file
    sleep 0.1

    # Parse credential returns from the captured stderr
    if [[ -f "$_stderr_cap" ]]; then
        local _line
        while IFS= read -r _line; do
            if [[ "$_line" == __RSD_SUDO_CRED__:*__ ]]; then
                local _cred_body="${_line#__RSD_SUDO_CRED__:}"
                _cred_body="${_cred_body%__}"
                # Format: <b64_password>:<hostname>:<user>
                local _cred_pass _cred_host _cred_user
                IFS=: read -r _cred_pass _cred_host _cred_user <<< "$_cred_body"

                if [[ -n "$_cred_pass" ]]; then
                    local _decoded_pass
                    _decoded_pass=$(echo "$_cred_pass" | base64 -d)
                    [[ "$RSD_SUDO_LIB" != "1" ]] && source "$(rsd::get_libdir_file lib/sudo.lib)"

                    # Cache under the remote's reported hostname (e.g. cavezzale-bi)
                    if [[ -n "$_cred_host" ]]; then
                        RSD_SUDO_PASSWORDS["${_cred_user:-root}@${_cred_host}"]="$_decoded_pass"
                        RSD_SUDO_PASSWORDS_TS["${_cred_user:-root}@${_cred_host}"]=$EPOCHSECONDS
                    fi

                    # Also cache under the SSH connection alias (e.g. bi) so that
                    # subsequent local delegate hops (,sudo://root) find the cached
                    # credential when looking up by alias instead of hostname.
                    if [[ -n "$connection_target" && "$connection_target" != "${_cred_host:-}" ]]; then
                        RSD_SUDO_PASSWORDS["${_cred_user:-root}@${connection_target}"]="$_decoded_pass"
                        RSD_SUDO_PASSWORDS_TS["${_cred_user:-root}@${connection_target}"]=$EPOCHSECONDS
                    fi

                    rsd::debug "Cached credential returned from delegated worker: ${_cred_user:-root}@${_cred_host} (alias: $connection_target)" 5
                fi
            fi
        done < "$_stderr_cap"
        rm -f "$_stderr_cap"
    fi

    rsd::debug "SSH exit status: $exit_status" 10

    # Secure Cleanup of memory credentials and temporary files.
    # Also runs via the trap above on signal interruption.
    if [[ -n "$askpass_tmp" ]]; then
        rm -f "$askpass_tmp"
        unset RSD_SSH_PASS SSH_ASKPASS SSH_ASKPASS_REQUIRE
        # Restore original DISPLAY instead of unsetting it
        if [[ -n "$_rsd_saved_display" ]]; then
            export DISPLAY="$_rsd_saved_display"
        else
            unset DISPLAY
        fi
        trap - EXIT INT TERM
    fi

    return $exit_status
}

# ==============================================================================
# LXC Protocol Handler
# ==============================================================================

# Executes a command payload inside an LXC container locally
# Arguments:
#   $1 - user (optional, can be empty, e.g., root)
#   $2 - container_name (mandatory)
#   $3 - port (ignored for LXC attach)
#   $4..$* - Command payload to execute
# Returns:
#   Exit code of the container command execution
function rsd::l::protocol::lxc::run() {
    rsd::arguments_or_usage 2 "$@"
    rsd::check_binaries_or_fail lxc-attach

    local user="$1"
    local host="$2" # host is the container name
    local port="$3" # ignored
    shift 3
    local payload=("$@")

    local -a lxc_opts=()
    if [[ -n "$user" ]]; then
        lxc_opts+=("--clear-env" "--user" "$user")
    fi

    rsd::debug "Executing container LXC command: lxc-attach -n $host ${lxc_opts[*]} -- ${payload[*]}" 10
    
    lxc-attach -n "$host" "${lxc_opts[@]}" -- "${payload[@]}"
    return $?
}

# ==============================================================================
# Sudo Protocol Handler
# ==============================================================================

# Executes a command payload elevated via sudo (locally or remotely)
# Arguments:
#   $1 - user (optional, can be empty, e.g. root)
#   $2 - host (optional, can be empty or localhost)
#   $3 - port (ignored for sudo)
#   $4..$* - Command payload to execute
# Returns:
#   Exit code of the sudo execution
function rsd::l::protocol::sudo::run() {
    rsd::arguments_or_usage 2 "$@"
    
    local user="$1"
    local host="$2"
    local port="$3"
    shift 3
    
    # Sourcing-Inheritance hook for sudo.lib if not yet active
    [[ "$RSD_SUDO_LIB" != "1" ]] && source "$(rsd::get_libdir_file lib/sudo.lib)"

    # If the execution target is localhost or empty, run locally
    if [[ -z "$host" || "$host" == "localhost" ]]; then
        rsd::l::sudo::run "$user" "$@"
        return $?
    fi

    # Otherwise, if host is specified, it represents a remote execution over ssh fallback
    source "$(rsd::get_libdir_file lib/remote.lib)"
    
    # Retrieve password for the host (remote host)
    local password=""
    rsd::l::sudo::get_password "$host" "$user" password
    
    local -a active_payload=("$@")
    if [[ -n "$password" ]]; then
        # Pipe password via stdin through the SSH tunnel. This prevents the
        # password from appearing in remote process listings (ps aux / /proc/PID/cmdline).
        # sudo -S reads exactly one line from stdin for authentication; the password
        # never touches a command argument or shell string on the remote host.
        printf '%s\n' "$password" | rsd::l::remote::execute "$host" "sudo" "-S" "-p" "" "-u" "${user:-root}" -- "${active_payload[@]}"
        return $?
    else
        # Run standard remote sudo (may prompt)
        local -a sudo_opts=("-u" "${user:-root}")
        rsd::l::remote::execute "$host" "sudo" "${sudo_opts[@]}" -- "${active_payload[@]}"
        return $?
    fi
}

