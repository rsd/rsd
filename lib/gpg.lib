#!/usr/bin/env bash

# GPG key management, encryption, and decryption utilities.
# namespace rsd::l::gpg::

if [[ ! -v RSD_ON || $RSD_ON -ne 1 ]]; then
      echo "This is a RSD library file. It should not be executed directly."
      echo "Please call 'rsd' to use it."
      exit 12
fi

RSD_GPG_LIB=1
RSD_GPG_LIB_VERSION="0.1.0"

[[ "$RSD_NET_LIB" != "1" ]] && $(rsd::source_lib lib/net.lib)

# FIXME: This should come from a config file
RSD_GPG_USER_ID="rsd@$(rsd::l::net::hostname)"

# Is GPG ready to be used?
# Values:
#   "yes": GPG is ready to be used
#   "no": GPG is not ready to be used
#   "unknown": GPG status is unknown
RSD_GPG_READY="unknown"

# Reference for gpg fields: https://github.com/gpg/gnupg/blob/master/doc/DETAILS

# Gets all GPG keys from the keyring and returns them as an array.
# Arguments:
#   $1: The user id to search for.
#       Empty string for all user ids
#   $2: The name of the array to store the keys in.
# Returns:
#   An array of GPG keys.
function rsd::l::gpg::get_keys() {
    rsd::check_binaries_or_fail gpg
    local user_id="$1"
    local array_name="$2"
    declare -n arr="$array_name"

    local -a keys
    IFS=$'\n' read -r -d '' -a keys < <(gpg --list-keys --with-colons $user_id | grep '^fpr' | cut -d: -f10 && printf '\0')
    arr=("${keys[@]}")
}

# Check Installation and Configuration of GPG within RSD
# Arguments:
#   $1: If set to 1, the function will not print any output.
# Returns:
#   0: If GPG is installed and configured correctly
#   1: If GPG is not installed
#   2: If no GPG keys are found
#   3: If no GPG keys for RSD are found
#   4: If the key is not capable of encryption
function rsd::l::gpg::check() {
    if [[ $RSD_GPG_READY == "yes" ]]; then
        return 0
    fi

    rsd::check_binaries_or_fail gpg

    local silent=0
    if [[ -n $1 && $1 -eq 1 ]]; then
        silent=1
    fi
    declare -g -A _r_gpg_keys_cap

    if ! rsd::check_binary gpg; then
        ((silent)) || rsd::warn "GPG is not installed. Please install it first."
        RSD_GPG_READY="no"
        return 1
    fi

    rsd::l::gpg::get_keys "" _r_gpg_keys
    if [[ -z $_r_gpg_keys ]]; then
        ((silent)) || rsd::warn "No GPG keys found. Please create one first with:"
        ((silent)) || rsd::warn "rsd gpg --create-key"
        RSD_GPG_READY="no"
        return 2
    fi

    rsd::l::gpg::get_keys $RSD_GPG_USER_ID _r_gpg_keys
    if [[ -z $_r_gpg_keys ]]; then
        ((silent)) || rsd::warn "There are some gpg keys installed, but none for RSD usage. Please create one first with:"
        RSD_GPG_READY="no"
        return 3
    fi

    rsd::l::gpg::key_capabilities "${_r_gpg_keys[0]}" "_r_gpg_keys_cap"

    if [[ "${_r_gpg_keys_cap[encrypt]}" == "1" ]];
    then
        RSD_GPG_READY="yes"
        return 0
    else
        ((silent)) || rsd::warn "Key is not capable of encryption. Please create a new key with encryption capabilities."
        RSD_GPG_READY="no"
        return 4
    fi
}

# Takes one argument: the fingerprint of the GPG key
function rsd::l::gpg::key_capabilities() {
    rsd::arguments_or_usage 2 $@
    rsd::check_binaries_or_fail gpg

    local fingerprint="$1"
    local cap_name="$2"
    declare -n cap="$cap_name"

    # Fetching the key details
    local key_details=$(gpg --with-colons --list-keys "$fingerprint")
    local has_subkey=0
    if [[ -n $(echo "$key_details" | grep '^sub') ]]; then
        has_subkey=1
    fi

    cap["encrypt"]=$(echo "$key_details" | grep '^pub' | cut -d: -f12 | grep -q 'e' && echo 1 || echo 0)
    cap["sign"]=$(echo "$key_details" | grep '^pub' | cut -d: -f12 | grep -q 's' && echo 1 || echo 0)
    cap["curve-name"]=$(echo "$key_details" | grep '^pub' | cut -d: -f17)

    if [[ $has_subkey -eq 1 ]]; then
        cap["curve-name"]=$(echo "$key_details" | grep '^sub' | cut -d: -f17)
         if [[ ${cap["encrypt"]} -eq 0 ]]; then
            cap["encrypt"]=$(echo "$key_details" | grep '^sub' | cut -d: -f12 | grep -q 'e' && echo 1 || echo 0)
        fi
    fi
    return 0
}

# Encrypts a file and replaces it with the encrypted version.
# Adds .gpg extension to the file.
# Arguments:
#   $1: The file to encrypt
# Notes:
#   - The encrypted file will be named as the original file with .gpg extension.
#   - If the encrypted file already exists, the function will fail.
#   - The original file will be removed
function rsd::l::gpg::encrypt_file() {
    rsd::arguments_or_usage 1 "$@"
    rsd::check_binaries_or_fail gpg rm

    local file="$1"
    local encrypted_file="$file.gpg"

    if [[ -e "$encrypted_file" ]]; then
        rsd::warn "Encrypted file '$encrypted_file' already exists. Nothing to do."
        return 1
    fi

    if [[ ! -e "$file" ]]; then
        rsd::warn "File '$file' does not exist."
        return 2
    fi

    if gpg --encrypt --sign --recipient "$RSD_GPG_USER_ID" "$file"; then
        rm "$file"
        return 0
    else
        rsd::warn "Some error occurred while encrypting the file.  Check stderr."
        return 3
    fi
}

# Decrypts a file and replaces it with the decrypted version.
# Removes the .gpg extension from the file.
# Arguments:
#   $1: The file to decrypt
# Note:
#   - The decrypted file will be named as the original file without the .gpg extension.
#   - If the decrypted file already exists, the function will fail.
#   - The original file will be removed
function rsd::l::gpg::decrypt_file() {
    rsd::arguments_or_usage 1 "$@"
    rsd::check_binaries_or_fail gpg rm

    local file="$1"
    if [[ "$file" != *.gpg ]]; then
        rsd::warn "File '$file' must end with .gpg for decryption."
        return 2
    fi
    local decrypted_file="${file%.gpg}"

    if [[ -e "$decrypted_file" ]]; then
        rsd::warn "Decrypted file '$decrypted_file' already exists. Nothing to do."
        return 1
    fi

    if [[ ! -e "$file" ]]; then
        rsd::warn "File '$file' does not exist."
        return 2
    fi

    if gpg --decrypt --output "$decrypted_file" "$file"; then
        rm "$file"
        return 0
    else
        rsd::warn "Some error occurred while decrypting the file.  Check stderr."
        return 3
    fi
}

# Check if gpg-agent is active and responsive, attempting recovery auto-launch if unresponsive.
# Returns:
#   0: Agent is healthy
#   3: Environment failure / unresponsive
function rsd::l::gpg::validate_agent_or_fail() {
    rsd::check_binaries_or_fail gpg-connect-agent gpgconf

    if ! gpg-connect-agent /bye &>/dev/null; then
        if ! gpgconf --launch gpg-agent &>/dev/null; then
            rsd::warn "Critical: gpg-agent daemon is unresponsive or failed to launch."
            return 3
        fi
    fi
    return 0
}
