# ==============================================================================
# Option Parsing Helpers
# ==============================================================================

# Parse create-specific options from the command arguments.
# Sets variables in the caller's scope via nameref.
#
# @param array $@ Raw command arguments after the VM name.
# @return void (sets variables via globals declared in the caller).
function rsd::c::vm::_parse_create_opts() {
    # Defaults from config
    RSD_VM_OPT_OS=$(rsd::l::vm::config "defaults.os" "ubuntu-26.04")
    RSD_VM_OPT_RAM=$(rsd::l::vm::config "defaults.ram" "2G")
    RSD_VM_OPT_VCPUS=$(rsd::l::vm::config "defaults.vcpus" "2")
    RSD_VM_OPT_DISK=$(rsd::l::vm::config "defaults.disk" "20G")
    RSD_VM_OPT_USER=$(rsd::l::vm::config "defaults.user" "rsd")
    RSD_VM_OPT_KEY=$(rsd::l::vm::config "defaults.key" "$HOME/.ssh/id_ed25519.pub")
    RSD_VM_OPT_SYSTEM=0
    RSD_VM_OPT_BRIDGE=""
    RSD_VM_OPT_DRIVER=""
    RSD_VM_OPT_BOOTSTRAP=$(rsd::l::vm::config "defaults.bootstrap" "true")

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --os)           RSD_VM_OPT_OS="$2"; shift ;;
            --ram)          RSD_VM_OPT_RAM="$2"; shift ;;
            --vcpus)        RSD_VM_OPT_VCPUS="$2"; shift ;;
            --disk)         RSD_VM_OPT_DISK="$2"; shift ;;
            --user)         RSD_VM_OPT_USER="$2"; shift ;;
            --key)          RSD_VM_OPT_KEY="$2"; shift ;;
            --session)      RSD_VM_OPT_SYSTEM=0 ;;
            --system)       RSD_VM_OPT_SYSTEM=1 ;;
            --bridge)       RSD_VM_OPT_BRIDGE="$2"; RSD_VM_OPT_SYSTEM=1; shift ;;
            --driver)       RSD_VM_OPT_DRIVER="$2"; shift ;;
            --no-bootstrap) RSD_VM_OPT_BOOTSTRAP="false" ;;
            *)              ;; # Ignore unknown options for forward compat
        esac
        shift
    done
}

# Resolve connection URI from current option state.
# Must be called after _parse_create_opts.
# Passes the caller's variable name directly to resolve_connection
# to avoid intermediate nameref collisions.
#
# @param string $1 Variable name to write the URI into.
# @return void
function rsd::c::vm::_resolve_conn() {
    rsd::l::vm::resolve_connection "$RSD_VM_OPT_SYSTEM" "$1"
}

# ==============================================================================
# Actions
# ==============================================================================

function rsd::c::vm::create() {
    local vm_name="$1"
    if [[ -z "$vm_name" ]]; then
        rsd::io::error "Usage: rsd vm create <name> [options]"
        return 2
    fi
    shift

    rsd::c::vm::_parse_create_opts "$@"

    # Load driver
    rsd::l::vm::load_driver "$RSD_VM_OPT_DRIVER" || return $?

    # Resolve connection
    local conn_uri=""
    rsd::c::vm::_resolve_conn conn_uri

    rsd::l::vm::dispatch "create" \
        "$vm_name" \
        "$RSD_VM_OPT_OS" \
        "$RSD_VM_OPT_RAM" \
        "$RSD_VM_OPT_VCPUS" \
        "$RSD_VM_OPT_DISK" \
        "$RSD_VM_OPT_USER" \
        "$RSD_VM_OPT_KEY" \
        "$conn_uri" \
        "$RSD_VM_OPT_BRIDGE" \
        "$RSD_VM_OPT_BOOTSTRAP"
}

