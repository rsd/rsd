}

function rsd::c::vm::check() {
    # Parse --system / --session to check the right connection mode
    local system_flag=0
    local arg
    for arg in "$@"; do
        case "$arg" in
            --system) system_flag=1 ;;
        esac
    done

    rsd::l::vm::load_driver || return $?
    local conn_uri=""
    rsd::l::vm::resolve_connection "$system_flag" conn_uri
    rsd::l::vm::dispatch "check" "$conn_uri"
}

# ==============================================================================
# Action Router
# ==============================================================================

function rsd::c::vm::command() {
    local action="$1"
    shift 2>/dev/null || true
    case "$action" in
        create)      rsd::c::vm::create "$@" ;;
        destroy)     rsd::c::vm::destroy "$@" ;;
        start)       rsd::c::vm::start "$@" ;;
        stop)        rsd::c::vm::stop "$@" ;;
        kill)        rsd::c::vm::kill "$@" ;;
        pause)       rsd::c::vm::pause "$@" ;;
        resume)      rsd::c::vm::resume "$@" ;;
        ssh)         rsd::c::vm::ssh "$@" ;;
        console)     rsd::c::vm::console "$@" ;;
        snapshot)    rsd::c::vm::snapshot "$@" ;;
        rollback)    rsd::c::vm::rollback "$@" ;;
        commit)      rsd::c::vm::commit "$@" ;;
        snapshots)   rsd::c::vm::snapshots "$@" ;;
        delete-snap) rsd::c::vm::delete_snap "$@" ;;
        list)        rsd::c::vm::list "$@" ;;
        status)      rsd::c::vm::status "$@" ;;
        images)      rsd::c::vm::images "$@" ;;
        check)       rsd::c::vm::check "$@" ;;
        *)           rsd::c::vm::help ;;
    esac
}
