function rsd::c::vm::snapshot() {
    local vm_name="$1"
    if [[ -z "$vm_name" ]]; then
        rsd::io::error "Usage: rsd vm snapshot <name> [--name <tag>]"
        return 2
    fi
    shift

    local snap_name=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --name) snap_name="$2"; shift ;;
        esac
        shift
    done

    if [[ -z "$snap_name" ]]; then
        # Auto-generate timestamp-based name
        snap_name="snap-$(date +%Y%m%d-%H%M%S)"
    fi

    rsd::l::vm::load_driver || return $?
    local conn_uri=""
    rsd::l::vm::resolve_connection 0 conn_uri
    rsd::l::vm::dispatch "snapshot" "$vm_name" "$snap_name" "$conn_uri"
}

