#!/usr/bin/env bash

# VM lifecycle management command module.
# Provides a unified CLI for creating, managing, and connecting to
# virtual machines through pluggable backend drivers.

# @see docs/vm.md
# @see AGENTS.md

if [[ ! -v RSD_ON || $RSD_ON -ne 1 ]]; then
    echo "This is a RSD library file. It should not be executed directly."
    echo "Please call 'rsd' to use it."
    exit 12
fi

# Lazy-load VM library
[[ "$RSD_VM_LIB" != "1" ]] && source "$(rsd::get_libdir_file lib/vm.lib)"

RSD_C_VM_SHORT_DESC="Virtual Machine Lifecycle Management"
RSD_C_VM_VERSION="0.2.0"

