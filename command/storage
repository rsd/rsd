#!/usr/bin/env bash

# ==============================================================================
# Storage Command — Cross-Cloud File Operations
# ==============================================================================
#
# Orchestrates file operations across local filesystems and cloud storage
# providers (S3, Google Drive, Backblaze B2, SFTP, etc.) via rclone.
#
# RSD handles WHERE rclone runs (local or remote host via target dispatch).
# rclone handles WHERE the data lives (cloud endpoints via remote:path syntax).
# These are orthogonal dimensions:
#   rsd @bi storage copy s3:bucket/ gdrive:archive/
#   ^^^^^^^^^^           ^^^^^^^^^^^^^^^^^^^^^^^^^^^
#   "run on @bi"         "rclone moves data between s3 and gdrive"
#
# Usage:
#   rsd storage copy <source> <dest> [flags]
#   rsd storage move <source> <dest> [flags]
#   rsd storage sync <source> <dest> [--confirm | --dry-run]
#   rsd storage ls <remote:path> [--long]
#   rsd storage size <remote:path>
#   rsd storage check <source> <dest>
#   rsd storage config
#   rsd storage setup [--remotes name1,name2]
#   rsd storage doctor
#
# Remote execution:
#   rsd @bi storage copy s3:prod-dumps/ /tmp/local-copy/
#   rsd @bi storage setup --remotes s3,gdrive
#
# @see docs/storage.md
# @see AGENTS.md

if [[ ! -v RSD_ON || $RSD_ON -ne 1 ]]; then
    echo "This is a RSD library file. It should not be executed directly."
    echo "Please call 'rsd' to use it."
    exit 12
fi

[[ "$RSD_STORAGE_LIB" != "1" ]] && source "$(rsd::get_libdir_file lib/storage.lib)"

RSD_C_STORAGE_SHORT_DESC="Cross-Cloud File Operations (rclone)"
RSD_C_STORAGE_VERSION="0.1.0"

# Command is remote-aware (Mode A — local orchestration)
RSD_C_STORAGE_REMOTE_AWARE=1

# ==============================================================================
# Argument Configuration
# ==============================================================================

declare -g -A RSD_C_STORAGE_ARGS_PARAM=(
    # Shared flags
    ["dry-run"]=0
    ["confirm"]=0
    ["verbose"]=0
    ["long"]=0
    # setup-specific
    ["remotes"]=1
    # rclone pass-through
    ["transfers"]=1
    ["checkers"]=1
    ["config"]=1
    ["filter"]=1
    ["include"]=1
    ["exclude"]=1
    ["max-transfer"]=1
    ["bwlimit"]=1
)

