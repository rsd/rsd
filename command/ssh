#!/usr/bin/env bash

if [[ ! -v RSD_ON || $RSD_ON -ne 1 ]]; then
    echo "This is a RSD library file. It should not be executed directly."
    echo "Please call 'rsd' to use it."
    exit 12
fi

RSD_C_SSH_SHORT_DESC="SSH Validation and Remote Execution Module"
RSD_C_SSH_VERSION="0.1.0"
RSD_C_SSH_REMOTE_AWARE=1  # Declare remote-awareness capability (Mode A)

# Help manual for the validation command
function rsd::c::ssh::help() {
    echo -e "\n\tSSH Validation Command Help:\n"
    echo -e "\t\tActions:"
    echo -e "\t\t\tls       Lists files locally or on the remote target"
}

# Lists files in a directory path locally or remotely depending on remote target spec
# Arguments:
#   $1 - target directory path (optional, defaults to active working directory)
# Returns:
#   Exit code of the listing execution
function rsd::c::ssh::ls() {
    local dir_path="${1:-.}"

    if [[ -n "$RSD_REMOTE_TARGET" ]]; then
        rsd::debug "Remote-aware validation action 'ls' targeting '$RSD_REMOTE_TARGET' for path '$dir_path'" 10
        
        # Load remote library to compile and delegate the tunnel pipeline
        [[ "$RSD_REMOTE_LIB" != "1" ]] && source "$(rsd::get_libdir_file lib/remote.lib)"
        
        # Delegate standard shell command 'ls' execution through the resolved protocol transport
        rsd::l::remote::delegate "$RSD_REMOTE_TARGET" "ls" "-la" "$dir_path"
        return $?
    else
        rsd::debug "Executing 'ls' locally for path '$dir_path'" 10
        ls -la "$dir_path"
        return $?
    fi
}
