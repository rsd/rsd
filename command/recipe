#!/usr/bin/env bash

# @see docs/recipes.md
# @see AGENTS.md

if [[ ! -v RSD_ON || $RSD_ON -ne 1 ]]; then
    echo "This is a RSD library file. It should not be executed directly."
    echo "Please call 'rsd' to use it."
    exit 12
fi

[[ "$RSD_RECIPE_LIB" != "1" ]] && $(rsd::source_lib_or_die lib/recipe.lib)

RSD_C_RECIPE_SHORT_DESC="Idempotent Recipe Provisioning Subsystem"
RSD_C_RECIPE_VERSION="0.2.0"

# Recipe command is remote-aware (Mode A) to manage local/remote context dynamically
RSD_C_RECIPE_REMOTE_AWARE=1

declare -g -A RSD_C_RECIPE_ARGS_PARAM=(
    ["dry-run"]=0
    ["n"]=0
    ["verbose"]=0
    ["v"]=0
)

# Help and usage action
# Arguments:
#   $1 - Recipe name (optional)
# Returns:
#   Exit code of overview compilation or 0
function rsd::c::recipe::help() {
    local recipe="$1"
    if [[ -n "$recipe" ]]; then
        # Extract and print top-level human-readable comments as rich documentation
        local recipe_path
        recipe_path="$(rsd::get_libdir_file "lib/recipe/${recipe}.recipe")"
        if [[ -f "$recipe_path" ]]; then
            awk '
              NR == 1 { next }
              /^[[:space:]]*#/ { 
                sub(/^[[:space:]]*#[[:space:]]?/, "");
                print;
                has_comments = 1;
                next;
              }
              /^[[:space:]]*$/ {
                if (has_comments) {
                  print "";
                }
                next;
              }
              { exit }
            ' "$recipe_path"
            echo ""
        fi

        # Compile the recipe tasks recursively into the flat stack
        RSD_REGISTERED_TASKS=()
        declare -g -A RSD_TASKS_RECOVERY

        if ! rsd::r::include "$recipe" &>/dev/null; then
            rsd::io::error "Recipe '$recipe' not found or could not be loaded."
            return 5
        fi

        rsd::io::status "=== Recipe Overview: $recipe ==="
        echo -e "This recipe compiles into ${#RSD_REGISTERED_TASKS[@]} sequential tasks:\n"

        local name func recovery
        for name in "${RSD_REGISTERED_TASKS[@]}"; do
            func="rsd::r::${name}"
            recovery="${RSD_TASKS_RECOVERY["$name"]}"

            echo -e "  \033[1m$name\033[0m"
            echo -e "    Apply Function:  $func"
            if bash::is_function "${func}::pre_check"; then
                echo -e "    Necessity Check: ${func}::pre_check"
            else
                echo -e "    Necessity Check: (None - Always runs)"
            fi
            echo -e "    On Failure:      $recovery"
            if [[ "$recovery" == "rollback" ]] && bash::is_function "${func}::rollback"; then
                echo -e "    Rollback Function: ${func}::rollback"
            fi
            echo -e ""
        done

        # Display recipe-specific options if the recipe declared any
        if declare -p RSD_RECIPE_OPTIONS &>/dev/null && [[ ${#RSD_RECIPE_OPTIONS[@]} -gt 0 ]]; then
            echo -e "  Recipe-Specific Options:\n"
            local opt val
            for opt in "${!RSD_RECIPE_OPTIONS[@]}"; do
                val="${RSD_RECIPE_OPTIONS[$opt]}"
                if [[ "$val" -eq 1 ]]; then
                    echo -e "    --${opt} <value>"
                else
                    echo -e "    --${opt}"
                fi
            done
            echo -e ""
        fi

        return 0
    fi

    echo -e "\n\tRecipe Command Help:\n"
    echo -e "\t\tUsage:"
    echo -e "\t\t\trsd recipe run <name> [options]"
    echo -e "\t\t\trsd recipe help <name>"
    echo -e "\t\t\trsd recipe list"
    echo -e "\n\t\tActions:"
    echo -e "\t\t\trun                 Execute a declarative recipe stack"
    echo -e "\t\t\thelp                Explain what a recipe does and list its tasks"
    echo -e "\t\t\tlist                List all available recipes in the search paths"
    echo -e "\n\t\tOptions:"
    echo -e "\t\t\t--dry-run | -n         Simulate actions without executing payloads"
    echo -e "\t\t\t--verbose | -v         Output verbose pre-flight and post-flight log assertions"
}

# List all available recipes in the framework search paths
# @return int 0
function rsd::c::recipe::list() {
    rsd::io::status "=== Available Recipes ==="
    
    local libdir recipe_relative
    local -A seen_recipes
    
    for libdir in "${RSD_LIBRARY_SEARCH_PATH[@]}"; do
        local recipe_dir="$libdir/lib/recipe"
        if [[ -d "$recipe_dir" ]]; then
            # Discover nested recipes recursively
            while read -r recipe_relative; do
                [[ -z "$recipe_relative" ]] && continue
                if [[ -z "${seen_recipes[$recipe_relative]}" ]]; then
                    seen_recipes[$recipe_relative]=1
                    echo -e "  $recipe_relative"
                fi
            done < <(rsd::l::r::find_recursive "$recipe_dir" "")
        fi
    done
    return 0
}

# The main recipe execution entry point
# Arguments:
#   $1 - recipe name (mandatory)
# Returns:
#   Exit code of the recipe engine execution
function rsd::c::recipe::run() {
    local old_stop="${RSD_PARSE_CONFIG[stop-on-command]:-1}"
    RSD_PARSE_CONFIG[stop-on-command]=0
    rsd::parse_args "RSD_C_RECIPE_ARGS_PARAM" RSD_COMMAND_ARGS RSD_ARGS_UNPROCESSED "$@"
    RSD_PARSE_CONFIG[stop-on-command]="$old_stop"

    local recipe="${RSD_COMMAND_ARGS[command]}"
    if [[ -z "$recipe" ]]; then
        rsd::arguments_or_usage 1
    fi

    # Dry-run tracking
    local dry_run=0
    if [[ -v RSD_COMMAND_ARGS[dry-run] || -v RSD_COMMAND_ARGS[n] ]]; then
        dry_run=1
    fi

    # Verbose tracking
    local verbose=0
    if [[ -v RSD_COMMAND_ARGS[verbose] || -v RSD_COMMAND_ARGS[v] ]]; then
        verbose=1
    fi

    rsd::io::status "Initializing Recipe: $recipe"
    if [[ -n "$RSD_REMOTE_TARGET" ]]; then
        rsd::io::info "Target Host: $RSD_REMOTE_TARGET"
    else
        rsd::io::info "Target Host: localhost"
    fi

    # 1. Compile the recipe tasks recursively into the flat stack
    if ! rsd::r::include "$recipe"; then
        rsd::io::error "Failed to load recipe '$recipe'."
        return 5
    fi

    # 2. Phase 3: Re-parse leftover arguments if recipe declared custom options.
    #    Recipe-specific flags (e.g. --install-ufw) are unknown to the Phase 2
    #    parser and land in RSD_ARGS_UNPROCESSED. Now that the recipe is loaded
    #    and RSD_RECIPE_OPTIONS is in scope, we re-parse those leftovers and
    #    merge recognized options into RSD_COMMAND_ARGS.
    if declare -p RSD_RECIPE_OPTIONS &>/dev/null && [[ ${#RSD_ARGS_UNPROCESSED[@]} -gt 0 ]]; then
        local -A _recipe_parsed=()
        local -a _recipe_remaining=()

        rsd::parse_args "RSD_RECIPE_OPTIONS" _recipe_parsed _recipe_remaining \
            "${RSD_ARGS_UNPROCESSED[@]}"

        # Merge recognized recipe options into the standard command args map
        local _key
        for _key in "${!_recipe_parsed[@]}"; do
            RSD_COMMAND_ARGS["$_key"]="${_recipe_parsed[$_key]}"
        done

        # Update unprocessed to only truly unknown arguments
        RSD_ARGS_UNPROCESSED=("${_recipe_remaining[@]}")
    fi

    # 3. Execute compiled tasks
    rsd::l::r::execute_engine "$dry_run" "$verbose"
    return $?
}
