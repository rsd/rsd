#!/usr/bin/env bash

if [[ ! -v RSD_ON || $RSD_ON -ne 1 ]]; then
    echo "This is a RSD library file. It should not be executed directly."
    echo "Please call 'rsd' to use it."
    exit 12
fi

[[ "$RSD_KPX_LIB" != "1" ]] && $(rsd::source_lib_or_die lib/kpx.lib)

RSD_C_KPX_SHORT_DESC="KeePass Integration"
RSD_C_KPX_VERSION="0.1.0"

function rsd::c::kpx::help() {
    echo -e "\n\tKeePass Integration Help:\n"
    echo -e "\t\tActions:"
    echo -e "\t\t\tcheck                  Checks the KeePassXC installation & gpg-agent"
    echo -e "\t\t\tinit                   Initialize GPG-encrypted KeePassXC database"
    echo -e "\t\t\trotate-key <new-id>    Rotates the GPG recipient key ID encrypting the database"
    echo -e "\t\t\tadd <path> <user> <pw> Adds a password entry to the database securely"
    echo -e "\t\t\tshow <path>            Safely displays a password entry from the database"
    echo -e "\t\t\tls [-R] [group]        Lists entries in the vault (default: root)"
}

function rsd::c::kpx::check() {
    # Lazy validate dependencies (Protocol G)
    local status=0
    if ! rsd::l::kpx::check; then
        status=1
    fi
    if ! rsd::l::gpg::validate_agent_or_fail; then
        status=1
    fi
    
    if [[ $status -eq 0 ]]; then
        echo "KeePass and gpg-agent environment is ready for use."
        return 0
    fi
    return 3
}

function rsd::c::kpx::init() {
    rsd::l::kpx::init
    return $?
}

function rsd::c::kpx::rotate-key() {
    rsd::arguments_or_usage 1 "$@"
    rsd::l::kpx::rotate_key "$1"
    return $?
}

function rsd::c::kpx::add() {
    rsd::arguments_or_usage 3 "$@"
    rsd::l::kpx::add_password "$1" "$2" "$3"
    return $?
}

function rsd::c::kpx::show() {
    rsd::arguments_or_usage 1 "$@"
    local secret
    if rsd::l::kpx::get_password "$1" secret; then
        echo "$secret"
        unset secret
        return 0
    fi
    return $?
}

function rsd::c::kpx::ls() {
    local _kpx_recursive=0
    local group="/"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -R|--recursive) _kpx_recursive=1; shift ;;
            -*) rsd::io::error "Unknown option: $1"; return 2 ;;
            *)  group="$1"; shift ;;
        esac
    done

    rsd::l::kpx::list_entries "$group"
    return $?
}
