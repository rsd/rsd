#!/usr/bin/env bash

if [[ ! -v RSD_ON || $RSD_ON -ne 1 ]]; then
    echo "This is a RSD library file. It should not be executed directly."
    echo "Please call 'rsd' to use it."
    exit 12
fi

# Lazy-load required domain helper libraries
[[ "$RSD_GPG_LIB" != "1" ]] && $(rsd::source_lib_or_die lib/gpg.lib)
[[ "$RSD_KPX_LIB" != "1" ]] && $(rsd::source_lib_or_die lib/kpx.lib)
[[ "$RSD_CONFIGLIB_VERSION" == "" ]] && $(rsd::source_lib_or_die lib/config.lib)

RSD_C_INIT_SHORT_DESC="Initialize and Bootstrap RSD Environment"
RSD_C_INIT_VERSION="0.1.0"

# Main top-level entry point function for 'rsd init'
# @return int 0 on success, non-zero on failure.
function rsd::c::init() {
    rsd::io::banner "RSD CORE FRAMEWORK INITIALIZATION"

    # 1. Pre-flight checks: Verify essential host binaries
    rsd::io::step "1/3" "Running pre-flight binary dependency checks..."
    rsd::check_binaries_or_fail gpg keepassxc-cli openssl mktemp
    rsd::io::ok "System dependencies are met."
    rsd::io::blank

    # 2. GPG Keypair Preparation
    rsd::io::step "2/3" "Checking GPG environment configuration..."
    local gpg_ready=0
    if rsd::l::gpg::check 1; then
        rsd::io::ok "GPG is active and configured correctly under ID: '$RSD_GPG_USER_ID'."
        gpg_ready=1
    else
        rsd::io::warn "GPG secret key missing for User ID: '$RSD_GPG_USER_ID'."
        rsd::io::info "Would you like to:"
        rsd::io::info "  [1] Generate a new dedicated GPG keypair for RSD usage."
        rsd::io::info "  [2] Bind an existing GPG key ID."
        rsd::io::info "  [q] Abort initialization."
        
        local choice
        read -r -p "       Select option [1/2/q]: " choice
        case "$choice" in
            1)
                # Sourcing gpg command module dynamically to reuse create-key logic
                $(rsd::source_lib_or_die command/gpg)
                if rsd::c::gpg::create-key; then
                    rsd::io::ok "GPG key generated successfully."
                    gpg_ready=1
                else
                    rsd::io::error "Failed to generate GPG key."
                    return 10
                fi
                ;;
            2)
                local existing_id
                read -r -p "       Enter your existing GPG Key ID or email: " existing_id
                if [[ -z "$existing_id" ]]; then
                    rsd::io::error "Invalid GPG key ID entered."
                    return 2
                fi
                
                # Verify that the entered key actually exists in GPG keyring
                if ! gpg --list-keys "$existing_id" &>/dev/null; then
                    rsd::io::error "GPG key '$existing_id' not found in your system keyring."
                    return 10
                fi
                
                # Bind key using our configuration set writer
                $(rsd::source_lib_or_die command/config)
                if rsd::c::config::set "RSD_GPG_USER_ID" "$existing_id"; then
                    # Force reload configs
                    export RSD_GPG_USER_ID="$existing_id"
                    rsd::io::ok "Bound GPG key ID: '$RSD_GPG_USER_ID'."
                    gpg_ready=1
                else
                    rsd::io::error "Failed to write config update."
                    return 13
                fi
                ;;
            *)
                rsd::io::info "Initialization aborted by user."
                return 0
                ;;
        esac
    fi
    rsd::io::blank

    # Ensure GPG setup succeeded
    if [[ $gpg_ready -ne 1 ]]; then
        rsd::io::error "GPG setup could not be completed."
        return 10
    fi

    # 3. KeePass Vault Setup
    rsd::io::step "3/3" "Verifying KeePass Vault status..."
    local vault_dir="${RSD_CONFIG_DIR:-$HOME/.config/rsd}"
    local vault_key="$vault_dir/vault.key.gpg"
    local vault_db="$vault_dir/vault.kdbx"

    if [[ -f "$vault_key" && -f "$vault_db" ]]; then
        rsd::io::ok "KeePass credentials vault already exists."
    else
        rsd::io::status "Vault not found. Initiating secure KeePass database..."
        if rsd::l::kpx::init; then
            rsd::io::ok "KeePass Vault initialized atomically."
        else
            rsd::io::error "Failed to initialize KeePass Vault."
            return 10
        fi
    fi
    rsd::io::blank

    # 4. Success status summary
    rsd::io::banner "RSD ENVIRONMENT INITIALIZED SUCCESSFULLY!"
    rsd::io::info "Configuration Scope : $vault_dir"
    rsd::io::info "GPG User ID         : $RSD_GPG_USER_ID"
    rsd::io::info "KeePass Vault DB    : $vault_db"
    
    return 0
}
