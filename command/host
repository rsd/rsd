#!/usr/bin/env bash

# @see docs/host.md
# @see AGENTS.md

if [[ ! -v RSD_ON || $RSD_ON -ne 1 ]]; then
    echo "This is a RSD library file. It should not be executed directly."
    echo "Please call 'rsd' to use it."
    exit 12
fi

[[ "$RSD_HOST_LIB" != "1" ]] && $(rsd::source_lib_or_die lib/host.lib)

RSD_C_HOST_SHORT_DESC="Host Platform Identification Subsystem"
RSD_C_HOST_VERSION="0.1.1"

# Host command is remote-aware (Mode A) to orchestrate local/remote discovery natively
RSD_C_HOST_REMOTE_AWARE=1

# Help and usage action.
# Intent: Display sub-commands and description for the host module.
#
# @return void
function rsd::c::host::help() {
    echo -e "\n\tHost Command Help:\n"
    echo -e "\t\tActions:"
    echo -e "\t\t\tidentify              Discover and display host properties"
    echo -e "\t\t\tsave [alias]          Identify and save host properties to hosts.ini"
}

# Discover and display host properties.
# Intent: Query platform attributes dynamically and print them to stdout as key=value lines.
#         If a remote target is specified, pipes a zero-dependency Bash script remotely.
#
# @return int 0 on success.
# @throws 10 on platform identification failure.
function rsd::c::host::identify() {
    if [[ -n "$RSD_REMOTE_TARGET" ]]; then
        local script_content
        [[ "$RSD_HOST_LIB" != "1" ]] && $(rsd::source_lib_or_die lib/host.lib)
        rsd::l::host::generate_standalone_script script_content
        
        # Intent: Source remote library dynamically to invoke delegation protocol
        source "$(rsd::get_libdir_file lib/remote.lib)"
        
        local remote_output
        if ! remote_output=$(rsd::l::remote::execute "$RSD_REMOTE_TARGET" "bash" "-s" <<< "$script_content" 2>/dev/null); then
            rsd::warn "Error: Failed to identify remote host properties over transport."
            return 10
        fi
        echo "$remote_output"
        return 0
    else
        declare -A props
        if ! rsd::l::host::identify props; then
            rsd::warn "Error: Failed to identify host properties."
            return 10
        fi
        
        local key
        for key in os arch distro family version pkg_manager; do
            if [[ -v props[$key] ]]; then
                echo "${key}=${props[$key]}"
            fi
        done
        return 0
    fi
}

# Save host configuration to hosts.ini.
# Intent: Discovers host properties and writes them atomically into the local hosts.ini file.
#         Pipes standalone script when executing against remote targets to avoid RSD dependencies.
#
# @param string $1 Optional host alias override. Defaults to 'localhost' or remote target spec.
# @return int 0 on success.
# @throws 10 on identification failure.
# @throws 13 on write failure or transaction commit failure.
function rsd::c::host::save() {
    local alias="$1"
    if [[ -z "$alias" ]]; then
        if [[ -n "$RSD_REMOTE_TARGET" ]]; then
            alias="${RSD_REMOTE_TARGET#@}"
        else
            alias="localhost"
        fi
    fi
    
    declare -A props
    if [[ -n "$RSD_REMOTE_TARGET" ]]; then
        local script_content
        [[ "$RSD_HOST_LIB" != "1" ]] && $(rsd::source_lib_or_die lib/host.lib)
        rsd::l::host::generate_standalone_script script_content
        
        source "$(rsd::get_libdir_file lib/remote.lib)"
        
        local remote_output
        if ! remote_output=$(rsd::l::remote::execute "$RSD_REMOTE_TARGET" "bash" "-s" <<< "$script_content" 2>/dev/null); then
            rsd::warn "Error: Failed to identify remote host properties over transport."
            return 10
        fi
        
        # Intent: Parse the remote key=value output lines into the local props array
        local line key val
        while IFS= read -r line; do
            [[ -z "$line" ]] && continue
            if [[ "$line" =~ ^([a-zA-Z0-9_]+)=(.*)$ ]]; then
                props["${BASH_REMATCH[1]}"]="${BASH_REMATCH[2]}"
            fi
        done <<< "$remote_output"
    else
        if ! rsd::l::host::identify props; then
            rsd::warn "Error: Failed to identify host properties."
            return 10
        fi
    fi
    
    local prop
    local user_config_dir="${RSD_CONFIG_DIR:-$HOME/.config/rsd}"
    local ini_file="$user_config_dir/hosts.ini"
    local array_name="R_INI_hosts"
    
    eval "declare -gA $array_name"
    if [[ -f "$ini_file" ]]; then
        rsd::config::read_ini "$ini_file" "$array_name" || return 13
    fi
    
    declare -n config_ref="$array_name"
    for prop in "${!props[@]}"; do
        config_ref["${alias}.${prop}"]="${props[$prop]}"
    done
    
    rsd::config::write_ini "$ini_file" "$array_name" || return 13
    rsd::warn "Successfully saved host properties for '$alias' to '$ini_file'."
    return 0
}
