#!/usr/bin/env bash

# @see docs/host.md
# @see AGENTS.md

if [[ ! -v RSD_ON || $RSD_ON -ne 1 ]]; then
    echo "This is a RSD library file. It should not be executed directly."
    echo "Please call 'rsd' to use it."
    exit 12
fi

# Lazy-load remote helper library
[[ "$RSD_REMOTE_LIB" != "1" ]] && source "$(rsd::get_libdir_file lib/remote.lib)"

RSD_C_REMOTE_SHORT_DESC="Remote RSD Environment Management Subsystem"
RSD_C_REMOTE_VERSION="0.2.0"

# Module is remote-aware to allow routing local/remote target orchestration natively
RSD_C_REMOTE_REMOTE_AWARE=1

# Help and usage action.
function rsd::c::remote::help() {
    echo -e "\n\tRemote Command Help:\n"
    echo -e "\t\tUsage:"
    echo -e "\t\t\trsd <remote_target> remote <action> [options]"
    echo -e "\n\t\tTarget Management (local — no @target required):"
    echo -e "\t\t\talias <name> <spec>   Register a host alias (e.g., flow flow.jumba.com.br)"
    echo -e "\t\t\tpathway <name> <hops> Register a multi-hop pathway (e.g., prod @gw,app)"
    echo -e "\t\t\tlist                  Show all registered aliases and pathways"
    echo -e "\t\t\tremove <name>         Remove a host alias or pathway"
    echo -e "\n\t\tRemote Operations (requires @target):"
    echo -e "\t\t\tcheck       Verify if target has dependencies to install RSD"
    echo -e "\t\t\tinstall     Stream and bootstrap install RSD on the target host"
    echo -e "\t\t\tverify      Perform post-install framework verification"
    echo -e "\t\t\tsetup-path  Append ~/.local/bin to remote target PATH in ~/.bashrc"
}

# Pre-flight remote target validation.
# Intent: Compiles a lightweight zero-dependency path probe script to check remote programs.
#
# @return int 0 if all dependencies exist, 1 otherwise.
function rsd::c::remote::check() {
    if [[ -z "$RSD_REMOTE_TARGET" ]]; then
        rsd::io::error "No remote target specified. Usage: rsd @target remote check"
        return 2
    fi

    rsd::io::status "Performing remote pre-flight dependency check on '$RSD_REMOTE_TARGET'..."

    # Zero-dependency remote probe payload
    local probe_script
    probe_script=$(cat << 'EOF'
        deps=(tar bash mkdir cp chmod mktemp openssl)
        missing=()
        for bin in "${deps[@]}"; do
            if ! hash "$bin" 2>/dev/null; then
                missing+=("$bin")
            fi
        done
        
        # Check user bin directory status
        bin_dir_status="EXISTS"
        if [[ ! -d "$HOME/.local/bin" ]]; then
            bin_dir_status="MISSING"
        fi

        # Check if user bin is in remote PATH
        in_path="NO"
        local p
        local IFS=":"
        for p in $PATH; do
            if [[ "$p" == "$HOME/.local/bin" ]]; then
                in_path="YES"
                break
            fi
        done
        
        if [[ ${#missing[@]} -gt 0 ]]; then
            echo "FAILED:${missing[*]}:${bin_dir_status}:${in_path}"
            exit 0
        fi
        echo "OK:${bin_dir_status}:${in_path}"
        exit 0
EOF
    )

    local check_output
    check_output=$(rsd::l::remote::execute "$RSD_REMOTE_TARGET" "bash" "-s" <<< "$probe_script" 2>/dev/null)
    local status=$?

    if [[ $status -ne 0 ]]; then
        rsd::io::error "Target '$RSD_REMOTE_TARGET' is unresponsive or failed to execute dependency check."
        return 3
    fi

    local result=""
    local bins=""
    local bin_status=""
    local path_status=""
    
    if [[ "$check_output" =~ ^([^:]+):([^:]+):([^:]+)$ ]]; then
        result="${BASH_REMATCH[1]}"
        bin_status="${BASH_REMATCH[2]}"
        path_status="${BASH_REMATCH[3]}"
    elif [[ "$check_output" =~ ^FAILED:([^:]+):([^:]+):([^:]+)$ ]]; then
        result="FAILED"
        bins="${BASH_REMATCH[1]}"
        bin_status="${BASH_REMATCH[2]}"
        path_status="${BASH_REMATCH[3]}"
    fi

    if [[ "$result" == "FAILED" ]]; then
        rsd::io::error "Target '$RSD_REMOTE_TARGET' is missing required installer binaries: $bins"
        return 3
    fi

    rsd::io::ok "Remote binary dependencies are met."

    if [[ "$bin_status" == "MISSING" ]]; then
        rsd::io::warn "Installation directory \$HOME/.local/bin does not exist on remote target."
    else
        rsd::io::ok "Installation directory \$HOME/.local/bin exists."
    fi

    if [[ "$path_status" == "NO" ]]; then
        rsd::io::warn "\$HOME/.local/bin is NOT in the remote PATH environment variable!"
    else
        rsd::io::ok "\$HOME/.local/bin is in the remote PATH."
    fi

    return 0
}

# Bootstrap install RSD on the remote host.
#
# @param string $1 Optional install mode ('user' or 'local'). Defaults to 'user'.
# @return int exit code of the installer.
function rsd::c::remote::install() {
    local mode="user"
    local auto_create=0
    
    local arg
    for arg in "$@"; do
        if [[ "$arg" == "-y" || "$arg" == "--yes" || "$arg" == "--create-dir" ]]; then
            auto_create=1
        elif [[ "$arg" != -* ]]; then
            mode="$arg"
        fi
    done

    # 1. Force pre-flight validation check
    rsd::c::remote::check || return $?

    # 2. Check and handle bin folder existence for user installations
    if [[ "$mode" == "user" ]]; then
        rsd::debug "Verifying if remote user bin directory exists..." 15
        
        # Probe remote directory presence cleanly
        rsd::l::remote::execute "$RSD_REMOTE_TARGET" "[ -d \$HOME/.local/bin ]" 2>/dev/null
        local dir_exists=$?
        
        if [[ $dir_exists -ne 0 ]]; then
            rsd::io::info "Installation directory \$HOME/.local/bin does not exist on remote target."
            local create=0
            if [[ $auto_create -eq 1 ]]; then
                create=1
            else
                if rsd::l::remote::prompt_user "Would you like to create ~/.local/bin on target host now? [Y/n]"; then
                    create=1
                fi
            fi
            
            if [[ $create -eq 1 ]]; then
                rsd::io::status "Creating remote directory \$HOME/.local/bin..."
                if ! rsd::l::remote::execute "$RSD_REMOTE_TARGET" "mkdir" "-p" "\$HOME/.local/bin"; then
                    rsd::io::error "Failed to create remote directory."
                    return 13
                fi
            else
                rsd::io::warn "Remote installation declined because user bin directory is missing."
                return 1
            fi
        fi
    fi

    # 3. Run remote bootstrapping
    rsd::io::status "Proceeding with remote streaming bootstrap installation ($mode)..."
    if ! rsd::l::remote::bootstrap_install "$RSD_REMOTE_TARGET" "$mode"; then
        rsd::io::error "Bootstrap installation failed."
        return 13
    fi

    rsd::io::ok "RSD installation completed successfully on target."
    return 0
}

# Post-flight health verification.
function rsd::c::remote::verify() {
    if [[ -z "$RSD_REMOTE_TARGET" ]]; then
        rsd::io::error "No remote target specified. Usage: rsd @target remote verify"
        return 2
    fi

    rsd::io::status "Verifying remote framework health on '$RSD_REMOTE_TARGET'..."
    local ver
    ver=$(rsd::l::remote::execute "$RSD_REMOTE_TARGET" "\$HOME/.local/bin/rsd" "--version" 2>/dev/null)
    if [[ $? -eq 0 ]]; then
        rsd::io::ok "RSD is responsive at \$HOME/.local/bin/rsd (v${ver})"
        return 0
    fi

    ver=$(rsd::l::remote::execute "$RSD_REMOTE_TARGET" "rsd" "--version" 2>/dev/null)
    if [[ $? -eq 0 ]]; then
        rsd::io::ok "RSD is responsive in system PATH (v${ver})"
        return 0
    fi

    rsd::io::error "RSD framework is unresponsive on target."
    return 3
}

# Add ~/.local/bin to the remote target's PATH in ~/.bashrc.
#
# @return int exit code.
function rsd::c::remote::setup_path() {
    if [[ -z "$RSD_REMOTE_TARGET" ]]; then
        rsd::io::error "No remote target specified. Usage: rsd @target remote setup-path"
        return 2
    fi

    local yes_flag=0
    local arg
    for arg in "$@"; do
        if [[ "$arg" == "-y" || "$arg" == "--yes" ]]; then
            yes_flag=1
        fi
    done

    rsd::io::status "Checking remote path configuration on '$RSD_REMOTE_TARGET'..."

    # Probe if PATH already has ~/.local/bin or if ~/.bashrc contains the configuration
    local probe_script
    probe_script=$(cat << 'EOF'
        in_path=0
        local p
        local IFS=":"
        for p in $PATH; do
            if [[ "$p" == "$HOME/.local/bin" || "$p" == "$HOME/.local/bin/" ]]; then
                in_path=1
                break
            fi
        done
        
        in_bashrc=0
        if [[ -f "$HOME/.bashrc" ]]; then
            if grep -Fq ".local/bin" "$HOME/.bashrc"; then
                in_bashrc=1
            fi
        fi
        
        echo "${in_path}:${in_bashrc}"
        exit 0
EOF
    )

    local probe_output
    probe_output=$(rsd::l::remote::execute "$RSD_REMOTE_TARGET" "bash" "-s" <<< "$probe_script" 2>/dev/null)
    local status=$?

    if [[ $status -ne 0 ]]; then
        rsd::io::error "Target '$RSD_REMOTE_TARGET' is unresponsive or failed to query environment."
        return 3
    fi

    local in_path=0
    local in_bashrc=0

    if [[ "$probe_output" =~ ^([01]):([01])$ ]]; then
        in_path="${BASH_REMATCH[1]}"
        in_bashrc="${BASH_REMATCH[2]}"
    fi

    if [[ "$in_bashrc" -eq 1 ]]; then
        rsd::io::ok "Remote ~/.bashrc already contains a ~/.local/bin path configuration."
        if [[ "$in_path" -eq 0 ]]; then
            rsd::io::info "~/.local/bin is configured in ~/.bashrc, but not active in this session."
            rsd::io::info "Please run 'source ~/.bashrc' or reconnect to apply changes."
        fi
        return 0
    fi

    if [[ "$in_path" -eq 1 ]]; then
        rsd::io::ok "~/.local/bin is already in the remote PATH (possibly via system-wide or other profiles)."
        return 0
    fi

    rsd::io::warn "~/.local/bin is NOT configured in remote ~/.bashrc."

    local confirm=0
    if [[ $yes_flag -eq 1 ]]; then
        confirm=1
    else
        if rsd::l::remote::prompt_user "Would you like to append ~/.local/bin to remote ~/.bashrc now? [Y/n]"; then
            confirm=1
        fi
    fi

    if [[ $confirm -eq 1 ]]; then
        rsd::io::status "Appending ~/.local/bin to remote ~/.bashrc..."
        local append_cmd
        append_cmd=$(cat << 'EOF'
echo -e "\n# Added by RSD\nexport PATH=\"\$HOME/.local/bin:\$PATH\"" >> "$HOME/.bashrc"
EOF
        )
        if rsd::l::remote::execute "$RSD_REMOTE_TARGET" "bash" "-c" "$append_cmd"; then
            rsd::io::ok "Successfully added PATH configuration to remote ~/.bashrc."
            rsd::io::info "Please run 'source ~/.bashrc' or restart your terminal session on the remote host."
            return 0
        else
            rsd::io::error "Failed to modify remote ~/.bashrc."
            return 13
        fi
    else
        rsd::io::warn "Path setup declined by user."
        return 1
    fi
}

# ==============================================================================
# Alias & Pathway Management
# ==============================================================================
# These actions manage the user-scope remote.ini configuration file.
# They do NOT require a remote target (@host) — they operate locally.

# Resolve the user-scope remote.ini path.
# Intent: Centralize the config file path computation for all alias/pathway actions.
#
# @return stdout The absolute path to the user remote.ini file.
function rsd::c::remote::_ini_path() {
    echo "${RSD_CONFIG_DIR:-$HOME/.config/rsd}/remote.ini"
}

# Load the remote.ini into R_INI_remote, creating the file and array if absent.
# Intent: Defensive bootstrap — ensures the associative array and file exist
#         before any read/write operations.
#
# @return int 0 on success.
function rsd::c::remote::_load_ini() {
    local ini_file
    ini_file=$(rsd::c::remote::_ini_path)

    # Ensure the directory and file exist
    local dir
    dir=$(dirname "$ini_file")
    [[ -d "$dir" ]] || mkdir -p "$dir"
    [[ -f "$ini_file" ]] || touch "$ini_file"

    # Declare the global array if not yet declared
    declare -gA R_INI_remote 2>/dev/null || true

    rsd::config::read_ini "$ini_file" "R_INI_remote"
}

# Flush the in-memory R_INI_remote back to disk.
#
# @return int 0 on success, 13 on write failure.
function rsd::c::remote::_save_ini() {
    local ini_file
    ini_file=$(rsd::c::remote::_ini_path)
    rsd::config::write_ini "$ini_file" "R_INI_remote" || return 13
}

# Register a host alias.
# Intent: Maps a short name to a full host specification so that
#         `rsd @flow` resolves to `ssh://user@flow.jumba.com.br`.
#
# @param string $1 The alias name (e.g., "flow").
# @param string $2 The full host specification (e.g., "flow.jumba.com.br" or "ssh://admin@host:2222").
# @return int 0 on success, 2 on bad usage, 13 on write failure.
function rsd::c::remote::alias() {
    local name="$1"
    local spec="$2"

    if [[ -z "$name" || -z "$spec" ]]; then
        rsd::io::error "Usage: rsd remote alias <name> <host_spec>"
        rsd::io::info  "Example: rsd remote alias flow flow.jumba.com.br"
        rsd::io::info  "Example: rsd remote alias gateway ssh://admin@bastion:2222"
        return 2
    fi

    rsd::c::remote::_load_ini

    # Check for overwrite
    local existing_host="${R_INI_remote[hosts.${name}]:-}"
    local existing_pathway="${R_INI_remote[pathways.${name}]:-}"

    if [[ -n "$existing_host" ]]; then
        rsd::io::warn "Overwriting existing host alias '${name}' (was: ${existing_host})."
    elif [[ -n "$existing_pathway" ]]; then
        rsd::io::warn "A pathway named '${name}' already exists. Host alias takes precedence during resolution."
    fi

    R_INI_remote["hosts.${name}"]="$spec"

    if ! rsd::c::remote::_save_ini; then
        rsd::io::error "Failed to write remote.ini."
        return 13
    fi

    rsd::io::ok "Alias '${name}' -> '${spec}' saved."
    rsd::io::info "Usage: rsd @${name} <command>"
}

# Register a multi-hop pathway.
# Intent: Maps a short name to a comma-separated chain of hops (aliases or raw specs)
#         so that `rsd @prod` resolves to `@gateway,target,container`.
#
# @param string $1 The pathway name (e.g., "prod").
# @param string $2 The hop chain (e.g., "@gateway,target" or "@gw,ssh://app,lxc://web").
# @return int 0 on success, 2 on bad usage, 13 on write failure.
function rsd::c::remote::pathway() {
    local name="$1"
    local hops="$2"

    if [[ -z "$name" || -z "$hops" ]]; then
        rsd::io::error "Usage: rsd remote pathway <name> <hop_chain>"
        rsd::io::info  "Example: rsd remote pathway prod @gateway,app-server"
        rsd::io::info  "Example: rsd remote pathway full @gateway,hypervisor,lxc://webapp,docker://api"
        return 2
    fi

    rsd::c::remote::_load_ini

    local existing="${R_INI_remote[pathways.${name}]:-}"
    if [[ -n "$existing" ]]; then
        rsd::io::warn "Overwriting existing pathway '${name}' (was: ${existing})."
    fi

    R_INI_remote["pathways.${name}"]="$hops"

    if ! rsd::c::remote::_save_ini; then
        rsd::io::error "Failed to write remote.ini."
        return 13
    fi

    rsd::io::ok "Pathway '${name}' -> '${hops}' saved."
    rsd::io::info "Usage: rsd @${name} <command>"
}

# List all registered host aliases and pathways.
# Intent: Quick inventory of the user's remote target configuration.
#
# @return int 0 on success.
function rsd::c::remote::list() {
    rsd::c::remote::_load_ini

    local key
    local has_hosts=0
    local has_pathways=0

    # Collect and display hosts
    rsd::io::blank
    rsd::io::info "Host Aliases:"

    # Sort keys for deterministic display
    local -a sorted_keys
    IFS=$'\n' read -r -d '' -a sorted_keys < <(printf '%s\n' "${!R_INI_remote[@]}" | sort && printf '\0') || true

    for key in "${sorted_keys[@]}"; do
        if [[ "$key" == hosts.* ]]; then
            local alias_name="${key#hosts.}"
            rsd::io::info "  ${alias_name}  ->  ${R_INI_remote[$key]}"
            has_hosts=1
        fi
    done
    if [[ $has_hosts -eq 0 ]]; then
        rsd::io::info "  (none)"
    fi

    rsd::io::blank
    rsd::io::info "Pathways:"

    for key in "${sorted_keys[@]}"; do
        if [[ "$key" == pathways.* ]]; then
            local pathway_name="${key#pathways.}"
            rsd::io::info "  ${pathway_name}  ->  ${R_INI_remote[$key]}"
            has_pathways=1
        fi
    done
    if [[ $has_pathways -eq 0 ]]; then
        rsd::io::info "  (none)"
    fi

    rsd::io::blank
    rsd::io::info "Config: $(rsd::c::remote::_ini_path)"
}

# Remove a host alias or pathway by name.
# Intent: Clean removal of a registered alias or pathway from remote.ini.
#
# @param string $1 The name to remove.
# @return int 0 on success, 2 on bad usage, 10 if name not found.
function rsd::c::remote::remove() {
    local name="$1"

    if [[ -z "$name" ]]; then
        rsd::io::error "Usage: rsd remote remove <name>"
        return 2
    fi

    rsd::c::remote::_load_ini

    local found=0

    if [[ -n "${R_INI_remote[hosts.${name}]:-}" ]]; then
        rsd::io::info "Removing host alias '${name}' (was: ${R_INI_remote[hosts.${name}]})."
        unset "R_INI_remote[hosts.${name}]"
        found=1
    fi

    if [[ -n "${R_INI_remote[pathways.${name}]:-}" ]]; then
        rsd::io::info "Removing pathway '${name}' (was: ${R_INI_remote[pathways.${name}]})."
        unset "R_INI_remote[pathways.${name}]"
        found=1
    fi

    if [[ $found -eq 0 ]]; then
        rsd::io::error "No alias or pathway named '${name}' found."
        return 10
    fi

    if ! rsd::c::remote::_save_ini; then
        rsd::io::error "Failed to write remote.ini."
        return 13
    fi

    rsd::io::ok "'${name}' removed."
}

# Route actions dynamically
function rsd::c::remote::command() {
    local action="$1"
    shift
    case "$action" in
        alias)      rsd::c::remote::alias "$@" ;;
        pathway)    rsd::c::remote::pathway "$@" ;;
        list)       rsd::c::remote::list "$@" ;;
        remove)     rsd::c::remote::remove "$@" ;;
        check)      rsd::c::remote::check "$@" ;;
        install)    rsd::c::remote::install "$@" ;;
        verify)     rsd::c::remote::verify "$@" ;;
        setup-path) rsd::c::remote::setup_path "$@" ;;
        *)          rsd::c::remote::help ;;
    esac
}
